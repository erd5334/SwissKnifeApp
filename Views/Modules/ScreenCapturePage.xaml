<Page x:Class="SwissKnifeApp.Views.Modules.ScreenCapturePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:vm="clr-namespace:SwissKnifeApp.ViewModels"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:h="clr-namespace:SwissKnifeApp.Helpers"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1200"
      Background="{DynamicResource AppBackground}">

    <Page.Resources>
        <h:BoolNegationConverter x:Key="BoolNegationConverter"/>
    </Page.Resources>

    <Page.DataContext>
        <vm:ScreenCaptureViewModel/>
    </Page.DataContext>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel - Capture Actions -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Header -->
                <TextBlock Text="📸 Screen Capture &amp; Recorder" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource HeaderText}"
                           Margin="0,0,0,10"/>
                <TextBlock Text="Ekran görüntüsü al, kaydet ve yönet" 
                           FontSize="14" 
                           Foreground="{DynamicResource SecondaryText}"
                           Margin="0,0,0,30"/>

                <!-- Capture Buttons -->
                <Border Background="{DynamicResource CardBackground}" 
                        BorderBrush="{DynamicResource CardBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="20" 
                        Margin="0,0,0,15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <iconPacks:PackIconMaterial Kind="Monitor" 
                                                        Width="24" Height="24" 
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,10,0"/>
                            <TextBlock Text="Yakala" 
                                       FontSize="20" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource HeaderText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Content="🖥️ Tam Ekran" 
                                Command="{Binding CaptureFullScreenCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource BoolNegationConverter}}"
                                ToolTip="Hotkey: Ctrl+Shift+F"
                                FontSize="14"
                                Padding="0,12"
                                Margin="0,0,0,10"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"/>

                        <Button Content="🖼️ Tüm Ekranlar (Multi-monitor)" 
                                Command="{Binding CaptureAllScreensCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource BoolNegationConverter}}"
                                FontSize="14"
                                Padding="0,12"
                                Margin="0,0,0,10"
                                Background="#4CAF50"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"/>

                        <Button Content="🪟 Aktif Pencere (5 sn sonra)" 
                                Command="{Binding CaptureActiveWindowCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource BoolNegationConverter}}"
                                ToolTip="Hotkey: Ctrl+Shift+W"
                                FontSize="14"
                                Padding="0,12"
                                Background="#FF9800"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,0,10"/>

                        <Button Content="📐 Alan Seçimi (Mouse ile çiz) 🔥" 
                                Command="{Binding CaptureRegionSelectionCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource BoolNegationConverter}}"
                                ToolTip="Hotkey: Ctrl+Shift+R - Panoya otomatik kopyalar!"
                                FontSize="14"
                                Padding="0,12"
                                Background="#9C27B0"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- Settings -->
                <Border Background="{DynamicResource CardBackground}" 
                        BorderBrush="{DynamicResource CardBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="20" 
                        Margin="0,0,0,15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <iconPacks:PackIconMaterial Kind="Cog" 
                                                        Width="20" Height="20" 
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,8,0"/>
                            <TextBlock Text="Ayarlar" 
                                       FontSize="16" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource HeaderText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Save Directory -->
                        <TextBlock Text="Kayıt Klasörü:" 
                                   FontSize="13" 
                                   Foreground="{DynamicResource AppForeground}"
                                   Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" 
                                     Text="{Binding Settings.SaveDirectory, UpdateSourceTrigger=PropertyChanged}" 
                                     IsReadOnly="True"
                                     FontSize="12"
                                     Padding="10"
                                     Background="{DynamicResource InputBackground}"
                                     Foreground="{DynamicResource InputForeground}"
                                     BorderBrush="{DynamicResource InputBorderBrush}"
                                     Margin="0,0,10,0"/>

                            <Button Grid.Column="1" 
                                    Content="📁" 
                                    Command="{Binding BrowseSaveDirectoryCommand}"
                                    ToolTip="Klasör seç"
                                    Width="40"
                                    Background="{DynamicResource ButtonBackground}"
                                    Foreground="{DynamicResource ButtonForeground}"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="0,0,10,0"/>

                            <Button Grid.Column="2" 
                                    Content="🔍" 
                                    Command="{Binding OpenSaveDirectoryCommand}"
                                    ToolTip="Klasörü aç"
                                    Width="40"
                                    Background="{DynamicResource ButtonBackground}"
                                    Foreground="{DynamicResource ButtonForeground}"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
                        </Grid>

                        <!-- Image Format -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Format:" 
                                           FontSize="13" 
                                           Foreground="{DynamicResource AppForeground}"
                                           Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding ImageFormats}" 
                                          SelectedItem="{Binding Settings.ImageFormat}"
                                          Padding="10"
                                          Background="{DynamicResource InputBackground}"
                                          Foreground="{DynamicResource AppForeground}"
                                          BorderBrush="{DynamicResource InputBorderBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="JPEG Kalitesi (%):" 
                                           FontSize="13" 
                                           Foreground="{DynamicResource AppForeground}"
                                           Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Settings.JpegQuality, UpdateSourceTrigger=PropertyChanged}" 
                                         Padding="10"
                                         Background="{DynamicResource InputBackground}"
                                         Foreground="{DynamicResource InputForeground}"
                                         BorderBrush="{DynamicResource InputBorderBrush}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Options -->
                        <StackPanel>
                            <CheckBox Content="Otomatik kaydet" 
                                      IsChecked="{Binding Settings.AutoSave}"
                                      Foreground="{DynamicResource AppForeground}"
                                      Margin="0,0,0,8"/>
                            <CheckBox Content="Önizleme göster" 
                                      IsChecked="{Binding Settings.ShowPreview}"
                                      Foreground="{DynamicResource AppForeground}"
                                      Margin="0,0,0,8"/>
                            <CheckBox Content="Cursor dahil et" 
                                      IsChecked="{Binding Settings.IncludeCursor}"
                                      Foreground="{DynamicResource AppForeground}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Status -->
                <Border Background="{DynamicResource InputBackground}"
                        BorderBrush="{DynamicResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="15">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊 Durum: " 
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppForeground}"/>
                        <TextBlock Text="{Binding StatusMessage}" 
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryText}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Right Panel - History -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- History Header -->
                <Border Background="{DynamicResource CardBackground}" 
                        BorderBrush="{DynamicResource CardBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="15" 
                        Margin="0,0,0,15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <iconPacks:PackIconMaterial Kind="History" 
                                                        Width="18" Height="18" 
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,6,0"/>
                            <TextBlock Text="Geçmiş" 
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource HeaderText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock FontSize="12" 
                                   Foreground="{DynamicResource SecondaryText}">
                            <Run Text="Toplam:"/>
                            <Run Text="{Binding TotalCaptures}" FontWeight="Bold"/>
                        </TextBlock>

                        <Button Content="🧹 Temizle" 
                                Command="{Binding ClearHistoryCommand}"
                                FontSize="11"
                                Padding="8,5"
                                Margin="0,10,0,0"
                                Background="{DynamicResource InputBorderBrush}"
                                Foreground="{DynamicResource AppForeground}"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- History List -->
                <ItemsControl ItemsSource="{Binding CaptureHistory}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBackground}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock FontFamily="Consolas" 
                                               FontSize="10"
                                               Foreground="{DynamicResource HeaderText}"
                                               TextWrapping="Wrap">
                                        <Run Text="📸"/>
                                        <Run Text="{Binding CaptureType}" FontWeight="Bold"/>
                                    </TextBlock>

                                    <TextBlock FontSize="10" 
                                               Foreground="{DynamicResource SecondaryText}"
                                               Margin="0,5,0,0">
                                        <Run Text="{Binding Width}"/>
                                        <Run Text="×"/>
                                        <Run Text="{Binding Height}"/>
                                    </TextBlock>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Button Content="👁️" 
                                                Command="{Binding DataContext.OpenCapturedFileCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Aç"
                                                Width="30"
                                                Height="25"
                                                FontSize="12"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Margin="0,0,5,0"/>
                                        <Button Content="🗑️" 
                                                Command="{Binding DataContext.DeleteCaptureCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Sil"
                                                Width="30"
                                                Height="25"
                                                FontSize="12"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
