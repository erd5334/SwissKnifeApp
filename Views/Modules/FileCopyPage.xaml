<Page x:Class="SwissKnifeApp.Views.Modules.FileCopyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:local="clr-namespace:SwissKnifeApp.Views.Modules"
      xmlns:vm="clr-namespace:SwissKnifeApp.ViewModels"
      Title="Dosya Kopyalayıcı">

    <Page.DataContext>
        <vm:FileCopyViewModel />
    </Page.DataContext>
    <Page.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF5722"/>
        <SolidColorBrush x:Key="AccentBrush2" Color="#E64A19"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
            <iconPacks:PackIconMaterial Kind="ContentCopy" Width="28" Height="28" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="Dosya Kopyalayıcısı" FontSize="20" FontWeight="Bold" Margin="8,0,0,0"/>
            <TextBlock Text=" • Dosyalarınızı Kopyalayın (FTP/SFTP Destekli)" Foreground="#607D8B" Margin="6,4,0,0"/>
        </StackPanel>
        <TabControl>
            <!-- Toplu Kopya Modu -->
            <TabItem Header="Toplu Kopya">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Source -->
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
                        <Label Content="Kaynak:" Width="80" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding SourceFolder, UpdateSourceTrigger=PropertyChanged}" MinWidth="500"/>
                        <Button Content="Gözat" Command="{Binding BrowseSourceCommand}" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Target & Protocol -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Label Content="Hedef:" Width="80" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding TargetFolder, UpdateSourceTrigger=PropertyChanged}" MinWidth="500"/>
                            <Button Content="Gözat" Command="{Binding BrowseTargetCommand}" Margin="8,0,0,0"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="80,4,0,0">
                            <Label Content="Protokol:" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding Protocol}" Width="80" Margin="4,0"/>
                            
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsNetworkProtocol, Converter={StaticResource BoolToVis}}"> 
                                <Label Content="Host:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBox Text="{Binding FtpHost}" Width="120" Margin="4,0"/>
                                <Label Content="Port:" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding FtpPort}" Width="40" Margin="4,0"/>
                                <Label Content="User:" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding FtpUser}" Width="80" Margin="4,0"/>
                                <Label Content="Pass:" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding FtpPassword}" Width="80" Margin="4,0"/>
                                <Button Content="Test Et" Command="{Binding TestConnectionCommand}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Extensions -->
                    <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                        <CheckBox Content="*.* (Tüm dosyalar)" IsChecked="{Binding AllFiles}" Margin="0,0,12,0"/>
                        <CheckBox Content=".jpg" IsChecked="{Binding ImageJpg}" IsEnabled="{Binding AllFiles, Converter={StaticResource BoolNegationConverter}}" Margin="0,0,8,0"/>
                        <CheckBox Content=".jpeg" IsChecked="{Binding ImageJpeg}" IsEnabled="{Binding AllFiles, Converter={StaticResource BoolNegationConverter}}" Margin="0,0,8,0"/>
                        <CheckBox Content=".png" IsChecked="{Binding ImagePng}" IsEnabled="{Binding AllFiles, Converter={StaticResource BoolNegationConverter}}" Margin="0,0,8,0"/>
                        <CheckBox Content=".bmp" IsChecked="{Binding ImageBmp}" IsEnabled="{Binding AllFiles, Converter={StaticResource BoolNegationConverter}}" Margin="0,0,8,0"/>
                        <CheckBox Content=".mp4" IsChecked="{Binding VideoMp4}" IsEnabled="{Binding AllFiles, Converter={StaticResource BoolNegationConverter}}" Margin="0,0,8,0"/>
                        <CheckBox Content=".mp3" IsChecked="{Binding AudioMp3}" IsEnabled="{Binding AllFiles, Converter={StaticResource BoolNegationConverter}}" Margin="0,0,8,0"/>
                        <CheckBox Content=".exe" IsChecked="{Binding AnyExe}" IsEnabled="{Binding AllFiles, Converter={StaticResource BoolNegationConverter}}" Margin="0,0,8,0"/>
                    </WrapPanel>

                    <!-- Controls -->
                    <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Label Content="İş parçacığı:" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding WorkerCount}" Width="60" Margin="4,0"/>
                            <CheckBox Content="Üzerine yaz" IsChecked="{Binding Overwrite}" Margin="8,0"/>
                            <CheckBox Content="Son klasörleri hatırla" IsChecked="{Binding RememberLast}" Margin="8,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="Başlat" Command="{Binding StartCommand}" Margin="0,0,8,0" Style="{StaticResource AccentButtonStyle}"/>
                            <Button Content="Durdur" Command="{Binding CancelCommand}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Progress -->
                    <StackPanel Grid.Row="4" Margin="0,0,0,8">
                        <ProgressBar Minimum="0" Maximum="{Binding TotalFiles}" Value="{Binding CopiedFiles}" Height="18"/>
                        <TextBlock HorizontalAlignment="Center" Margin="0,4,0,0">
                     <Run Text="{Binding StatusMessage}"/>
                     <Run Text=" | "/>
                     <Run Text="Dosyalar: "/>
                     <Run Text="{Binding CopiedFiles}"/>
                     <Run Text=" / "/>
                     <Run Text="{Binding TotalFiles}"/>
                     <Run Text="  "/>
                     <Run Text="Boyut: "/>
                     <Run Text="{Binding CopiedBytesHuman}"/>
                     <Run Text=" / "/>
                     <Run Text="{Binding TotalBytesHuman}"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Logs -->
                    <TabControl Grid.Row="5">
                        <TabItem Header="Log">
                            <ListBox ItemsSource="{Binding LogLines}"/>
                        </TabItem>
                        <TabItem Header="Hatalar">
                            <ListBox ItemsSource="{Binding ErrorLines}"/>
                        </TabItem>
                    </TabControl>

                    <!-- Status Bar -->
                    <StatusBar Grid.Row="6">
                        <StatusBarItem>
                            <TextBlock Text="{Binding IsBusy, StringFormat='Meşgul: {0}'}"/>
                        </StatusBarItem>
                    </StatusBar>
                </Grid>
            </TabItem>

            <!-- Seçerek Kopya Modu -->
            <TabItem Header="Seçerek Kopya">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Kaynak Satırı -->
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
                        <Label Content="Kaynak:" Width="80" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding SourceFolder, UpdateSourceTrigger=PropertyChanged}" MinWidth="500"/>
                        <Button Content="Gözat" Command="{Binding BrowseSourceCommand}" Margin="8,0,0,0"/>
                        <Button Content="Listele" Command="{Binding LoadListCommand}" Margin="8,0,0,0"/>
                        <Label Content="Filtre:" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        <TextBox Text="{Binding FileFilter, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="4,0,0,0" ToolTip="Dosya adı veya yoluna göre filtrele"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,8">
                        <Label Content="Hedef:" Width="80" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding TargetFolder, UpdateSourceTrigger=PropertyChanged}" MinWidth="500"/>
                        <Button Content="Gözat" Command="{Binding BrowseTargetCommand}" Margin="8,0,0,0"/>
                        <Button Content="Eksikleri Bul" Command="{Binding ShowMissingFilesCommand}" Margin="8,0,0,0" ToolTip="Hedefte olmayan dosyaları seçer"/>
                        
                        <Button Content="Seçilenleri Kopyala" Command="{Binding CopySelectedCommand}" Margin="20,0,0,0" Style="{StaticResource AccentButtonStyle}"/>
                        <Button Content="Durdur" Command="{Binding CancelCommand}" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding FilesView}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Seç" Width="60"/>
                            <DataGridTextColumn Binding="{Binding RelativePath}" Header="Göreli Yol" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Binding="{Binding FullPath}" Header="Tam Yol" Width="2*" IsReadOnly="True"/>
                            <DataGridTextColumn Binding="{Binding SizeHuman}" Header="Boyut" Width="100" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Durum / İlerleme -->
                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                        <ProgressBar Minimum="0" Maximum="{Binding TotalFiles}" Value="{Binding CopiedFiles}" Height="18"/>
                        <TextBlock HorizontalAlignment="Center">
                     <Run Text="{Binding StatusMessage}"/>
                     <Run Text=" | "/>
                     <Run Text="Dosyalar: "/>
                     <Run Text="{Binding CopiedFiles}"/>
                     <Run Text=" / "/>
                     <Run Text="{Binding TotalFiles}"/>
                     <Run Text="  "/>
                     <Run Text="Boyut: "/>
                     <Run Text="{Binding CopiedBytesHuman}"/>
                     <Run Text=" / "/>
                     <Run Text="{Binding TotalBytesHuman}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
