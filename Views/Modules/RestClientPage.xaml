<Page x:Class="SwissKnifeApp.Views.Modules.RestClientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:local="clr-namespace:SwissKnifeApp.Views.Modules"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1000"
      Title="REST Client">

    <Page.Resources>
        <!-- REST specific accent colors -->
        <SolidColorBrush x:Key="RestAccent" Color="#4CAF50"/>
        
        <Style x:Key="MethodTabItem" TargetType="TabItem" BasedOn="{StaticResource MahApps.Styles.TabItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="SemiBold" Margin="8,4"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Local Styles for Inputs -->
        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource HeaderText}"/>
        </Style>
    </Page.Resources>

    <Grid Background="{DynamicResource AppBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" x:Name="SidebarColumn"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar (History/Collections) -->
        <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="İSTEK GEÇMİŞİ" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" Margin="20,20,20,10"/>

                <TextBox x:Name="TxtSearchHistory" Grid.Row="1" Margin="20,0,20,15" Height="35"
                         mah:TextBoxHelper.Watermark="Geçmişte ara..." mah:TextBoxHelper.ClearTextButton="True">
                    <mah:TextBoxHelper.ButtonContent>
                        <iconPacks:PackIconMaterial Kind="Magnify" Width="14" Height="14"/>
                    </mah:TextBoxHelper.ButtonContent>
                </TextBox>

                <ListBox x:Name="LstHistory" Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="10,0" SelectionChanged="LstHistory_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,2" Padding="10" Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="45" Height="20" CornerRadius="4" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Method}" Value="GET">
                                                        <Setter Property="Background" Value="#1E4CAF50"/>
                                                        <Setter Property="BorderBrush" Value="#4CAF50"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Method}" Value="POST">
                                                        <Setter Property="Background" Value="#1E2196F3"/>
                                                        <Setter Property="BorderBrush" Value="#2196F3"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Method}" Value="PUT">
                                                        <Setter Property="Background" Value="#1EFF9800"/>
                                                        <Setter Property="BorderBrush" Value="#FF9800"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Method}" Value="DELETE">
                                                        <Setter Property="Background" Value="#1EF44336"/>
                                                        <Setter Property="BorderBrush" Value="#F44336"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.Child>
                                            <TextBlock Text="{Binding Method}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Method}" Value="GET"><Setter Property="Foreground" Value="#4CAF50"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Method}" Value="POST"><Setter Property="Foreground" Value="#2196F3"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Method}" Value="PUT"><Setter Property="Foreground" Value="#FF9800"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Method}" Value="DELETE"><Setter Property="Foreground" Value="#F44336"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border.Child>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Url}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource HeaderText}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Timestamp}" FontSize="10" Foreground="{DynamicResource SecondaryText}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MahApps.Styles.ListBoxItem}">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- Grid Splitter -->
        <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource CardBorderBrush}"/>

        <!-- Main Area -->
        <Border Grid.Column="2" Padding="25">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Request Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="CmbMethod" SelectedIndex="0" Height="45" mah:TextBoxHelper.AutoWatermark="True">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource MahApps.Styles.ComboBoxItem}">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBoxItem Content="GET" Foreground="#4CAF50" FontWeight="Bold"/>
                        <ComboBoxItem Content="POST" Foreground="#2196F3" FontWeight="Bold"/>
                        <ComboBoxItem Content="PUT" Foreground="#FF9800" FontWeight="Bold"/>
                        <ComboBoxItem Content="DELETE" Foreground="#F44336" FontWeight="Bold"/>
                        <ComboBoxItem Content="PATCH" Foreground="#9C27B0" FontWeight="Bold"/>
                    </ComboBox>

                    <TextBox x:Name="TxtUrl" Grid.Column="1" Margin="10,0" Height="45" FontSize="14"
                             mah:TextBoxHelper.Watermark="İstek URL'sini girin (örn: https://api.example.com/v1/users)"
                             mah:TextBoxHelper.ClearTextButton="True"
                             Foreground="{DynamicResource HeaderText}"/>

                    <ComboBox x:Name="CmbEnvironment" Grid.Column="2" Width="150" Height="45" Margin="0,0,10,0" 
                              mah:TextBoxHelper.Watermark="No Environment" ToolTip="Çalışma Ortamı"
                              Foreground="{DynamicResource SecondaryText}">
                        <ComboBoxItem Content="No Environment"/>
                        <ComboBoxItem Content="Development"/>
                        <ComboBoxItem Content="Staging"/>
                        <ComboBoxItem Content="Production"/>
                    </ComboBox>
                    
                    <Button x:Name="BtnSend" Grid.Column="3" Width="120" Height="45" 
                            Style="{StaticResource AccentButtonStyle}" Click="BtnSend_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Send" Width="18" Height="18" Margin="0,0,10,0"/>
                            <TextBlock Text="GÖNDER" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Request Details and Response -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Request Configuration -->
                    <mah:MetroAnimatedSingleRowTabControl Grid.Row="0" Margin="0,0,0,15" Background="Transparent" BorderThickness="0">
                        <TabControl.Resources>
                            <Style TargetType="TabItem" BasedOn="{StaticResource MethodTabItem}"/>
                        </TabControl.Resources>
                        
                        <TabItem Header="Headers">
                            <Border Style="{StaticResource Card}" Padding="0">
                                <DataGrid x:Name="DgHeaders" AutoGenerateColumns="False" CanUserAddRows="True" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Binding="{Binding IsEnabled}" Header="" Width="40"/>
                                        <DataGridTextColumn Binding="{Binding Key}" Header="Key" Width="*"/>
                                        <DataGridTextColumn Binding="{Binding Value}" Header="Value" Width="*"/>
                                        <DataGridTextColumn Binding="{Binding Description}" Header="Description" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </TabItem>
                        
                        <TabItem Header="Body">
                            <Border Style="{StaticResource Card}" Padding="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <RadioButton x:Name="RbNone" Content="None" IsChecked="True" Margin="0,0,15,0"/>
                                        <RadioButton x:Name="RbFormData" Content="Form Data" Margin="0,0,15,0"/>
                                        <RadioButton x:Name="RbRaw" Content="Raw (JSON)" Margin="0,0,15,0"/>
                                        <ComboBox x:Name="CmbBodyType" Width="150" Height="30" Visibility="{Binding IsChecked, ElementName=RbRaw, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ComboBoxItem Content="JSON" Tag="application/json" IsSelected="True"/>
                                            <ComboBoxItem Content="XML" Tag="application/xml"/>
                                            <ComboBoxItem Content="Text" Tag="text/plain"/>
                                            <ComboBoxItem Content="HTML" Tag="text/html"/>
                                        </ComboBox>
                                    </StackPanel>
                                    
                                    <TextBox x:Name="TxtBody" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" 
                                             FontFamily="Consolas" FontSize="13" VerticalScrollBarVisibility="Auto"
                                             mah:TextBoxHelper.Watermark="İstek gövdesini buraya yazın..."
                                             Background="{DynamicResource AppBackground}"
                                             Foreground="{DynamicResource HeaderText}"
                                             BorderBrush="{DynamicResource CardBorderBrush}"
                                             Visibility="{Binding IsChecked, ElementName=RbRaw, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    
                                    <DataGrid x:Name="DgFormData" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="True" BorderThickness="0"
                                              Visibility="{Binding IsChecked, ElementName=RbFormData, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Binding="{Binding IsEnabled}" Header="" Width="40"/>
                                            <DataGridTextColumn Binding="{Binding Key}" Header="Key" Width="*"/>
                                            <DataGridTextColumn Binding="{Binding Value}" Header="Value" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </TabItem>
                        
                        <TabItem Header="Auth">
                            <Border Style="{StaticResource Card}" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Kimlik Doğrulama" FontWeight="Bold" Margin="0,0,0,15" Foreground="{DynamicResource HeaderText}"/>
                                    <ComboBox x:Name="CmbAuthType" Width="200" HorizontalAlignment="Left" Margin="0,0,0,20">
                                        <ComboBoxItem Content="No Auth" IsSelected="True"/>
                                        <ComboBoxItem Content="Bearer Token"/>
                                        <ComboBoxItem Content="Basic Auth"/>
                                    </ComboBox>
                                    
                                    <!-- Bearer Auth -->
                                    <Grid Visibility="{Binding SelectedIndex, ElementName=CmbAuthType, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=1}">
                                        <TextBox x:Name="TxtBearerToken" mah:TextBoxHelper.Watermark="Token girin..." Height="40"/>
                                    </Grid>
                                    
                                    <!-- Basic Auth -->
                                    <Grid Visibility="{Binding SelectedIndex, ElementName=CmbAuthType, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=2}">
                                        <StackPanel>
                                            <TextBox x:Name="TxtBasicUsername" Margin="0,0,0,10" Height="40" mah:TextBoxHelper.Watermark="Kullanıcı Adı"/>
                                            <PasswordBox x:Name="TxtBasicPassword" Height="40" mah:TextBoxHelper.Watermark="Şifre"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </TabItem>
                    </mah:MetroAnimatedSingleRowTabControl>

                    <!-- Grid Splitter -->
                    <GridSplitter Grid.Row="1" Height="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{DynamicResource CardBorderBrush}" Margin="0,5"/>

                    <!-- Response Area -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Margin="0,15,0,15" Padding="15,10" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="CheckboxMarkedCircle" Foreground="#4CAF50" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="YANI" FontWeight="Bold" Margin="10,0,20,0" VerticalAlignment="Center" Foreground="{DynamicResource HeaderText}"/>
                                    
                                    <Border Background="#1E4CAF50" BorderBrush="#4CAF50" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,10,0">
                                        <TextBlock x:Name="TxtStatus" Text="200 OK" FontSize="11" FontWeight="Bold" Foreground="#4CAF50"/>
                                    </Border>
                                    
                                    <Border Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="ClockOutline" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource SecondaryText}"/>
                                            <TextBlock x:Name="TxtTime" Text="120 ms" FontSize="11" Foreground="{DynamicResource HeaderText}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Weight" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource SecondaryText}"/>
                                            <TextBlock x:Name="TxtSize" Text="1.2 KB" FontSize="11" Foreground="{DynamicResource HeaderText}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBox x:Name="TxtSearchResponse" Width="150" Height="30" Margin="0,0,10,0" 
                                             mah:TextBoxHelper.Watermark="Ara..." mah:TextBoxHelper.ClearTextButton="True"
                                             TextChanged="TxtSearchResponse_TextChanged"/>
                                    <Button Style="{StaticResource OutlineButtonStyle}" Width="auto" Padding="10,0" Height="30" Margin="0,0,10,0" Click="BtnCopyResponse_Click">
                                        <iconPacks:PackIconMaterial Kind="ContentCopy" Width="14" Height="14"/>
                                    </Button>
                                    <Button Style="{StaticResource OutlineButtonStyle}" Width="auto" Padding="10,0" Height="30">
                                        <iconPacks:PackIconMaterial Kind="Download" Width="14" Height="14"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <mah:MetroAnimatedSingleRowTabControl Grid.Row="1">
                            <TabItem Header="Body">
                                <TextBox x:Name="TxtResponseBody" IsReadOnly="True" AcceptsReturn="True" 
                                         FontFamily="Consolas" FontSize="13" VerticalScrollBarVisibility="Auto"
                                         Background="{DynamicResource AppBackground}"
                                         Foreground="{DynamicResource HeaderText}"
                                         BorderBrush="{DynamicResource CardBorderBrush}"/>
                            </TabItem>
                            <TabItem Header="Headers">
                                <Border Style="{StaticResource Card}" Padding="0">
                                    <DataGrid x:Name="DgResponseHeaders" IsReadOnly="True" AutoGenerateColumns="False" BorderThickness="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Binding="{Binding Key}" Header="Header" Width="*"/>
                                            <DataGridTextColumn Binding="{Binding Value}" Header="Value" Width="2*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </TabItem>
                        </mah:MetroAnimatedSingleRowTabControl>
                        
                        <!-- Loading Overlay -->
                        <Grid x:Name="LoadingOverlay" Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource TransparentBackgroundBrush}" Visibility="Collapsed">
                            <mah:ProgressRing IsActive="True" Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
