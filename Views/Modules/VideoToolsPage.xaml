<Page x:Class="SwissKnifeApp.Views.Modules.VideoToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:SwissKnifeApp.Views.Modules"
    mc:Ignorable="d"
    Background="{DynamicResource AppBackground}"
    Title="Video Araçları">
    <Page.InputBindings>
        <KeyBinding Command="{x:Static local:VideoToolsPage.PlayCommand}" Key="Z"/>
        <KeyBinding Command="{x:Static local:VideoToolsPage.PauseCommand}" Key="X"/>
        <KeyBinding Command="{x:Static local:VideoToolsPage.SetStartCommand}" Key="C"/>
        <KeyBinding Command="{x:Static local:VideoToolsPage.SetEndCommand}"  Key="V"/>
        <!--<KeyBinding Command="{x:Static local:VideoToolsPage.SetEndCommand}" Modifiers="Control" Key="E"/>-->
        <KeyBinding Command="{x:Static local:VideoToolsPage.StartProcessCommand}" Key="B"/>
        <KeyBinding Command="{x:Static local:VideoToolsPage.BackwardCommand}" Key="A"/>
        <KeyBinding Command="{x:Static local:VideoToolsPage.ForwardCommand}" Key="S"/>
    </Page.InputBindings>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Video İzleme Kartı -->
    <Border Grid.Row="0" Background="#fff3e0" CornerRadius="12" Padding="16" Margin="0,0,0,12" BorderBrush="#ffb74d" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Video Önizleme" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                <MediaElement x:Name="VideoPlayer" Height="260" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button Width="38" Height="38" Click="BtnPlay_Click" ToolTip="Oynat" Style="{StaticResource AccentButtonStyle}">
                        <iconPacks:PackIconMaterial Kind="Play" Width="22" Height="22" Foreground="#e65100"/>
                    </Button>
                    <Button Width="38" Height="38" Margin="8,0,0,0" Click="BtnPause_Click" ToolTip="Duraklat" Style="{StaticResource AccentButtonStyle}">
                        <iconPacks:PackIconMaterial Kind="Pause" Width="22" Height="22" Foreground="#e65100"/>
                    </Button>
                    <Button Width="38" Height="38" Margin="8,0,0,0" Click="BtnStop_Click" ToolTip="Durdur" Style="{StaticResource AccentButtonStyle}">
                        <iconPacks:PackIconMaterial Kind="Stop" Width="22" Height="22" Foreground="#e65100"/>
                    </Button>
                    <Button Width="38" Height="38" Margin="16,0,0,0" Click="BtnBackward_Click" ToolTip="Geri Sar" Style="{StaticResource AccentButtonStyle}">
                        <iconPacks:PackIconMaterial Kind="Rewind" Width="22" Height="22" Foreground="#e65100"/>
                    </Button>
                    <Button Width="38" Height="38" Margin="8,0,0,0" Click="BtnForward_Click" ToolTip="İleri Sar" Style="{StaticResource AccentButtonStyle}">
                        <iconPacks:PackIconMaterial Kind="FastForward" Width="22" Height="22" Foreground="#e65100"/>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock x:Name="TxtCurrentTime" Text="00:00.000" FontWeight="Bold" Foreground="#e65100" Margin="0,0,8,0"/>
                    <Slider x:Name="SliderPosition" Minimum="0" Maximum="100" Value="0" Height="24" Width="220" ToolTip="Zaman Çubuğu"/>
                    <TextBlock x:Name="TxtTotalTime" Text="00:00.000" FontWeight="Bold" Foreground="#e65100" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button Padding="10,6" Click="BtnSetStart_Click" ToolTip="Başlangıç zamanını yakala (Ctrl+B)" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ClockStart" Width="18" Height="18" Foreground="#e65100" Margin="0,0,6,0"/>
                            <TextBlock Text="Başlangıç" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Padding="10,6" Margin="8,0,0,0" Click="BtnSetEnd_Click" ToolTip="Bitiş zamanını yakala (Ctrl+E)" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ClockEnd" Width="18" Height="18" Foreground="#e65100" Margin="0,0,6,0"/>
                            <TextBlock Text="Bitiş" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                
            </StackPanel>
        </Border>

        <!-- Dosya Seçimi Kartı -->
    <Border Grid.Row="1" Background="#fff3e0" CornerRadius="12" Padding="16" Margin="0,0,0,12" BorderBrush="#ffb74d" BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Padding="12,6" Click="BtnPickFiles_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="FolderMultiple" Width="20" Height="20" Foreground="#e65100" Margin="5,0,8,0"/>
                        <TextBlock Text="Dosyaları Seç" FontWeight="SemiBold" Width="70"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="Seçilen:" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="LblSelectedCount" Text="0" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Çıkış Klasörü Kartı -->
    <Border Grid.Row="2" Background="#fff3e0" CornerRadius="12" Padding="16" Margin="0,0,0,12" BorderBrush="#ffb74d" BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <iconPacks:PackIconMaterial Kind="Folder" Width="20" Height="20" Foreground="#e65100" Margin="0,0,8,0"/>
                <TextBlock Text="Çıkış Klasörü" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtOutput" Margin="8,0,0,0" Height="28" Width="360"/>
                <Button Margin="8,0,0,0" Padding="12,6" Click="BtnPickFolder_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="FolderSearch" Width="18" Height="18" Foreground="#e65100" Margin="5,0,6,0"/>
                        <TextBlock Text="Seç" Width="25"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Ayarlar Kartı -->
    <Border Grid.Row="3" Background="#fff3e0" CornerRadius="12" Padding="16" Margin="0,0,0,12" BorderBrush="#ffb74d" BorderThickness="1">
            <StackPanel Orientation="Vertical">
                <!-- Birinci satır -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="Cog" Width="20" Height="20" Foreground="#e65100" Margin="0,0,8,0"/>
                    <TextBlock Text="İşlem:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbMode" Width="160" Margin="8,0,0,0" SelectionChanged="CmbMode_SelectionChanged">
                        <ComboBoxItem Content="Dönüştür" IsSelected="True"/>
                        <ComboBoxItem Content="Ses Çıkar"/>
                        <ComboBoxItem Content="Trim/Kırp"/>
                        <ComboBoxItem Content="Video Stabilize Et"/>
                        <ComboBoxItem Content="GIF Oluştur"/>
                        <ComboBoxItem Content="Hız Ayarla"/>
                        <ComboBoxItem Content="Videoları Birleştir"/>
                        <ComboBoxItem Content="Altyazı Göm"/>
                        <ComboBoxItem Content="Senkron Düzelt"/>
                    </ComboBox>
                    <TextBlock x:Name="LblFormat" Text="Format:" VerticalAlignment="Center" Margin="24,0,0,0"/>
                    <ComboBox x:Name="CmbFormat" Width="120" Margin="8,0,0,0">
                        <ComboBoxItem Content="MP4" IsSelected="True"/>
                        <ComboBoxItem Content="MKV"/>
                        <ComboBoxItem Content="WEBM"/>
                        <ComboBoxItem Content="MOV"/>
                        <ComboBoxItem Content="TS"/>
                        <ComboBoxItem Content="AVI"/>
                        <ComboBoxItem Content="FLV"/>
                    </ComboBox>
                    <TextBlock x:Name="LblCodec" Text="Codec:" VerticalAlignment="Center" Margin="24,0,0,0"/>
                    <ComboBox x:Name="CmbCodec" Width="140" Margin="8,0,0,0">
                        <ComboBoxItem Content="H264" IsSelected="True"/>
                        <ComboBoxItem Content="H265"/>
                        <ComboBoxItem Content="VP9"/>
                        <ComboBoxItem Content="COPY"/>
                    </ComboBox>
                </StackPanel>
                
                <!-- İkinci satır -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,8,0,0">
                    <TextBlock Text="Kalite:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbQuality" Width="140" Margin="8,0,0,0">
                        <ComboBoxItem Content="Highest" IsSelected="True"/>
                        <ComboBoxItem Content="High"/>
                        <ComboBoxItem Content="Medium"/>
                        <ComboBoxItem Content="Low"/>
                        <ComboBoxItem Content="Lossless"/>
                    </ComboBox>
                    <TextBlock x:Name="LblResolution" Text="Çözünürlük:" VerticalAlignment="Center" Margin="24,0,0,0"/>
                    <ComboBox x:Name="CmbResolution" Width="140" Margin="8,0,0,0">
                        <ComboBoxItem Content="Original" IsSelected="True"/>
                        <ComboBoxItem Content="2160p"/>
                        <ComboBoxItem Content="1440p"/>
                        <ComboBoxItem Content="1080p"/>
                        <ComboBoxItem Content="720p"/>
                        <ComboBoxItem Content="480p"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Gelişmiş Ayarlar (Yeni) -->
        <Border Grid.Row="4" Background="#fff3e0" CornerRadius="12" Padding="11" Margin="0,0,0,12" BorderBrush="#ffb74d" BorderThickness="1">
            <StackPanel x:Name="PanelAdvanced">
                <!-- Row 1: Trim/Crop -->
                <StackPanel x:Name="PanelTrimCrop" Orientation="Horizontal" Visibility="Visible" Margin="0,0,0,5">
                    <iconPacks:PackIconMaterial Kind="ScissorsCutting" Width="20" Height="20" Foreground="#e65100" Margin="0,0,8,0"/>
                    <TextBlock Text="Başlangıç" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtStart" Width="90" Height="28" Margin="8,0,0,0"/>
                    <TextBlock Text="Bitiş" VerticalAlignment="Center" Margin="15,0,0,0"/>
                    <TextBox x:Name="TxtEnd" Width="90" Height="28" Margin="8,0,0,0"/>
                    <TextBlock Text="Kırp (x,y,w,h)" VerticalAlignment="Center" Margin="15,0,0,0"/>
                    <TextBox x:Name="TxtCrop" Width="120" Height="28" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Row 2: Speed / Subtitles / GIF Params -->
                <StackPanel x:Name="PanelSpecialParams" Orientation="Horizontal">
                    <!-- Speed -->
                    <StackPanel x:Name="PanelSpeed" Orientation="Horizontal" Visibility="Collapsed">
                        <iconPacks:PackIconMaterial Kind="Speedometer" Width="20" Height="20" Foreground="#e65100" Margin="0,0,8,0"/>
                        <TextBlock Text="Hız Çarpanı (Örn: 2.0 veya 0.5):" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtSpeedMultiplier" Width="60" Text="1.0" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Subtitles -->
                    <StackPanel x:Name="PanelSubtitles" Orientation="Horizontal" Visibility="Collapsed">
                        <iconPacks:PackIconMaterial Kind="FileDocumentEdit" Width="20" Height="20" Foreground="#e65100" Margin="20,0,8,0"/>
                        <TextBlock Text="Altyazı Dosyası (.srt):" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtSubPath" Width="250" Margin="8,0,0,0"/>
                        <Button Content="Seç" Click="BtnPickSubs_Click" Margin="5,0,0,0" Width="60"/>
                    </StackPanel>

                    <!-- GIF -->
                    <StackPanel x:Name="PanelGif" Orientation="Horizontal" Visibility="Collapsed">
                        <iconPacks:PackIconMaterial Kind="FileGifBox" Width="20" Height="20" Foreground="#e65100" Margin="20,0,8,0"/>
                        <TextBlock Text="FPS:" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtGifFps" Width="40" Text="15" Margin="8,0,0,0"/>
                        <TextBlock Text="Genişlik:" VerticalAlignment="Center" Margin="15,0,0,0"/>
                        <TextBox x:Name="TxtGifWidth" Width="60" Text="480" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Sync -->
                    <StackPanel x:Name="PanelSync" Orientation="Horizontal" Visibility="Collapsed">
                        <iconPacks:PackIconMaterial Kind="Sync" Width="20" Height="20" Foreground="#e65100" Margin="20,0,8,0"/>
                        <TextBlock Text="Ses Kayması (sn):" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtSyncOffset" Width="60" Text="0.0" Margin="8,0,0,0"/>
                        <TextBlock Text="(+/-, örn: 0.5 veya -1.2)" FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    
                    <Button x:Name="BtnStart" Margin="24,0,0,0" Padding="16,6" Click="BtnStart_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Play" Width="18" Height="18" Foreground="#e65100" Margin="5,0,6,0"/>
                            <TextBlock Text="Başlat" Width="35"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnCancel" Margin="8,0,0,0" Padding="16,6" Click="BtnCancel_Click" IsEnabled="False" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Cancel" Width="18" Height="18" Foreground="#e65100" Margin="5,0,6,0"/>
                            <TextBlock Text="İptal" Width="30"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- İlerleme ve Log Kartı -->
    <Border Grid.Row="5" Background="#fff3e0" CornerRadius="12" Padding="16" BorderBrush="#ffb74d" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,-40,0,0">
                    <iconPacks:PackIconMaterial Kind="ProgressClock" Width="20" Height="20" Foreground="#e65100" Margin="0,0,8,0"/>
                    <TextBlock Text="İlerleme" FontWeight="Bold"/>
                </StackPanel>
                <ProgressBar x:Name="PbTotal" Grid.Row="0" Height="18" Margin="0,35,0,0" Minimum="0" Maximum="100"/>
                <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,15,0,0" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="TextBox" Width="18" Height="18" Foreground="#e65100" Margin="0,0,8,0"/>
                    <TextBlock Text="Log" FontWeight="Bold"/>
                </StackPanel>
                <ScrollViewer Grid.Row="2" Margin="0,14,0,0">
                    <TextBox x:Name="TxtLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ...eski StackPanel ve Grid kaldırıldı, sadece kartlar kaldı... -->
    </Grid>
</Page>