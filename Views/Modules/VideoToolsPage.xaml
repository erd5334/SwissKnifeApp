<Page x:Class="SwissKnifeApp.Views.Modules.VideoToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:SwissKnifeApp.Views.Modules"
      mc:Ignorable="d"
      d:DesignHeight="1000" d:DesignWidth="1100"
      Title="Video Araçları"
      Background="{DynamicResource AppBackground}">

    <Page.Resources>
        <!-- Video Tools specific accent colors (Orange/Amber) -->
        <SolidColorBrush x:Key="VideoAccent" Color="#FF9800"/>
        <!-- Local override to give video module a consistent Orange theme -->
        <SolidColorBrush x:Key="AccentBrush" Color="{Binding Source={StaticResource VideoAccent}, Path=Color}"/>
    </Page.Resources>

    <Page.InputBindings>
        <KeyBinding Command="{x:Static local:VideoToolsPage.PlayCommand}" Key="Z"/>
        <KeyBinding Command="{x:Static local:VideoToolsPage.PauseCommand}" Key="X"/>
        <KeyBinding Command="{x:Static local:VideoToolsPage.SetStartCommand}" Key="C"/>
        <KeyBinding Command="{x:Static local:VideoToolsPage.SetEndCommand}"  Key="V"/>
        <KeyBinding Command="{x:Static local:VideoToolsPage.StartProcessCommand}" Key="B"/>
        <KeyBinding Command="{x:Static local:VideoToolsPage.BackwardCommand}" Key="A"/>
        <KeyBinding Command="{x:Static local:VideoToolsPage.ForwardCommand}" Key="S"/>
    </Page.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Modern Header -->
        <Border Grid.Row="0" Padding="25,20" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Video" Width="30" Height="30" VerticalAlignment="Center" Foreground="{StaticResource VideoAccent}"/>
                    <TextBlock Text="Video İşleme Araçları" FontSize="24" FontWeight="Bold" Margin="15,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource HeaderText}"/>
                </StackPanel>
                <TextBlock Text="Dönüştürme, kırpma, ses ayıklama ve gelişmiş video düzenleme operasyonları" FontSize="14" Foreground="{DynamicResource SecondaryText}" Margin="45,5,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="25">
            <StackPanel MaxWidth="1000" HorizontalAlignment="Left" Width="950">
                
                <!-- Video Önizleme Kartı -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <iconPacks:PackIconMaterial Kind="TelevisionPlay" Width="20" Height="20" Foreground="{StaticResource VideoAccent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Video Önizleme" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource HeaderText}" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <Border Background="Black" CornerRadius="8">
                            <MediaElement x:Name="VideoPlayer" Height="380" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform"/>
                        </Border>

                        <!-- Video Kontrolleri -->
                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Width="40" Height="40" Click="BtnPlay_Click" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,8,0" ToolTip="Oynat (Z)">
                                    <iconPacks:PackIconMaterial Kind="Play" Width="20" Height="20"/>
                                </Button>
                                <Button Width="40" Height="40" Click="BtnPause_Click" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,8,0" ToolTip="Duraklat (X)">
                                    <iconPacks:PackIconMaterial Kind="Pause" Width="20" Height="20"/>
                                </Button>
                                <Button Width="40" Height="40" Click="BtnStop_Click" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,15,0" ToolTip="Durdur">
                                    <iconPacks:PackIconMaterial Kind="Stop" Width="20" Height="20"/>
                                </Button>
                                <Button Width="40" Height="40" Click="BtnBackward_Click" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,8,0" ToolTip="Geri (A)">
                                    <iconPacks:PackIconMaterial Kind="Rewind" Width="20" Height="20"/>
                                </Button>
                                <Button Width="40" Height="40" Click="BtnForward_Click" Style="{StaticResource OutlineButtonStyle}" ToolTip="İleri (S)">
                                    <iconPacks:PackIconMaterial Kind="FastForward" Width="20" Height="20"/>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="25,0">
                                <Slider x:Name="SliderPosition" Minimum="0" Maximum="100" Value="0" Style="{StaticResource MahApps.Styles.Slider}"/>
                                <Grid Margin="0,5,0,0">
                                    <TextBlock x:Name="TxtCurrentTime" Text="00:00.000" FontSize="11" Foreground="{StaticResource VideoAccent}" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtTotalTime" Text="00:00.000" FontSize="11" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Padding="15,0" Height="40" Click="BtnSetStart_Click" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0" ToolTip="Başlangıç Yakala (C)">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="ClockStart" Width="16" Height="16" Margin="0,0,8,0"/>
                                        <TextBlock Text="BAŞLANGIÇ" FontWeight="Bold" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <Button Padding="15,0" Height="40" Click="BtnSetEnd_Click" Style="{StaticResource AccentButtonStyle}" ToolTip="Bitiş Yakala (V)">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="ClockEnd" Width="16" Height="16" Margin="0,0,8,0"/>
                                        <TextBlock Text="BİTİŞ" FontWeight="Bold" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Dosya ve Hedef Seçimi -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Kaynak Dosyalar -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Kaynak Dosyalar" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{DynamicResource HeaderText}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource AccentButtonStyle}" Click="BtnPickFiles_Click" Padding="15,8">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="FolderMultiple" Width="16" Height="16" Margin="0,0,8,0"/>
                                        <TextBlock Text="Dosya Seç" FontWeight="Bold" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Seçilen:" Foreground="{DynamicResource SecondaryText}"/>
                                    <TextBlock x:Name="LblSelectedCount" Text="0" FontWeight="Bold" Margin="5,0,0,0" Foreground="{StaticResource VideoAccent}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Çıkış Klasörü -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Çıkış Klasörü" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{DynamicResource HeaderText}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="TxtOutput" Style="{StaticResource RoundedTextBox}" Height="36" mah:TextBoxHelper.Watermark="İşlem görmüş videoların kaydedileceği yer..."/>
                                <Button Grid.Column="1" Style="{StaticResource OutlineButtonStyle}" Click="BtnPickFolder_Click" Margin="10,0,0,0" Width="40" Height="36">
                                    <iconPacks:PackIconMaterial Kind="FolderSearch" Width="18" Height="18"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- İşlem Ayarları -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <iconPacks:PackIconMaterial Kind="Cog" Width="18" Height="18" Foreground="{StaticResource VideoAccent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="İşlem ve Kalite Ayarları" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource HeaderText}" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="15"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="İşlem Modu" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" FontSize="11"/>
                                <ComboBox x:Name="CmbMode" Height="38" SelectionChanged="CmbMode_SelectionChanged">
                                    <ComboBoxItem Content="Dönüştür" IsSelected="True"/>
                                    <ComboBoxItem Content="Ses Çıkar"/>
                                    <ComboBoxItem Content="Trim/Kırp"/>
                                    <ComboBoxItem Content="Video Stabilize Et"/>
                                    <ComboBoxItem Content="GIF Oluştur"/>
                                    <ComboBoxItem Content="Hız Ayarla"/>
                                    <ComboBoxItem Content="Videoları Birleştir"/>
                                    <ComboBoxItem Content="Altyazı Göm"/>
                                    <ComboBoxItem Content="Senkron Düzelt"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2" x:Name="PanelFormat">
                                <TextBlock x:Name="LblFormat" Text="Hedef Format" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" FontSize="11"/>
                                <ComboBox x:Name="CmbFormat" Height="38">
                                    <ComboBoxItem Content="MP4" IsSelected="True"/>
                                    <ComboBoxItem Content="MKV"/>
                                    <ComboBoxItem Content="WEBM"/>
                                    <ComboBoxItem Content="MOV"/>
                                    <ComboBoxItem Content="TS"/>
                                    <ComboBoxItem Content="AVI"/>
                                    <ComboBoxItem Content="FLV"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="4" x:Name="PanelCodec">
                                <TextBlock x:Name="LblCodec" Text="Video Codec" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" FontSize="11"/>
                                <ComboBox x:Name="CmbCodec" Height="38">
                                    <ComboBoxItem Content="H264" IsSelected="True"/>
                                    <ComboBoxItem Content="H265"/>
                                    <ComboBoxItem Content="VP9"/>
                                    <ComboBoxItem Content="COPY"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="0" Grid.Row="2">
                                <TextBlock Text="Sıkıştırma Kalitesi" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" FontSize="11"/>
                                <ComboBox x:Name="CmbQuality" Height="38">
                                    <ComboBoxItem Content="Highest" IsSelected="True"/>
                                    <ComboBoxItem Content="High"/>
                                    <ComboBoxItem Content="Medium"/>
                                    <ComboBoxItem Content="Low"/>
                                    <ComboBoxItem Content="Lossless"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Grid.Row="2">
                                <TextBlock x:Name="LblResolution" Text="Çözünürlük" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" FontSize="11"/>
                                <ComboBox x:Name="CmbResolution" Height="38">
                                    <ComboBoxItem Content="Original" IsSelected="True"/>
                                    <ComboBoxItem Content="2160p"/>
                                    <ComboBoxItem Content="1440p"/>
                                    <ComboBoxItem Content="1080p"/>
                                    <ComboBoxItem Content="720p"/>
                                    <ComboBoxItem Content="480p"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Gelişmiş Operasyon Parametreleri -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <iconPacks:PackIconMaterial Kind="Tune" Width="18" Height="18" Foreground="{StaticResource VideoAccent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Operasyon Parametreleri" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource HeaderText}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel x:Name="PanelAdvanced">
                            <!-- Trim/Crop -->
                            <Grid x:Name="PanelTrimCrop" Visibility="Visible" Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Başlangıç" FontSize="11" Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtStart" Style="{StaticResource RoundedTextBox}" Height="36" mah:TextBoxHelper.Watermark="00:00:00"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Bitiş" FontSize="11" Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtEnd" Style="{StaticResource RoundedTextBox}" Height="36" mah:TextBoxHelper.Watermark="00:00:00"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Kırp (x,y,w,h)" FontSize="11" Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtCrop" Style="{StaticResource RoundedTextBox}" Height="36" mah:TextBoxHelper.Watermark="Örn: 0:0:1280:720"/>
                                </StackPanel>
                            </Grid>

                            <!-- Specialized Rows -->
                            <StackPanel x:Name="PanelSpecialParams">
                                <!-- Speed -->
                                <Grid x:Name="PanelSpeed" Visibility="Collapsed" Margin="0,0,0,15">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Hız Çarpanı:" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TxtSpeedMultiplier" Width="80" Text="1.0" Style="{StaticResource RoundedTextBox}" Height="36"/>
                                        <TextBlock Text="(Örn: 2.0 hızlandırır, 0.5 yavaşlatır)" FontSize="10" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Subtitles -->
                                <Grid x:Name="PanelSubtitles" Visibility="Collapsed" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="Altyazı Dosyası (.srt)" FontSize="11" Margin="0,0,0,5"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="TxtSubPath" Style="{StaticResource RoundedTextBox}" Height="36"/>
                                            <Button Grid.Column="1" Content="SEÇ" Click="BtnPickSubs_Click" Style="{StaticResource OutlineButtonStyle}" Width="80" Height="36" Margin="10,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- GIF -->
                                <Grid x:Name="PanelGif" Visibility="Collapsed" Margin="0,0,0,15">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="FPS:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox x:Name="TxtGifFps" Width="60" Text="15" Style="{StaticResource RoundedTextBox}" Height="36" Margin="0,0,20,0"/>
                                        <TextBlock Text="Genişlik:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox x:Name="TxtGifWidth" Width="80" Text="480" Style="{StaticResource RoundedTextBox}" Height="36"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Sync -->
                                <Grid x:Name="PanelSync" Visibility="Collapsed" Margin="0,0,0,15">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Ses Kayması (sn):" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                        <TextBox x:Name="TxtSyncOffset" Width="80" Text="0.0" Style="{StaticResource RoundedTextBox}" Height="36"/>
                                        <TextBlock Text="(+/- orün: 0.5 veya -1.2)" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource SecondaryText}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- Ana Aksiyon Butonları -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button Grid.Column="0" x:Name="BtnStart" Height="50" Click="BtnStart_Click" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="PlayCircle" Width="22" Height="22" Margin="0,0,12,0"/>
                                    <TextBlock Text="İŞLEMİ BAŞLAT" FontWeight="Bold" FontSize="15"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Grid.Column="2" x:Name="BtnCancel" Width="150" Height="50" Click="BtnCancel_Click" IsEnabled="False" Style="{StaticResource OutlineButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="StopCircle" Width="20" Height="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="İPTAL" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- İlerleme ve Log -->
                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <iconPacks:PackIconMaterial Kind="ProgressClock" Width="18" Height="18" Foreground="{StaticResource VideoAccent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="İşlem Durumu" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource HeaderText}" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <mah:MetroProgressBar x:Name="PbTotal" Height="25" Margin="0,0,0,20" Minimum="0" Maximum="100"/>
                        
                        <TextBlock Text="İşlem Günlüğü" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{DynamicResource SecondaryText}"/>
                        <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
                            <TextBox x:Name="TxtLog" 
                                     Height="180" 
                                     IsReadOnly="True" 
                                     AcceptsReturn="True" 
                                     TextWrapping="Wrap" 
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     Padding="10" 
                                     FontSize="12" 
                                     FontFamily="Consolas"
                                     VerticalScrollBarVisibility="Auto"/>
                        </Border>
                    </StackPanel>
                </Border>
                
                <Border Height="50"/> <!-- Alt Boşluk -->
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>