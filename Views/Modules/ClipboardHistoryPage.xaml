<Page x:Class="SwissKnifeApp.Views.Modules.ClipboardHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1000"
      Background="{DynamicResource AppBackground}"
      Title="Pano Pro">

    <Page.Resources>
        <!-- Purple accent for this module -->
        <SolidColorBrush x:Key="ModuleAccent" Color="#9C27B0"/>
        
        <Style x:Key="PinnedIconStyle" TargetType="iconPacks:PackIconMaterial">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter Property="Foreground" Value="#FFD600"/>
                    <Setter Property="Kind" Value="Pin"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPinned}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                    <Setter Property="Kind" Value="PinOutline"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ClipboardItemTemplate">
            <Border Background="{DynamicResource CardBackground}" 
                    BorderBrush="{DynamicResource CardBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Margin="0,0,0,10" 
                    Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Style="{StaticResource MahApps.Styles.Button.Chromeless}" 
                            Click="BtnPin_Click" 
                            Margin="0,0,15,0"
                            VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Style="{StaticResource PinnedIconStyle}" Width="16" Height="16"/>
                    </Button>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}" 
                                   Foreground="{DynamicResource HeaderText}"
                                   FontSize="13" 
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Type}" 
                                   FontSize="11" 
                                   Foreground="{DynamicResource SecondaryText}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" 
                               Text="{Binding Preview}" 
                               Foreground="{DynamicResource AppForeground}"
                               VerticalAlignment="Center" 
                               TextTrimming="CharacterEllipsis"
                               FontSize="14"
                               Margin="10,0"/>
                    
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Star" Foreground="#FFD600" Width="14" Height="14" 
                                                    Visibility="{Binding IsPinned, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Margin="0,0,10,0"/>
                        <iconPacks:PackIconMaterial Kind="FileDocument" Foreground="{StaticResource ModuleAccent}" Width="14" Height="14" 
                                                    Visibility="{Binding IsTemplate, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Margin="0,0,10,0"/>
                        <Button Style="{StaticResource OutlineButtonStyle}" 
                                Click="BtnCopyNow_Click" 
                                ToolTip="Kopyala" 
                                Width="32" Height="32" Padding="0"
                                mah:ControlsHelper.CornerRadius="16">
                            <iconPacks:PackIconMaterial Kind="ContentCopy" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Modern Header -->
        <Border Grid.Row="0" Padding="25,20" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ClipboardTextMultiple" Width="30" Height="30" VerticalAlignment="Center" Foreground="{StaticResource ModuleAccent}"/>
                        <TextBlock Text="Pano Yöneticisi" FontSize="24" FontWeight="Bold" Margin="15,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource HeaderText}"/>
                    </StackPanel>
                    <TextBlock Text="Akıllı pano geçmişi, şablonlar ve OCR araçları" FontSize="14" Foreground="{DynamicResource SecondaryText}" Margin="45,5,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Style="{StaticResource RoundedTextBox}" Width="300" Height="40" 
                             mah:TextBoxHelper.Watermark="Geçmişte ara..." mah:TextBoxHelper.ClearTextButton="True"
                             mah:TextBoxHelper.SelectAllOnFocus="True"
                             TextChanged="SearchBox_TextChanged"
                             Margin="0,0,10,0"/>
                    <Button Style="{StaticResource OutlineButtonStyle}" Width="40" Height="40" Click="Clear_Click" ToolTip="Geçmişi Temizle" mah:ControlsHelper.CornerRadius="6">
                        <iconPacks:PackIconMaterial Kind="DeleteSweep" Width="18" Height="18" Foreground="#E74C3C"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tool Bar -->
        <Border Grid.Row="1" Margin="20,20,20,10" Padding="15" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <iconPacks:PackIconMaterial Kind="TextBoxPlus" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="{StaticResource ModuleAccent}"/>
                
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtTemplateName" Style="{StaticResource RoundedTextBox}" mah:TextBoxHelper.Watermark="Şablon Adı" Margin="0,0,10,0" Height="36"/>
                    <TextBox x:Name="TxtTemplateContent" Grid.Column="1" Style="{StaticResource RoundedTextBox}" mah:TextBoxHelper.Watermark="Hızlıca yapıştırılacak metin..." Margin="0,0,10,0" Height="36"/>
                    <Button Grid.Column="2" Content="Şablon Ekle" Style="{StaticResource AccentButtonStyle}" Click="BtnAddTemplate_Click" Height="36" Padding="20,0"/>
                </Grid>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="15,0,0,0">
                    <Button x:Name="BtnOcr" Style="{StaticResource OutlineButtonStyle}" Click="BtnOcr_Click" ToolTip="Görselden Metin Al (OCR)" IsEnabled="False" Height="36" Padding="15,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="TextBoxSearch" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="OCR"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content (Tabs) -->
        <mah:MetroAnimatedSingleRowTabControl Grid.Row="2" Margin="20,0,20,20" mah:HeaderedControlHelper.HeaderFontSize="15">
            <TabItem Header="Tüm Geçmiş">
                <ListView x:Name="ClipboardList" 
                          BorderThickness="0" 
                          Background="Transparent" 
                          Padding="0,10,0,0"
                          ItemTemplate="{StaticResource ClipboardItemTemplate}"
                          MouseDoubleClick="ClipboardList_MouseDoubleClick" 
                          SelectionChanged="ClipboardList_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,2"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </TabItem>
            
            <TabItem Header="Pinlenenler">
                <ListView x:Name="PinnedList" 
                          BorderThickness="0" 
                          Background="Transparent" 
                          Padding="0,10,0,0"
                          ItemTemplate="{StaticResource ClipboardItemTemplate}"
                          MouseDoubleClick="ClipboardList_MouseDoubleClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </TabItem>

            <TabItem Header="Hızlı Şablonlar">
                <ListView x:Name="TemplatesList" 
                          BorderThickness="0" 
                          Background="Transparent" 
                          Padding="0,10,0,0"
                          ItemTemplate="{StaticResource ClipboardItemTemplate}"
                          MouseDoubleClick="ClipboardList_MouseDoubleClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </TabItem>

            <TabItem Header="Otomatik Sıra (Sequence)">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Margin="0,0,0,15" Padding="15" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="OrderAlphabeticalAscending" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="Sıradaki Öğeyi Kopyala:" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource HeaderText}" Margin="0,0,15,0"/>
                                <Button x:Name="BtnNextInSequence" Content="ŞİMDİ KOPYALA" Style="{StaticResource AccentButtonStyle}" Click="BtnNextInSequence_Click" Padding="20,0" Height="36"/>
                                <TextBlock x:Name="TxtSequenceStatus" Text="Sıra boş" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="{DynamicResource SecondaryText}" FontStyle="Italic"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <ListView x:Name="SequenceList" Grid.Row="1" BorderThickness="0" Background="Transparent">
                         <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource AccentBrush}" Width="24" Height="24" CornerRadius="12">
                                            <TextBlock Text="{Binding Index}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Content}" VerticalAlignment="Center" Foreground="{DynamicResource AppForeground}" Margin="10,0" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="2" Click="BtnRemoveFromSequence_Click" Style="{StaticResource MahApps.Styles.Button.Chromeless}">
                                            <iconPacks:PackIconMaterial Kind="Close" Width="16" Height="16" Foreground="#E74C3C"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </TabItem>
        </mah:MetroAnimatedSingleRowTabControl>

        <!-- Image Preview Popup -->
        <Popup x:Name="ImagePopup" Placement="Center" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="12" Padding="20" MaxWidth="600">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Görsel Önizleme" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource HeaderText}" Margin="0,0,0,15"/>
                    <Border Background="{DynamicResource AppBackground}" CornerRadius="8" Padding="5" Margin="0,0,0,15">
                        <Image x:Name="PopupImage" MaxHeight="450" Stretch="Uniform"/>
                    </Border>
                    <TextBlock x:Name="TxtOcrResult" TextWrapping="Wrap" Margin="0,0,0,20" MaxHeight="100" FontStyle="Italic" Foreground="{DynamicResource SecondaryText}"/>
                    <Button Style="{StaticResource OutlineButtonStyle}" Click="ClosePopup_Click" Content="Kapat" Height="36"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Page>

