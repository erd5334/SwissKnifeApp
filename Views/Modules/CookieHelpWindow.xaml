<Window x:Class="SwissKnifeApp.Views.Modules.CookieHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="Cookie Yardımı"
        Height="650" Width="800"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="{DynamicResource MahApps.Brushes.ThemeBackground}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🍪 YouTube Cookie Kullanımı"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
            <TextBlock Text="Yaş sınırlı ve premium içerikleri indirmek için cookie dosyası nasıl kullanılır?"
                       FontSize="14"
                       Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- İçerik -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                
                <!-- Neden Cookie? -->
                <Border Background="{DynamicResource MahApps.Brushes.Accent4}"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10">
                            <iconPacks:PackIconMaterial Kind="Information" Margin="0,0,5,0"/>
                            <Run Text="Neden Cookie Gerekir?"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" LineHeight="22">
                            YouTube bazı videoları yalnızca giriş yapmış kullanıcılara açar:
                        </TextBlock>
                        <TextBlock Margin="15,5,0,0" TextWrapping="Wrap" LineHeight="20">
                            • Yaş sınırlı içerikler (18+)
                        </TextBlock>
                        <TextBlock Margin="15,0,0,0" TextWrapping="Wrap" LineHeight="20">
                            • Premium/Üyelik gerektiren videolar
                        </TextBlock>
                        <TextBlock Margin="15,0,0,0" TextWrapping="Wrap" LineHeight="20">
                            • Özel gizlilik ayarlarına sahip videolar
                        </TextBlock>
                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="22" FontStyle="Italic">
                            Cookie dosyası, tarayıcınızdaki YouTube giriş bilgilerinizi program ile paylaşır.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Adım 1: Tarayıcı Eklentisi -->
                <Border BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10">
                            <iconPacks:PackIconMaterial Kind="Numeric1Circle" 
                                                       Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                                       Margin="0,0,5,0"/>
                            <Run Text="Adım 1: Tarayıcı Eklentisini Yükleyin"/>
                        </TextBlock>
                        
                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,5">
                            Önerilen Eklentiler:
                        </TextBlock>
                        
                        <!-- Chrome -->
                        <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                                BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="10"
                                Margin="0,5,0,5">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold">
                                    <iconPacks:PackIconMaterial Kind="GoogleChrome" Foreground="#4285F4" Margin="0,0,5,0"/>
                                    <Run Text="Chrome / Edge / Brave"/>
                                </TextBlock>
                                <TextBlock Margin="25,5,0,0" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12">
                                    "Get cookies.txt LOCALLY" by Ninh Pham
                                </TextBlock>
                                <Button Content="Chrome Web Store'da Aç"
                                        Margin="25,5,0,0"
                                        Padding="8,4"
                                        Click="BtnOpenChromeStore_Click"
                                        Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"/>
                            </StackPanel>
                        </Border>

                        <!-- Firefox -->
                        <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                                BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="10"
                                Margin="0,5,0,5">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold">
                                    <iconPacks:PackIconMaterial Kind="Firefox" Foreground="#FF7139" Margin="0,0,5,0"/>
                                    <Run Text="Firefox"/>
                                </TextBlock>
                                <TextBlock Margin="25,5,0,0" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12">
                                    "cookies.txt" by Lennon Hill
                                </TextBlock>
                                <Button Content="Firefox Add-ons'da Aç"
                                        Margin="25,5,0,0"
                                        Padding="8,4"
                                        Click="BtnOpenFirefoxAddons_Click"
                                        Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Adım 2: Cookie Dışa Aktarma -->
                <Border BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10">
                            <iconPacks:PackIconMaterial Kind="Numeric2Circle" 
                                                       Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                                       Margin="0,0,5,0"/>
                            <Run Text="Adım 2: Cookie Dosyasını Dışa Aktarın"/>
                        </TextBlock>
                        
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="22">
                            1. YouTube'a giriş yapın (www.youtube.com)
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="22">
                            2. Yüklediğiniz eklentinin simgesine tıklayın
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="22">
                            3. "Export" veya "Download" butonuna tıklayın
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="22">
                            4. Dosyayı bilgisayarınıza kaydedin (örn: youtube_cookies.txt)
                        </TextBlock>

                        <Border Background="#FFF3CD"
                                BorderBrush="#FFECB3"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="10"
                                Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold">
                                    <iconPacks:PackIconMaterial Kind="AlertCircle" Foreground="#856404" Margin="0,0,5,0"/>
                                    <Run Text="Önemli Notlar:" Foreground="#856404"/>
                                </TextBlock>
                                <TextBlock Margin="25,5,0,0" TextWrapping="Wrap" Foreground="#856404">
                                    • Dosya formatı .txt olmalıdır
                                </TextBlock>
                                <TextBlock Margin="25,0,0,0" TextWrapping="Wrap" Foreground="#856404">
                                    • YouTube'dan çıkış yaparsanız cookie geçersiz olur
                                </TextBlock>
                                <TextBlock Margin="25,0,0,0" TextWrapping="Wrap" Foreground="#856404">
                                    • Şifrenizi değiştirirseniz yeni cookie almalısınız
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Adım 3: Programda Kullanım -->
                <Border BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10">
                            <iconPacks:PackIconMaterial Kind="Numeric3Circle" 
                                                       Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                                       Margin="0,0,5,0"/>
                            <Run Text="Adım 3: Programda Kullanın"/>
                        </TextBlock>
                        
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="22">
                            1. YouTube Klip İndirici modülünde "Cookie Dosyası (Opsiyonel)" alanını bulun
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="22">
                            2. "Seç" butonuna tıklayın ve kaydettiğiniz .txt dosyasını seçin
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="22">
                            3. Artık yaş sınırlı ve premium videoları indirebilirsiniz!
                        </TextBlock>

                        <Border Background="#D1ECF1"
                                BorderBrush="#BEE5EB"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="10"
                                Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold">
                                    <iconPacks:PackIconMaterial Kind="CheckCircle" Foreground="#0C5460" Margin="0,0,5,0"/>
                                    <Run Text="İpucu:" Foreground="#0C5460"/>
                                </TextBlock>
                                <TextBlock Margin="25,5,0,0" TextWrapping="Wrap" Foreground="#0C5460">
                                    Cookie dosyası opsiyoneldir. Normal videolar için gerekli değildir.
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Güvenlik -->
                <Border Background="#F8D7DA"
                        BorderBrush="#F5C6CB"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#721C24">
                            <iconPacks:PackIconMaterial Kind="ShieldAlert" Margin="0,0,5,0"/>
                            <Run Text="Güvenlik Uyarısı"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" LineHeight="22" Foreground="#721C24">
                            • Cookie dosyası hassas bilgilerinizi içerir, başkalarıyla paylaşmayın
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" LineHeight="22" Foreground="#721C24" Margin="0,5,0,0">
                            • Güvenilmeyen programlarda kullanmayın
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" LineHeight="22" Foreground="#721C24" Margin="0,5,0,0">
                            • Düzenli olarak şifrenizi değiştirin ve yeni cookie alın
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" LineHeight="22" Foreground="#721C24" Margin="0,5,0,0">
                            • Cookie dosyasını güvenli bir yerde saklayın
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Alt Butonlar -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="Kapat"
                    Click="BtnClose_Click"
                    Padding="20,8"
                    MinWidth="100"
                    Style="{DynamicResource MahApps.Styles.Button.Square}"/>
        </StackPanel>
    </Grid>
</Window>
