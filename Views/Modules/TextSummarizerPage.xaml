<Page x:Class="SwissKnifeApp.Views.Modules.TextSummarizerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      Title="Metin/Belge Özetleyici"
      Background="{DynamicResource AppBackground}">

    <Page.Resources>
        <!-- Text Summarizer specific accent colors (Teal/Cyan) -->
        <SolidColorBrush x:Key="SummarizerAccent" Color="#0097A7"/>
        <!-- Local override to give module a consistent Teal theme -->
        <SolidColorBrush x:Key="AccentBrush" Color="{Binding Source={StaticResource SummarizerAccent}, Path=Color}"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Modern Header -->
        <Border Grid.Row="0" Padding="25,20" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="FileDocumentEdit" Width="30" Height="30" VerticalAlignment="Center" Foreground="{StaticResource SummarizerAccent}"/>
                    <TextBlock Text="Metin/Belge Özetleyici" FontSize="24" FontWeight="Bold" Margin="15,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource HeaderText}"/>
                </StackPanel>
                <TextBlock Text="Yapay zeka algoritmaları ile metinlerinizi özetleyin ve analiz edin" FontSize="14" Foreground="{DynamicResource SecondaryText}" Margin="45,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Ana İçerik -->
        <Grid Grid.Row="1" Margin="25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="25"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sol Panel - Giriş Metni -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Başlık ve Aksiyonlar -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FileDocument" Width="20" Height="20" Foreground="{StaticResource SummarizerAccent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Kaynak Metin" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource HeaderText}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Click="BtnLoadFile_Click" Style="{StaticResource OutlineButtonStyle}" Height="32" Padding="12,0" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="FolderOpen" Width="14" Height="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="Dosya" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Click="BtnClearInput_Click" Style="{StaticResource OutlineButtonStyle}" Height="32" Padding="12,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="DeleteSweep" Width="14" Height="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="Temizle" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Dil Seçimi -->
                    <Border Grid.Row="1" Background="{DynamicResource AppBackground}" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Translate" Width="18" Height="18" Foreground="{StaticResource SummarizerAccent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Analiz Dili:" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="SemiBold" Foreground="{DynamicResource HeaderText}"/>
                            <ComboBox x:Name="CmbLanguage" Width="160" Height="36" SelectedIndex="0">
                                <ComboBoxItem Tag="tr">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Flag" Width="14" Height="14" Margin="0,0,10,0" Foreground="#E02D1B"/>
                                        <TextBlock Text="Türkçe"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="en">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Flag" Width="14" Height="14" Margin="0,0,10,0" Foreground="#1976D2"/>
                                        <TextBlock Text="İngilizce"/>
                                    </StackPanel>
                                </ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Metin Girişi -->
                    <TextBox Grid.Row="2" x:Name="TxtInputText" 
                             Style="{StaticResource RoundedTextBox}"
                             TextWrapping="Wrap" 
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Padding="12"
                             FontSize="14"
                             mah:TextBoxHelper.Watermark="Özetlenecek metni buraya yapıştırın..."
                             Text="Buraya metninizi yapıştırın veya dosya yükleyin..."/>

                    <!-- İstatistikler -->
                    <Border Grid.Row="3" Background="{StaticResource SummarizerAccent}" CornerRadius="8" Padding="12" Margin="0,15,0,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ChartBar" Width="18" Height="18" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtInputStats" Text="Kelime: 0 | Cümle: 0 | Karakter: 0" 
                                       FontSize="13" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Sağ Panel - Sonuçlar -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <mah:MetroAnimatedSingleRowTabControl mah:HeaderedControlHelper.HeaderFontSize="14" Background="Transparent" BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem" BasedOn="{StaticResource MahApps.Styles.TabItem}">
                            <Setter Property="Padding" Value="20,12"/>
                            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                        </Style>
                    </TabControl.Resources>

                    <!-- Özet Sekmesi -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="TextBoxCheck" Width="16" Height="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Özet"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Özet Ayarları -->
                            <Border Grid.Row="0" Background="{DynamicResource AppBackground}" CornerRadius="12" Padding="15" Margin="0,0,0,20">
                                <StackPanel>
                                    <Grid Margin="0,0,0,15">
                                        <iconPacks:PackIconMaterial Kind="Cog" Width="16" Height="16" Foreground="{StaticResource SummarizerAccent}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        <TextBlock Text="Özet Ayarları" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource HeaderText}" Margin="25,0,0,0"/>
                                    </Grid>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="Özet Oranı:" VerticalAlignment="Center" Width="85" Foreground="{DynamicResource SecondaryText}"/>
                                        <Slider x:Name="SliderSummaryRatio" Minimum="10" Maximum="50" Value="30" 
                                                Width="200" TickFrequency="5" IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                ValueChanged="SliderSummaryRatio_ValueChanged"/>
                                        <TextBlock x:Name="TxtSummaryRatio" Text="30%" VerticalAlignment="Center" 
                                                   Margin="15,0,0,0" FontWeight="Bold" Foreground="{StaticResource SummarizerAccent}" FontSize="15"/>
                                    </StackPanel>
                                    
                                    <Button Click="BtnSummarize_Click" Style="{StaticResource AccentButtonStyle}" Height="42" Padding="25,0" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="AutoFix" Width="18" Height="18" Margin="0,0,10,0"/>
                                            <TextBlock Text="METNİ ÖZETLE" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Özet Metni -->
                            <TextBox Grid.Row="1" x:Name="TxtSummary" 
                                     Style="{StaticResource RoundedTextBox}"
                                     TextWrapping="Wrap" 
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     IsReadOnly="True"
                                     Padding="15"
                                     FontSize="14"
                                     mah:TextBoxHelper.Watermark="Özet burada görünecek..."/>

                            <!-- Alt Aksiyonlar -->
                            <StackPanel Grid.Row="2" Margin="0,15,0,0">
                                <Border x:Name="BorderSummaryStats" Background="{DynamicResource SummarizerAccent}" Opacity="0.9" CornerRadius="8" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Information" Width="16" Height="16" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtSummaryStats" Text="Özet oluşturulmadı." FontSize="13" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Button Click="BtnCopySummary_Click" Style="{StaticResource OutlineButtonStyle}" Height="40">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="ContentCopy" Width="16" Height="16" Margin="0,0,10,0"/>
                                        <TextBlock Text="Özeti Kopyala" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- Anahtar Kelimeler Sekmesi -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Key" Width="16" Height="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Anahtar Kelimeler"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource AppBackground}" CornerRadius="12" Padding="15" Margin="0,0,0,20">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="Kelime Sayısı:" VerticalAlignment="Center" Width="100" Foreground="{DynamicResource SecondaryText}"/>
                                        <mah:NumericUpDown x:Name="NumKeywordCount" Value="10" Minimum="5" Maximum="50" Width="120" Height="36"/>
                                    </StackPanel>
                                    <Button Click="BtnFindKeywords_Click" Style="{StaticResource AccentButtonStyle}" Height="42" Padding="25,0" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Magnify" Width="18" Height="18" Margin="0,0,10,0"/>
                                            <TextBlock Text="KELİMELERİ BUL" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Background="{DynamicResource AppBackground}" CornerRadius="12" Padding="5">
                                <ListBox x:Name="LstKeywords" Background="Transparent" BorderThickness="0" Padding="5">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8" Padding="12" Background="{DynamicResource CardBackground}" CornerRadius="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{StaticResource SummarizerAccent}" CornerRadius="15" Width="26" Height="26" Margin="0,0,15,0">
                                                        <TextBlock Text="{Binding Rank}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Word}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource HeaderText}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="2" Background="{DynamicResource AppBackground}" CornerRadius="4" Padding="8,4">
                                                        <TextBlock Text="{Binding Score, StringFormat='{}{0:F2}'}" Foreground="{StaticResource SummarizerAccent}" FontWeight="Bold" FontSize="12"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <Button Grid.Row="2" Click="BtnCopyKeywords_Click" Style="{StaticResource OutlineButtonStyle}" Height="40" Margin="0,15,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ContentCopy" Width="16" Height="16" Margin="0,0,10,0"/>
                                    <TextBlock Text="Kelimeleri Kopyala" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </TabItem>

                    <!-- Önemli Cümleler Sekmesi -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Star" Width="16" Height="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Önemli Cümleler"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource AppBackground}" CornerRadius="12" Padding="15" Margin="0,0,0,20">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="Cümle Sayısı:" VerticalAlignment="Center" Width="100" Foreground="{DynamicResource SecondaryText}"/>
                                        <mah:NumericUpDown x:Name="NumSentenceCount" Value="5" Minimum="3" Maximum="20" Width="120" Height="36"/>
                                    </StackPanel>
                                    <Button Click="BtnFindSentences_Click" Style="{StaticResource AccentButtonStyle}" Height="42" Padding="25,0" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="StarCircle" Width="18" Height="18" Margin="0,0,10,0"/>
                                            <TextBlock Text="CÜMLELERİ ANALİZ ET" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Background="{DynamicResource AppBackground}" CornerRadius="12" Padding="5">
                                <ListBox x:Name="LstSentences" Background="Transparent" BorderThickness="0" Padding="5">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,12" Padding="15" Background="{DynamicResource CardBackground}" CornerRadius="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{StaticResource SummarizerAccent}" CornerRadius="4" Padding="10,4">
                                                            <StackPanel Orientation="Horizontal">
                                                                <iconPacks:PackIconMaterial Kind="Star" Width="12" Height="12" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Rank}" FontWeight="Bold" Foreground="White" FontSize="12"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Score, StringFormat='Skor: {0:F2}'}" Foreground="{DynamicResource SecondaryText}" FontSize="12" Margin="15,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" LineHeight="22" Foreground="{DynamicResource HeaderText}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <Button Grid.Row="2" Click="BtnCopySentences_Click" Style="{StaticResource OutlineButtonStyle}" Height="40" Margin="0,15,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ContentCopy" Width="16" Height="16" Margin="0,0,10,0"/>
                                    <TextBlock Text="Cümleleri Kopyala" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </TabItem>
                </mah:MetroAnimatedSingleRowTabControl>
            </Border>
        </Grid>
    </Grid>
</Page>
