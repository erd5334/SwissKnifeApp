<Page x:Class="SwissKnifeApp.Views.Modules.TextSummarizerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      Title="Metin/Belge Özetleyici"
      Background="{DynamicResource MahApps.Brushes.ThemeBackground}">

    <Grid Margin="20">
        <!-- Accent Color for TextSummarizer: Teal/Cyan -->
        <Grid.Resources>
            <SolidColorBrush x:Key="AccentTealBrush" Color="#00BCD4"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Card -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Background="White" BorderBrush="{StaticResource AccentTealBrush}" BorderThickness="2" CornerRadius="12" Padding="24" Margin="0,0,0,15">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="FileDocumentEdit" Width="32" Height="32" Foreground="{StaticResource AccentTealBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Metin/Belge Özetleyici" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentTealBrush}"/>
                </StackPanel>
                <TextBlock Text="Uzun metinleri özetle, anahtar kelimeleri ve önemli cümleleri çıkar" FontSize="14" Foreground="{DynamicResource MahApps.Brushes.Gray1}" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Ana İçerik -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sol Panel - Giriş Metni Card -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Background="White" BorderBrush="{StaticResource AccentTealBrush}" BorderThickness="2" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Başlık -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <iconPacks:PackIconMaterial Kind="FileDocument" Width="20" Height="20" Foreground="{StaticResource AccentTealBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="Kaynak Metin" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentTealBrush}"/>
                    </StackPanel>

                    <!-- Dosya Yükleme ve Dil Seçimi -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Click="BtnLoadFile_Click" Style="{StaticResource AccentButtonStyle}" Height="35" Padding="12,0" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="FolderOpen" Width="16" Height="16" Foreground="{StaticResource AccentTealBrush}" Margin="5,0,8,0"/>
                                    <TextBlock Text="Dosya Yükle" Width="60"/>
                                </StackPanel>
                            </Button>
                            <Button Click="BtnClearInput_Click" Style="{StaticResource OutlineButtonStyle}" Height="35" Padding="12,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="DeleteSweep" Width="16" Height="16" Margin="5,0,8,0"/>
                                    <TextBlock Text="Temizle" Width="40"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Translate" Width="18" Height="18" Foreground="{StaticResource AccentTealBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Dil:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                            <ComboBox x:Name="CmbLanguage" Width="140" Height="32" SelectedIndex="0">
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Flag" Width="14" Height="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="Türkçe"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Flag" Width="14" Height="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="İngilizce"/>
                                    </StackPanel>
                                </ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <!-- Metin Girişi -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource AccentTealBrush}" BorderThickness="1" CornerRadius="8">
                        <TextBox x:Name="TxtInputText" 
                                 TextWrapping="Wrap" 
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="12"
                                 FontSize="13"
                                 Background="#FAFAFA"
                                 Text="Buraya metninizi yapıştırın veya dosya yükleyin..."/>
                    </Border>

                    <!-- İstatistikler -->
                    <Border Grid.Row="3" Background="{StaticResource AccentTealBrush}" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ChartBar" Width="16" Height="16" Foreground="White" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtInputStats" Text="Kelime: 0 | Cümle: 0 | Karakter: 0" 
                                       FontSize="12" Foreground="White" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Sağ Panel - Sonuçlar TabControl Card -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Background="White" BorderBrush="{StaticResource AccentTealBrush}" BorderThickness="2" CornerRadius="12" Padding="20">
                <TabControl Style="{StaticResource MahApps.Styles.TabControl}">
                    <!-- Özet Sekmesi -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="TextBoxCheck" Width="16" Height="16" Foreground="{StaticResource AccentTealBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Özet"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Özet Ayarları -->
                            <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="Özet Ayarları" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentTealBrush}" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <iconPacks:PackIconMaterial Kind="Percent" Width="16" Height="16" Foreground="{StaticResource AccentTealBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Özet Oranı:" VerticalAlignment="Center" Width="80"/>
                                        <Slider x:Name="SliderSummaryRatio" Minimum="10" Maximum="50" Value="30" 
                                                Width="180" TickFrequency="5" IsSnapToTickEnabled="True"
                                                ValueChanged="SliderSummaryRatio_ValueChanged"/>
                                        <TextBlock x:Name="TxtSummaryRatio" Text="30%" VerticalAlignment="Center" 
                                                   Margin="10,0,0,0" FontWeight="Bold" Foreground="{StaticResource AccentTealBrush}"/>
                                    </StackPanel>
                                    <Button Click="BtnSummarize_Click" Style="{StaticResource AccentButtonStyle}" Height="38" Padding="20,0" Margin="0,15,0,0" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Summit" Width="18" Height="18" Foreground="{StaticResource AccentTealBrush}" Margin="5,0,10,0"/>
                                            <TextBlock Text="Özetle" Width="40" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Özet Metni -->
                            <Border Grid.Row="1" BorderBrush="{StaticResource AccentTealBrush}" BorderThickness="1" CornerRadius="8">
                                <TextBox x:Name="TxtSummary" 
                                         TextWrapping="Wrap" 
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         IsReadOnly="True"
                                         Padding="12"
                                         FontSize="13"
                                         Background="#FAFAFA"/>
                            </Border>

                            <!-- Özet İstatistikleri ve Kopyala -->
                            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                <Border Background="{StaticResource AccentTealBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="InformationOutline" Width="16" Height="16" Foreground="White" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TxtSummaryStats" Text="Özet oluşturulmadı." FontSize="12" Foreground="White" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <Button Click="BtnCopySummary_Click" Style="{StaticResource AccentButtonStyle}" Height="35" Padding="15,0">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="ContentCopy" Width="16" Height="16" Foreground="{StaticResource AccentTealBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="Özeti Kopyala"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- Anahtar Kelimeler Sekmesi -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Key" Width="16" Height="16" Foreground="{StaticResource AccentTealBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Anahtar Kelimeler"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Anahtar Kelime Ayarları -->
                            <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="Anahtar Kelime Ayarları" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentTealBrush}" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <iconPacks:PackIconMaterial Kind="Numeric" Width="16" Height="16" Foreground="{StaticResource AccentTealBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Kelime Sayısı:" VerticalAlignment="Center" Width="100"/>
                                        <mah:NumericUpDown x:Name="NumKeywordCount" Value="10" Minimum="5" Maximum="50" Width="100"/>
                                    </StackPanel>
                                    <Button Click="BtnFindKeywords_Click" Style="{StaticResource AccentButtonStyle}" Height="38" Padding="20,0" Margin="0,15,0,0" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Magnify" Width="18" Height="18" Foreground="{StaticResource AccentTealBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="Anahtar Kelimeleri Bul" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Anahtar Kelimeler Listesi -->
                            <Border Grid.Row="1" BorderBrush="{StaticResource AccentTealBrush}" BorderThickness="1" CornerRadius="8">
                                <ListBox x:Name="LstKeywords" FontSize="13" Padding="5" Background="#FAFAFA">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="3" Padding="8" Background="White" CornerRadius="5" BorderBrush="{StaticResource AccentTealBrush}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="{StaticResource AccentTealBrush}" CornerRadius="12" Width="24" Height="24" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Rank}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Word}" FontSize="14" FontWeight="SemiBold" Width="180" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Score, StringFormat='({0:F2})'}" Foreground="{StaticResource AccentTealBrush}" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <!-- Anahtar Kelime Aksiyonları -->
                            <Button Grid.Row="2" Click="BtnCopyKeywords_Click" Style="{StaticResource AccentButtonStyle}" Height="35" Padding="15,0" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ContentCopy" Width="16" Height="16" Foreground="{StaticResource AccentTealBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Kelimeleri Kopyala"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </TabItem>

                    <!-- Önemli Cümleler Sekmesi -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Star" Width="16" Height="16" Foreground="{StaticResource AccentTealBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Önemli Cümleler"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Önemli Cümle Ayarları -->
                            <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="Önemli Cümle Ayarları" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentTealBrush}" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <iconPacks:PackIconMaterial Kind="Numeric" Width="16" Height="16" Foreground="{StaticResource AccentTealBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Cümle Sayısı:" VerticalAlignment="Center" Width="100"/>
                                        <mah:NumericUpDown x:Name="NumSentenceCount" Value="5" Minimum="3" Maximum="20" Width="100"/>
                                    </StackPanel>
                                    <Button Click="BtnFindSentences_Click" Style="{StaticResource AccentButtonStyle}" Height="38" Padding="20,0" Margin="0,15,0,0" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="StarCircle" Width="18" Height="18" Foreground="{StaticResource AccentTealBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="Önemli Cümleleri Bul" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Önemli Cümleler Listesi -->
                            <Border Grid.Row="1" BorderBrush="{StaticResource AccentTealBrush}" BorderThickness="1" CornerRadius="8">
                                <ListBox x:Name="LstSentences" FontSize="13" Padding="5" Background="#FAFAFA">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="5" Padding="12" Background="White" CornerRadius="8" BorderBrush="{StaticResource AccentTealBrush}" BorderThickness="1">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <Border Background="{StaticResource AccentTealBrush}" CornerRadius="3" Padding="6,2">
                                                            <StackPanel Orientation="Horizontal">
                                                                <iconPacks:PackIconMaterial Kind="Star" Width="12" Height="12" Foreground="White" Margin="0,0,4,0"/>
                                                                <TextBlock Text="{Binding Rank}" FontWeight="Bold" Foreground="White" FontSize="11"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Text="{Binding Score, StringFormat='Skor: {0:F2}'}" Foreground="{StaticResource AccentTealBrush}" FontSize="11" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="#2C3E50"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <!-- Önemli Cümle Aksiyonları -->
                            <Button Grid.Row="2" Click="BtnCopySentences_Click" Style="{StaticResource AccentButtonStyle}" Height="35" Padding="15,0" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ContentCopy" Width="16" Height="16" Foreground="{StaticResource AccentTealBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Cümleleri Kopyala"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Page>
