<Page x:Class="SwissKnifeApp.Views.Modules.SqlToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
      xmlns:local="clr-namespace:SwissKnifeApp.Views.Modules"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1000"
      Title="SQL Araçları">

    <Grid Background="{DynamicResource AppBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" x:Name="SidebarColumn"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: Database Connections / Tables -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0" Background="{DynamicResource CardBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Padding="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="SQL Bağlantısı" FontWeight="Bold" FontSize="14"/>
                </Border>

                <StackPanel Grid.Row="1" Margin="10">
                    <TextBlock Text="Dosya Yolu (SQLite)" Margin="0,0,0,5" FontSize="12" Foreground="Gray"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtDbPath" mah:TextBoxHelper.Watermark="Seçiniz..." mah:TextBoxHelper.ClearTextButton="True"/>
                        <Button Grid.Column="1" Click="BtnBrowseDb_Click" Style="{StaticResource MahApps.Styles.Button.Chromeless}" Margin="2,0">
                            <iconPacks:PackIconMaterial Kind="FolderOpen" Width="14" Height="14"/>
                        </Button>
                    </Grid>
                    <Button x:Name="BtnConnect" Click="BtnConnect_Click" Style="{StaticResource OutlineButtonStyle}" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Database" Width="14" Height="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Bağlan"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <GroupBox Grid.Row="2" Header="Tablolar" Margin="10" mah:HeaderedControlHelper.HeaderFontSize="12">
                    <ListBox x:Name="LstTables" BorderThickness="0" Background="Transparent" SelectionChanged="LstTables_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <iconPacks:PackIconMaterial Kind="Table" Width="14" Height="14" Foreground="#2196F3" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

        <!-- Main Workspace -->
        <Grid Grid.Column="2" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Click="BtnRunQuery_Click" Style="{StaticResource AccentButtonStyle}" Width="110" Height="34">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Play" Width="14" Height="14" Margin="0,0,8,0"/>
                        <TextBlock Text="ÇALIŞTIR" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,0"/>

                <Button Click="BtnFormatSql_Click" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,5,0" ToolTip="SQL Formatla (Güzelleştir)">
                    <iconPacks:PackIconMaterial Kind="FormatAlignLeft" Width="16" Height="16"/>
                </Button>

                <Button Click="BtnCopySql_Click" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,5,0" ToolTip="SQL Kopyala">
                    <iconPacks:PackIconMaterial Kind="ContentCopy" Width="16" Height="16"/>
                </Button>

                <Button Click="BtnClearSql_Click" Style="{StaticResource OutlineButtonStyle}" ToolTip="Temizle">
                    <iconPacks:PackIconMaterial Kind="Eraser" Width="16" Height="16"/>
                </Button>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,0"/>

                <Button Click="BtnExportCsv_Click" Style="{StaticResource OutlineButtonStyle}" ToolTip="CSV Olarak Dışa Aktar">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="FileExport" Width="14" Height="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Dışa Aktar"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Query Editor (AvalonEdit) -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4">
                <avalonEdit:TextEditor x:Name="SqlEditor" 
                                       FontFamily="Consolas" 
                                       FontSize="14" 
                                       ShowLineNumbers="True"
                                       SyntaxHighlighting="SQL"
                                       Background="#FBFCFD"/>
            </Border>

            <!-- Splitter Handle -->
            <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#F0F0F0" Margin="0,5"/>

            <!-- Results Section -->
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="#F8F9FA" Padding="10,5" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Sonuçlar" FontWeight="Bold" Margin="0,0,20,0"/>
                        <TextBlock x:Name="TxtStatus" Foreground="Gray" VerticalAlignment="Center" Text="Sorgu çalıştırılmadı."/>
                    </StackPanel>
                </Border>

                <DataGrid x:Name="DgResults" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="True">
                </DataGrid>
                
                <Grid x:Name="LoadingOverlay" Grid.Row="1" Background="#80FFFFFF" Visibility="Collapsed">
                    <mah:ProgressRing IsActive="True"/>
                </Grid>
            </Grid>

            <!-- Error / Status Message Bar -->
            <Border Grid.Row="4" x:Name="ErrorBar" Background="#FFF5F5" BorderBrush="#FFDADA" BorderThickness="1" CornerRadius="4" Margin="0,10,0,0" Padding="10" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="AlertCircle" Width="16" Height="16" Foreground="#E53935" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TxtError" Foreground="#D32F2F" TextWrapping="Wrap" MaxWidth="800"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
