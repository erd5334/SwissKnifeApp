<Window x:Class="SwissKnifeApp.Views.Modules.PasswordEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Parola Girişi" Height="700" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource HeaderText}"
        WindowStyle="None"
        AllowsTransparency="True">
    
    <Border BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Background="{DynamicResource AppBackground}" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Modern Header -->
            <Border Grid.Row="0" Padding="25,20" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                <Grid>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="KeyPlus" Width="24" Height="24" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock x:Name="TxtDialogTitle" Text="Yeni Kayıt" FontSize="20" FontWeight="Bold" Margin="15,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource HeaderText}"/>
                        </StackPanel>
                        <TextBlock Text="Kasa girişini düzenleyin veya yeni bir tane oluşturun." FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="39,5,0,0"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource MahApps.Styles.Button.Chromeless}" Click="BtnCancel_Click">
                        <iconPacks:PackIconMaterial Kind="Close" Width="18" Height="18" Foreground="{DynamicResource SecondaryText}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="25,20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <TextBlock Text="Başlık" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,8" FontSize="11"/>
                            <TextBox x:Name="TxtEntryTitle" Style="{StaticResource RoundedTextBox}" mah:TextBoxHelper.Watermark="Örn: Gmail, Banka..." Height="40"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Kategori" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,8" FontSize="11"/>
                            <ComboBox x:Name="CmbCategory" DisplayMemberPath="Name" Height="40" 
                                      Foreground="{DynamicResource HeaderText}"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="ChkIsNote" Content="Bu bir Güvenli Not (Parolayı gizle)" Margin="0,20,0,0" 
                              Foreground="{DynamicResource HeaderText}" 
                              Checked="ChkIsNote_Changed" Unchecked="ChkIsNote_Changed"/>

                    <Separator Margin="0,20" Background="{DynamicResource CardBorderBrush}"/>

                    <StackPanel x:Name="PasswordSection">
                        <TextBlock Text="Kullanıcı Adı / E-posta" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,8" FontSize="11"/>
                        <TextBox x:Name="TxtUsername" Style="{StaticResource RoundedTextBox}" Height="40" Margin="0,0,0,15"/>

                        <TextBlock Text="Parola" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,8" FontSize="11"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="TxtPassword" Height="40" mah:TextBoxHelper.Watermark="••••••••" VerticalContentAlignment="Center" BorderThickness="1,1,0,1" Padding="10,0"/>
                            <TextBox x:Name="TxtPasswordVisible" Height="40" VerticalContentAlignment="Center" Visibility="Collapsed" Style="{StaticResource RoundedTextBox}" BorderThickness="1,1,0,1"/>
                            
                            <Border Grid.Column="1" BorderThickness="0,1,0,1" BorderBrush="{DynamicResource CardBorderBrush}" Background="{DynamicResource CardBackground}">
                                <Button Click="BtnShowHide_Click" Style="{StaticResource MahApps.Styles.Button.Chromeless}" Width="40" Height="38">
                                    <iconPacks:PackIconMaterial x:Name="IconEye" Kind="Eye" Width="16" Height="16" Foreground="{DynamicResource SecondaryText}"/>
                                </Button>
                            </Border>
                            
                            <Border Grid.Column="2" BorderThickness="0,1,1,1" BorderBrush="{DynamicResource CardBorderBrush}" Background="{DynamicResource CardBackground}" CornerRadius="0,8,8,0">
                                <Button Click="BtnGenerate_Click" Style="{StaticResource MahApps.Styles.Button.Chromeless}" Width="40" Height="38">
                                    <iconPacks:PackIconMaterial Kind="Refresh" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}"/>
                                </Button>
                            </Border>
                        </Grid>

                        <TextBlock Text="Web Sitesi (URL)" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,8" FontSize="11"/>
                        <TextBox x:Name="TxtUrl" Style="{StaticResource RoundedTextBox}" Height="40" mah:TextBoxHelper.Watermark="https://example.com" Margin="0,0,0,15"/>

                        <TextBlock Text="TOTP Secret (2FA)" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,8" FontSize="11"/>
                        <TextBox x:Name="TxtTotp" Style="{StaticResource RoundedTextBox}" Height="40" mah:TextBoxHelper.Watermark="Base32 formatında anahtar"/>
                    </StackPanel>

                    <TextBlock Text="Notlar" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" Margin="0,20,0,8" FontSize="11"/>
                    <TextBox x:Name="TxtNotes" Height="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Style="{StaticResource RoundedTextBox}" Padding="10"/>

                    <TextBlock Text="Son Kullanma Tarihi" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" Margin="0,20,0,8" FontSize="11"/>
                    <DatePicker x:Name="DpExpiry" Height="40" mah:TextBoxHelper.Watermark="Tarih seçin..."/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer Actions -->
            <Border Grid.Row="2" Padding="25,20" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="1" Click="BtnCancel_Click" Style="{StaticResource OutlineButtonStyle}" Content="İptal" Width="100" Height="40" Margin="0,0,12,0"/>
                    <Button Grid.Column="2" Click="BtnSave_Click" Style="{StaticResource AccentButtonStyle}" Content="Kaydet" Width="120" Height="40">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ContentSave" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Kaydet" VerticalAlignment="Center" FontWeight="Bold"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
