<Window x:Class="SwissKnifeApp.Views.Modules.PasswordEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Parola Girişi" Height="650" Width="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
        Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}">
    <Border Style="{StaticResource Card}" Margin="0" BorderThickness="0">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock x:Name="TxtDialogTitle" Text="Yeni Kayıt" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="Kasa girişinii düzenleyin veya yeni bir tane oluşturun." FontSize="12" Foreground="Gray"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Başlık" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtEntryTitle" Style="{StaticResource RoundedTextBox}" mah:TextBoxHelper.Watermark="Örn: Gmail, Banka..."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Kategori" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ComboBox x:Name="CmbCategory" DisplayMemberPath="Name"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="ChkIsNote" Content="Bu bir Güvenli Not (Parolayı gizle)" Margin="0,15,0,0" Checked="ChkIsNote_Changed" Unchecked="ChkIsNote_Changed"/>

                    <Border BorderThickness="0,1,0,0" BorderBrush="#EEE" Margin="0,15"/>

                    <StackPanel x:Name="PasswordSection">
                        <TextBlock Text="Kullanıcı Adı / E-posta" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtUsername" Style="{StaticResource RoundedTextBox}"/>

                        <TextBlock Text="Parola" FontWeight="SemiBold" Margin="0,15,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="TxtPassword" Height="35" VerticalContentAlignment="Center"/>
                            <TextBox x:Name="TxtPasswordVisible" Height="35" VerticalContentAlignment="Center" Visibility="Collapsed" Style="{StaticResource RoundedTextBox}"/>
                            <Button Grid.Column="1" Click="BtnShowHide_Click" Style="{StaticResource MahApps.Styles.Button.Chromeless}" Margin="5,0">
                                <iconPacks:PackIconMaterial x:Name="IconEye" Kind="Eye" Width="16" Height="16"/>
                            </Button>
                            <Button Grid.Column="2" Click="BtnGenerate_Click" Style="{StaticResource OutlineButtonStyle}" Padding="10,0">
                                <iconPacks:PackIconMaterial Kind="Refresh" Width="14" Height="14"/>
                            </Button>
                        </Grid>

                        <TextBlock Text="Web Sitesi (URL)" FontWeight="SemiBold" Margin="0,15,0,5"/>
                        <TextBox x:Name="TxtUrl" Style="{StaticResource RoundedTextBox}"/>

                        <TextBlock Text="TOTP Secret (2FA)" FontWeight="SemiBold" Margin="0,15,0,5"/>
                        <TextBox x:Name="TxtTotp" Style="{StaticResource RoundedTextBox}" mah:TextBoxHelper.Watermark="Base32 formatında anahtar"/>
                    </StackPanel>

                    <TextBlock Text="Notlar" FontWeight="SemiBold" Margin="0,15,0,5"/>
                    <TextBox x:Name="TxtNotes" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Text="Son Kullanma Tarihi" FontWeight="SemiBold" Margin="0,15,0,5"/>
                    <DatePicker x:Name="DpExpiry"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Click="BtnCancel_Click" Style="{StaticResource OutlineButtonStyle}" Content="İptal" Width="80" Margin="0,0,10,0"/>
                <Button Click="BtnSave_Click" Style="{StaticResource AccentButtonStyle}" Content="Kaydet" Width="100"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
