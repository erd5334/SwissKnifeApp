<Page x:Class="SwissKnifeApp.Views.Modules.DuplicateFileFinderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:vm="clr-namespace:SwissKnifeApp.ViewModels"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:h="clr-namespace:SwissKnifeApp.Helpers"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Background="{DynamicResource AppBackground}">

    <Page.Resources>
        <h:BoolNegationConverter x:Key="BoolNegationConverter"/>
    </Page.Resources>

    <Page.DataContext>
        <vm:DuplicateFileFinderViewModel/>
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel MaxWidth="1400">
            <!-- Header -->
            <TextBlock Text="🔍 Yinelenen Dosya Bulucu" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource HeaderText}"
                       Margin="0,0,0,10"/>
            <TextBlock Text="Hash-based duplicate detection, toplu silme ve disk alanı kazancı" 
                       FontSize="14" 
                       Foreground="{DynamicResource SecondaryText}"
                       Margin="0,0,0,30"/>

            <!-- Settings Card -->
            <Border Background="{DynamicResource CardBackground}" 
                    BorderBrush="{DynamicResource CardBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="20" 
                    Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <iconPacks:PackIconMaterial Kind="FolderSearch" 
                                                    Width="24" Height="24" 
                                                    Foreground="{DynamicResource AccentBrush}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,10,0"/>
                        <TextBlock Text="Tarama Ayarları" 
                                   FontSize="20" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource HeaderText}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Folder Selection -->
                    <TextBlock Text="Klasör:" 
                               FontSize="13" 
                               Foreground="{DynamicResource AppForeground}"
                               Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" 
                                 Text="{Binding SearchPath, UpdateSourceTrigger=PropertyChanged}" 
                                 IsReadOnly="True"
                                 FontSize="13"
                                 Padding="10"
                                 Background="{DynamicResource InputBackground}"
                                 Foreground="{DynamicResource InputForeground}"
                                 BorderBrush="{DynamicResource InputBorderBrush}"
                                 Margin="0,0,10,0"/>

                        <Button Grid.Column="1" 
                                Content="📁 Gözat" 
                                Command="{Binding BrowseFolderCommand}"
                                FontSize="13"
                                Padding="15,10"
                                Background="{DynamicResource ButtonBackground}"
                                Foreground="{DynamicResource ButtonForeground}"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </Grid>

                    <!-- Options -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Hash Algoritması:" 
                                       FontSize="13" 
                                       Foreground="{DynamicResource AppForeground}"
                                       Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding HashAlgorithms}" 
                                      SelectedItem="{Binding SelectedHashAlgorithm}"
                                      Padding="10"
                                      Background="{DynamicResource InputBackground}"
                                      Foreground="{DynamicResource AppForeground}"
                                      BorderBrush="{DynamicResource InputBorderBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Dosya Filtresi:" 
                                       FontSize="13" 
                                       Foreground="{DynamicResource AppForeground}"
                                       Margin="0,0,0,5"/>
                            <TextBox Text="{Binding FilePattern, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="10"
                                     Background="{DynamicResource InputBackground}"
                                     Foreground="{DynamicResource InputForeground}"
                                     BorderBrush="{DynamicResource InputBorderBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <CheckBox Content="Alt klasörleri dahil et" 
                                      IsChecked="{Binding IncludeSubfolders}"
                                      Foreground="{DynamicResource AppForeground}"
                                      Margin="0,0,0,5"/>
                            <CheckBox Content="Boyut + İsim karşılaştırma" 
                                      IsChecked="{Binding UseSizeComparison}"
                                      Foreground="{DynamicResource AppForeground}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Scan Button -->
                    <Button Content="🔍 Taramayı Başlat" 
                            Command="{Binding ScanForDuplicatesCommand}"
                            IsEnabled="{Binding IsScanning, Converter={StaticResource BoolNegationConverter}}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Padding="0,12"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"/>

                    <!-- Status -->
                    <Border Background="{DynamicResource InputBackground}"
                            BorderBrush="{DynamicResource InputBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10"
                            Margin="0,15,0,0">
                        <TextBlock Text="{Binding StatusMessage}" 
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryText}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Stats Card -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" 
                        Background="{DynamicResource CardBackground}" 
                        BorderBrush="{DynamicResource CardBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="15"
                        Margin="0,0,10,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <iconPacks:PackIconMaterial Kind="FileDocument" 
                                                        Width="20" Height="20" 
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        Margin="0,0,8,0"/>
                            <TextBlock Text="Taranan Dosya" 
                                       FontSize="13" 
                                       Foreground="{DynamicResource SecondaryText}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ScannedFiles}" 
                                   FontSize="28" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource HeaderText}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" 
                        Background="{DynamicResource CardBackground}" 
                        BorderBrush="{DynamicResource CardBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="15"
                        Margin="0,0,10,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <iconPacks:PackIconMaterial Kind="ContentDuplicate" 
                                                        Width="20" Height="20" 
                                                        Foreground="#FF9800"
                                                        Margin="0,0,8,0"/>
                            <TextBlock Text="Yinelenen Grup" 
                                       FontSize="13" 
                                       Foreground="{DynamicResource SecondaryText}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DuplicateGroups}" 
                                   FontSize="28" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource HeaderText}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" 
                        Background="{DynamicResource CardBackground}" 
                        BorderBrush="{DynamicResource CardBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <iconPacks:PackIconMaterial Kind="HarddiskRemove" 
                                                        Width="20" Height="20" 
                                                        Foreground="#4CAF50"
                                                        Margin="0,0,8,0"/>
                            <TextBlock Text="Alan Kazancı" 
                                       FontSize="13" 
                                       Foreground="{DynamicResource SecondaryText}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalWastedSpaceFormatted}" 
                                   FontSize="28" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource HeaderText}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Results -->
            <Border Background="{DynamicResource CardBackground}" 
                    BorderBrush="{DynamicResource CardBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="20" 
                    Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FileFind" 
                                                        Width="24" Height="24" 
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,10,0"/>
                            <TextBlock Text="Yinelenen Dosyalar" 
                                       FontSize="20" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource HeaderText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="🗑️ Seçilenleri Sil" 
                                    Command="{Binding DeleteSelectedCommand}"
                                    FontSize="13"
                                    Padding="15,8"
                                    Background="#F44336"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="0,0,10,0"/>
                            <Button Content="🧹 Temizle" 
                                    Command="{Binding ClearResultsCommand}"
                                    FontSize="13"
                                    Padding="15,8"
                                    Background="{DynamicResource InputBorderBrush}"
                                    Foreground="{DynamicResource AppForeground}"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Height="400" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DuplicateGroupsList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource InputBackground}"
                                            BorderBrush="{DynamicResource InputBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="15"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <!-- Group Header -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock FontSize="14" 
                                                               FontWeight="SemiBold" 
                                                               Foreground="{DynamicResource HeaderText}">
                                                        <Run Text="📄"/>
                                                        <Run Text="{Binding RepresentativeFile}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="12" 
                                                               Foreground="{DynamicResource SecondaryText}"
                                                               Margin="0,5,0,0">
                                                        <Run Text="{Binding Count}"/>
                                                        <Run Text="kopya •"/>
                                                        <Run Text="{Binding FileSizeFormatted}"/>
                                                        <Run Text="her biri •"/>
                                                        <Run Text="{Binding TotalWastedSpaceFormatted}"/>
                                                        <Run Text="israf"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" 
                                                           FontSize="18" 
                                                           FontWeight="Bold" 
                                                           Foreground="#FF9800"
                                                           VerticalAlignment="Center">
                                                    <Run Text="{Binding Count}"/>
                                                    <Run Text="×" FontSize="14"/>
                                                </TextBlock>
                                            </Grid>

                                            <!-- Files List -->
                                            <ItemsControl ItemsSource="{Binding Files}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource CardBackground}"
                                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="2"
                                                                Padding="8"
                                                                Margin="0,5">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <CheckBox Grid.Column="0" 
                                                                          IsChecked="{Binding IsSelected}"
                                                                          VerticalAlignment="Center"
                                                                          Margin="0,0,10,0"/>

                                                                <TextBlock Grid.Column="1" 
                                                                           Text="{Binding FilePath}" 
                                                                           FontFamily="Consolas"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource AppForeground}"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center"/>

                                                                <TextBlock Grid.Column="2" 
                                                                           Text="{Binding FileSizeFormatted}" 
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource SecondaryText}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="10,0,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Info -->
            <Border Background="{DynamicResource CardBackground}" 
                    BorderBrush="{DynamicResource CardBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="15">
                <TextBlock FontSize="12" 
                           Foreground="{DynamicResource SecondaryText}"
                           TextWrapping="Wrap">
                    <Run Text="💡" FontSize="14"/>
                    <Run Text=" İpuçları:" FontWeight="SemiBold"/>
                    <LineBreak/>
                    <Run Text="• MD5: Hızlı ama az güvenli • SHA256: Yavaş ama çok güvenli • SHA1: Orta seviye"/>
                    <LineBreak/>
                    <Run Text="• Boyut + İsim: Çok hızlı ama yanlış pozitif olabilir"/>
                    <LineBreak/>
                    <Run Text="• Her gruptan en az 1 dosya bırakın, hepsini silmeyin!"/>
                    <LineBreak/>
                    <Run Text="• Silme işlemi geri alınamaz, dikkatli olun"/>
                </TextBlock>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
