<Page x:Class="SwissKnifeApp.Views.Modules.YouTubeClipDownloaderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d" 
      d:DesignHeight="850" d:DesignWidth="1100"
      Title="Gelişmiş YouTube İndirici"
      Background="{DynamicResource AppBackground}">

    <Page.Resources>
        <!-- YouTube specific accent colors (Red/YouTube Red) -->
        <SolidColorBrush x:Key="YouTubeAccent" Color="#F44336"/>
        <!-- Local override for consistent YouTube theme -->
        <SolidColorBrush x:Key="AccentBrush" Color="{Binding Source={StaticResource YouTubeAccent}, Path=Color}"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Modern Header -->
        <Border Grid.Row="0" Padding="25,20" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Youtube" Width="30" Height="30" VerticalAlignment="Center" Foreground="{StaticResource YouTubeAccent}"/>
                    <TextBlock Text="Gelişmiş YouTube İndirici" FontSize="24" FontWeight="Bold" Margin="15,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource HeaderText}"/>
                </StackPanel>
                <TextBlock Text="Video, oynatma listesi, kanal ve özel kesit indirme merkezi" FontSize="14" Foreground="{DynamicResource SecondaryText}" Margin="45,5,0,0"/>
            </StackPanel>
        </Border>

        <mah:MetroAnimatedSingleRowTabControl Grid.Row="1" mah:HeaderedControlHelper.HeaderFontSize="14" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource MahApps.Styles.TabItem}">
                    <Setter Property="Padding" Value="25,12"/>
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                </Style>
            </TabControl.Resources>

            <!-- 1. HIZLI İNDİRME -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Download" Width="18" Height="18" Margin="0,0,10,0"/>
                        <TextBlock Text="Video &amp; Liste İndir"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="25" MaxWidth="1000" HorizontalAlignment="Left" Width="950">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Bağlantı Bilgileri" Style="{StaticResource SectionHeader}" Margin="0,0,0,15"/>
                                <TextBox x:Name="TxtGeneralUrl" 
                                         Style="{StaticResource RoundedTextBox}" 
                                         mah:TextBoxHelper.Watermark="Video, Playlist veya Kanal URL'si yapıştırın..." 
                                         Height="45" FontSize="15" 
                                         mah:TextBoxHelper.ClearTextButton="True"/>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="25"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="İndirme Ayarları" Style="{StaticResource SectionHeader}" Margin="0,0,0,15"/>
                                    
                                    <TextBlock Text="Kalite Seçimi" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbQuality" Height="38" Margin="0,0,0,15">
                                        <ComboBoxItem Content="En İyi (Varsayılan)" IsSelected="True"/>
                                        <ComboBoxItem Content="1080p Full HD"/>
                                        <ComboBoxItem Content="720p HD"/>
                                        <ComboBoxItem Content="480p SD"/>
                                        <ComboBoxItem Content="Sadece Ses"/>
                                    </ComboBox>
                                    
                                    <TextBlock Text="Format" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbGeneralFormat" Height="38">
                                        <ComboBoxItem Content="MP4 (Video)" IsSelected="True"/>
                                        <ComboBoxItem Content="MP3 (Müzik)"/>
                                        <ComboBoxItem Content="M4A"/>
                                        <ComboBoxItem Content="wav"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                                <StackPanel>
                                <TextBlock Text="Ek Seçenekler" Style="{StaticResource SectionHeader}" Margin="0,0,0,15"/>
                                    <CheckBox x:Name="ChkDownloadSubs" Content="Altyazıları İndir" Margin="0,0,0,12" FontSize="13"/>
                                    <CheckBox x:Name="ChkDownloadThumb" Content="Kapak Fotoğrafını (Thumbnail) Kaydet" Margin="0,0,0,12" FontSize="13"/>
                                    <CheckBox x:Name="ChkExportMetadata" Content="Video Bilgilerini Dışa Aktar (JSON)" FontSize="13"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Button x:Name="BtnStartGeneral" 
                                Style="{StaticResource AccentButtonStyle}" 
                                Click="BtnStartGeneral_Click" 
                                Height="50" Margin="0,25,0,0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="CloudDownload" Width="22" Height="22" Margin="0,0,12,0"/>
                                <TextBlock Text="İNDİRMEYİ BAŞLAT" FontWeight="Bold" FontSize="15"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2. KESİT İNDİRME -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ContentCut" Width="18" Height="18" Margin="0,0,10,0"/>
                        <TextBlock Text="Kesit (Klip) İndir"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="25" MaxWidth="1000" HorizontalAlignment="Left" Width="950">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Video Bağlantısı" Style="{StaticResource SectionHeader}" Margin="0,0,0,15"/>
                                <TextBox x:Name="TxtUrl" 
                                         Style="{StaticResource RoundedTextBox}" 
                                         mah:TextBoxHelper.Watermark="https://www.youtube.com/watch?v=..." 
                                         Height="45" FontSize="15"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Kesit Zamanları" Style="{StaticResource SectionHeader}" Margin="0,0,0,15"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <RadioButton x:Name="RbTxt" Content="Dosyadan (TXT)" IsChecked="True" Margin="0,0,25,0"/>
                                    <RadioButton x:Name="RbManual" Content="Manuel Giriş"/>
                                </StackPanel>

                                <!-- TXT Pane -->
                                <Grid x:Name="PanelTxt">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtTxtPath" Style="{StaticResource RoundedTextBox}" mah:TextBoxHelper.Watermark="Interval dosyası seçin..." Height="40"/>
                                    <Button Grid.Column="1" Style="{StaticResource OutlineButtonStyle}" Click="BtnPickTxt_Click" Margin="10,0,0,0" Width="100" Height="40">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="FileSearch" Width="16" Height="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="Seç"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Manual Pane -->
                                <StackPanel x:Name="PanelManual" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Başlangıç (mm:ss)" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,5"/>
                                            <TextBox x:Name="TxtStart" Style="{StaticResource RoundedTextBox}" Height="40"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Bitiş (mm:ss)" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,5"/>
                                            <TextBox x:Name="TxtEnd" Style="{StaticResource RoundedTextBox}" Height="40"/>
                                        </StackPanel>
                                        <Button Grid.Column="4" Style="{StaticResource AccentButtonStyle}" Click="BtnAddInterval_Click" VerticalAlignment="Bottom" Width="120" Height="40">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial Kind="Plus" Width="16" Height="16" Margin="0,0,8,0"/>
                                                <TextBlock Text="LİSTEYE EKLE"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    
                                    <Grid Margin="0,20,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Başlangıç Noktaları" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,8"/>
                                            <ListBox x:Name="LbStarts" Height="120" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Bitiş Noktaları" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,8"/>
                                            <ListBox x:Name="LbEnds" Height="120" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"/>
                                        </StackPanel>
                                    </Grid>
                                    
                                    <Button Style="{StaticResource OutlineButtonStyle}" Click="BtnRemoveInterval_Click" Margin="0,15,0,0" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Delete" Width="16" Height="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="Sıradakini Sil"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnStartClips" Style="{StaticResource AccentButtonStyle}" 
                                Click="BtnStart_Click" Height="50" Margin="0,25,0,0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ContentCut" Width="22" Height="22" Margin="0,0,10,0"/>
                                <TextBlock Text="KESİTLERİ İNDİRMEYE BAŞLA" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 3. GENEL AYARLAR -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="CogOutline" Width="18" Height="18" Margin="0,0,10,0"/>
                        <TextBlock Text="Sistem Ayarları"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="25" MaxWidth="1000" HorizontalAlignment="Left" Width="950">
                        <Border Style="{StaticResource Card}" Padding="25">
                            <StackPanel>
                                <TextBlock Text="Dosya ve Klasör Ayarları" Style="{StaticResource SectionHeader}" Margin="0,0,0,15"/>
                                
                                <TextBlock Text="İndirme Klasörü" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,5"/>
                                <Grid Margin="0,0,0,25">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtOutput" Style="{StaticResource RoundedTextBox}" Height="40"/>
                                    <Button Grid.Column="1" Style="{StaticResource OutlineButtonStyle}" Click="BtnPickFolder_Click" Margin="10,0,0,0" Width="100" Height="40">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="FolderOpen" Width="16" Height="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="Gözat"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <TextBlock Text="Cookie Yönetimi (Kısıtlı Videolar İçin)" Style="{StaticResource SectionHeader}" Margin="0,0,0,15"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <RadioButton x:Name="RbCookieBrowser" Content="Tarayıcıdan Al" IsChecked="True" Margin="0,0,30,0"/>
                                    <RadioButton x:Name="RbCookieFile" Content="Dosyadan Oku"/>
                                </StackPanel>
                                
                                <Grid>
                                    <!-- Tarayıcı Seçimi -->
                                    <StackPanel x:Name="PanelCookieBrowser">
                                        <ComboBox x:Name="CmbBrowser" Height="40" SelectedIndex="0">
                                            <ComboBoxItem Content="(Cookie Kullanma)"/>
                                            <ComboBoxItem Content="Chrome"/>
                                            <ComboBoxItem Content="Firefox"/>
                                            <ComboBoxItem Content="Edge"/>
                                            <ComboBoxItem Content="Brave"/>
                                            <ComboBoxItem Content="Opera"/>
                                        </ComboBox>
                                        <StackPanel Orientation="Horizontal" Margin="5,8,0,0">
                                            <iconPacks:PackIconMaterial Kind="AlertCircleOutline" Width="14" Height="14" Foreground="#FFC107" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Not: İşlem sırasında tarayıcının kapalı olması önerilir." FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <!-- Dosya Seçimi -->
                                    <Grid x:Name="PanelCookieFile" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtCookie" Style="{StaticResource RoundedTextBox}" Height="40" mah:TextBoxHelper.Watermark="cookies.txt dosyasını seçin..."/>
                                        <Button Grid.Column="1" Style="{StaticResource OutlineButtonStyle}" Click="BtnPickCookie_Click" Margin="10,0,0,0" Width="100" Height="40">
                                            <TextBlock Text="Dosya Seç"/>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,20,0,0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,1,1,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Bağımlılık Yönetimi" FontWeight="Bold" FontSize="15" Margin="0,0,0,5" Foreground="{DynamicResource HeaderText}"/>
                                    <TextBlock Text="yt-dlp ve FFmpeg kütüphanelerini en son sürümlere güncelleyin" FontSize="12" Foreground="{DynamicResource SecondaryText}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Click="BtnInstallTools_Click" Style="{StaticResource OutlineButtonStyle}" Padding="20,10">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Update" Width="18" Height="18" Margin="0,0,10,0"/>
                                        <TextBlock Text="ARAÇLARI GÜNCELLE" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </mah:MetroAnimatedSingleRowTabControl>

        <!-- Status & Progress Footer -->
        <Border Grid.Row="1" VerticalAlignment="Bottom" Margin="25" Padding="25" Style="{StaticResource Card}" Background="{DynamicResource AppBackground}" BorderBrush="{StaticResource YouTubeAccent}" BorderThickness="0,2,0,0" Effect="{DynamicResource MahApps.DropShadow.None}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ProgressDownload" Width="18" Height="18" Foreground="{StaticResource YouTubeAccent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Mevcut Durum:" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtProgressStatus" Text="Sistem Hazır" Margin="10,0,0,0" FontWeight="Bold" Foreground="{DynamicResource HeaderText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Button x:Name="BtnCancel" Style="{StaticResource OutlineButtonStyle}" IsEnabled="False" Click="BtnCancel_Click" Width="120" HorizontalAlignment="Right" Height="34">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="StopCircleOutline" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="DURDUR" FontWeight="Bold" FontSize="11"/>
                        </StackPanel>
                    </Button>
                </Grid>
                
                <mah:MetroProgressBar x:Name="PbTotal" Grid.Row="1" Height="8" Margin="0,0,0,15" Minimum="0" Maximum="100"/>
                
                <Border Grid.Row="2" Background="{DynamicResource CardBackground}" CornerRadius="8" Padding="10">
                    <TextBox x:Name="TxtLog" 
                             IsReadOnly="True" 
                             AcceptsReturn="True" 
                             VerticalScrollBarVisibility="Auto" 
                             FontFamily="Consolas" 
                             FontSize="12" 
                             Height="120"
                             Background="Transparent" 
                             BorderThickness="0"
                             Foreground="{DynamicResource HeaderText}"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
