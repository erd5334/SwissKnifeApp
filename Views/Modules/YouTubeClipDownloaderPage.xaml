<Page x:Class="SwissKnifeApp.Views.Modules.YouTubeClipDownloaderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="YouTube TXT Clip Downloader">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Margin="0,0,0,12" >
            <TextBlock Text="YouTube URL" FontWeight="Bold"/>
            <TextBox x:Name="TxtUrl" Height="28"/>
        </StackPanel>

        <StackPanel Orientation="Vertical" Margin="0,0,0,12" Grid.Row="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" >
                <TextBlock Text="Aralık Girişi" FontWeight="Bold"/>
                <RadioButton x:Name="RbTxt" Content="TXT" IsChecked="True" Margin="16,0,0,0"/>
                <RadioButton x:Name="RbManual" Content="Manuel" Margin="8,0,0,0"/>
            </StackPanel>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- TXT Mode -->
                <DockPanel x:Name="PanelTxt" Grid.ColumnSpan="2">
                    <TextBox x:Name="TxtTxtPath" Height="28"/>
                    <Button Content="Seç" Margin="8,0,0,0" Padding="12,4" Click="BtnPickTxt_Click"/>
                </DockPanel>
                <!-- Manual Mode -->
                <StackPanel x:Name="PanelManual" Grid.ColumnSpan="2" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="TxtStart" Width="100" Height="28" />
                        <TextBox x:Name="TxtEnd" Width="100" Height="28" Margin="8,0,0,0" />
                        <Button Content="Ekle" Margin="8,0,0,0" Padding="12,4" Click="BtnAddInterval_Click"/>
                        <Button Content="Sil" Margin="8,0,0,0" Padding="12,4" Click="BtnRemoveInterval_Click"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Başlangıçlar" FontWeight="Bold"/>
                            <ListBox x:Name="LbStarts" Height="120"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Bitişler" FontWeight="Bold"/>
                            <ListBox x:Name="LbEnds" Height="120"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel Orientation="Vertical" Margin="0,0,0,12" Grid.Row="2">
            <TextBlock Text="Çıkış Klasörü" FontWeight="Bold"/>
            <DockPanel>
                <TextBox x:Name="TxtOutput" Height="28"/>
                <Button Content="Seç" Margin="8,0,0,0" Padding="12,4" Click="BtnPickFolder_Click"/>
            </DockPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12" Grid.Row="3">
            <Button x:Name="BtnStart" Content="İndirmeyi Başlat" Padding="16,6" Click="BtnStart_Click"/>
            <Button x:Name="BtnCancel" Content="Durdur" Margin="8,0,0,0" Padding="16,6" Click="BtnCancel_Click" IsEnabled="False"/>
            <Button x:Name="BtnInstallTools" Content="Araçları Kur" Margin="16,0,0,0" Padding="16,6" Click="BtnInstallTools_Click" Background="#FFA500" Foreground="White"/>
        </StackPanel>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Toplam İlerleme" FontWeight="Bold"/>
            <ProgressBar x:Name="PbTotal" Grid.Row="0" Height="18" Margin="0,20,0,0" Minimum="0" Maximum="100"/>
            <TextBlock Text="Parça İlerleme" Grid.Row="1" FontWeight="Bold" Margin="0,8,0,0"/>
            <ProgressBar x:Name="PbPart" Grid.Row="1" Height="18" Margin="0,28,0,0" Minimum="0" Maximum="100"/>
            <TextBlock Text="Log" Grid.Row="2" FontWeight="Bold" Margin="0,8,0,0"/>
            <ScrollViewer Grid.Row="2" Margin="0,24,0,0">
                <TextBox x:Name="TxtLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
