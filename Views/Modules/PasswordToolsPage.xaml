<Page x:Class="SwissKnifeApp.Views.Modules.PasswordToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:helpers="clr-namespace:SwissKnifeApp.Helpers"
      mc:Ignorable="d"
      Background="{DynamicResource AppBackground}"
      Title="Güvenlik &amp; Şifre Yönetimi">

    <Page.Resources>
        <!-- Security themed accent (Purple) -->
        <SolidColorBrush x:Key="AccentBrush" Color="#7E57C2"/>
        <SolidColorBrush x:Key="AccentBrush2" Color="#5E35B1"/>
        
        <!-- Global CheckBox Style for this page to force visibility -->
        <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource MahApps.Styles.CheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource HeaderText}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Fix TabControl Header and Items for Dark Mode -->
        <Style x:Key="ModernTabControlStyle" TargetType="{x:Type mah:MetroAnimatedSingleRowTabControl}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="mah:TabControlHelper.UnderlineBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource HeaderText}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Modern Header (Only visible if unlocked, but we'll manage visibility logically) -->
        <Border Grid.Row="0" x:Name="HeaderBorder" Padding="25,20" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ShieldKey" Width="30" Height="30" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Güvenlik &amp; Şifre Yönetimi" FontSize="24" FontWeight="Bold" Margin="15,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource HeaderText}"/>
                    </StackPanel>
                    <TextBlock Text="Şifre oluşturun, güvenliğini analiz edin veya şifre kasanızı yönetin" FontSize="14" Foreground="{DynamicResource SecondaryText}" Margin="45,5,0,0"/>
                </StackPanel>
                
                <StackPanel x:Name="HeaderActions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                    <Button Click="BtnLockVault_Click" Style="{StaticResource OutlineButtonStyle}" Height="40" Padding="15,0" BorderBrush="#FFAB91">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Lock" Width="18" Height="18" Margin="0,0,10,0" Foreground="#D84315"/>
                            <TextBlock Text="Kasayı Kilitle" Foreground="#D84315" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace (Vault Unlocked) -->
        <Grid Grid.Row="1" x:Name="VaultContent" Visibility="Collapsed">
            <mah:MetroAnimatedSingleRowTabControl x:Name="MainTabControl" Margin="20" 
                                                  Style="{StaticResource ModernTabControlStyle}"
                                                  mah:HeaderedControlHelper.HeaderFontSize="14" 
                                                  mah:TabControlHelper.Underlined="SelectedTabItem">
                
                <!-- 1️⃣ Şifre Oluşturucu -->
                <TabItem Header="Şifre Oluşturucu">
                    <Grid MaxWidth="800" HorizontalAlignment="Left" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,0,20,0">
                            <StackPanel>
                                <TextBlock Text="Konfigürasyon" Style="{StaticResource SectionHeader}"/>
                                
                                <TextBlock Text="Şifre Uzunluğu" Foreground="{DynamicResource SecondaryText}" Margin="0,5,0,10" FontSize="12"/>
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="SliderLength" Minimum="6" Maximum="64" Value="16" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="{DynamicResource AppBackground}" CornerRadius="4" Padding="8,4" Margin="10,0,0,0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding ElementName=SliderLength, Path=Value, StringFormat={}{0:0}}" FontWeight="Bold" Width="30" TextAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <TextBlock Text="İçerik Ayarları" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,12" FontSize="12"/>
                                <UniformGrid Columns="2" Margin="0,0,0,15">
                                    <CheckBox x:Name="ChkUpper" Content="Büyük Harf (A-Z)" IsChecked="True" Margin="0,0,0,12" Foreground="{DynamicResource HeaderText}"/>
                                    <CheckBox x:Name="ChkLower" Content="Küçük Harf (a-z)" IsChecked="True" Margin="0,0,0,12" Foreground="{DynamicResource HeaderText}"/>
                                    <CheckBox x:Name="ChkNumbers" Content="Rakamlar (0-9)" IsChecked="True" Margin="0,0,0,12" Foreground="{DynamicResource HeaderText}"/>
                                    <CheckBox x:Name="ChkSymbols" Content="Semboller (!@#$...)" IsChecked="True" Margin="0,0,0,12" Foreground="{DynamicResource HeaderText}"/>
                                </UniformGrid>

                                <Button x:Name="BtnGenerate" Click="BtnGenerate_Click" Style="{StaticResource AccentButtonStyle}" Height="50" Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Refresh" Width="20" Height="20" Margin="0,0,12,0"/>
                                        <TextBlock Text="Şifreyi Yeniden Oluştur" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="Oluşturulan Şifre" Style="{StaticResource SectionHeader}"/>
                                    <TextBox x:Name="TxtGenerated" FontSize="20" FontWeight="Bold" TextAlignment="Center" IsReadOnly="True" 
                                             Style="{StaticResource RoundedTextBox}" Height="60" Margin="0,5,0,15" FontFamily="Consolas"
                                             Foreground="{StaticResource AccentBrush}"/>
                                    
                                    <Button Click="BtnCopyPassword_Click" Style="{StaticResource OutlineButtonStyle}" Height="45">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="ContentCopy" Width="18" Height="18" Margin="0,0,10,0"/>
                                            <TextBlock Text="Panoya Kopyala" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                            
                            <Border Margin="0,15,0,0" Padding="15" CornerRadius="12" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                <TextBlock Text="💡 Karmaşık şifreler brute-force saldırılarını imkansız hale getirir." FontSize="11" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" LineHeight="16"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- 2️⃣ Güvenlik Analizi -->
                <TabItem Header="Güvenlik Analizi">
                    <Grid MaxWidth="850" HorizontalAlignment="Left" Margin="0,20,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Şifre Gücü Ölçümü" Style="{StaticResource SectionHeader}"/>
                                <Grid Margin="0,10,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="TxtPasswordCheck" mah:TextBoxHelper.Watermark="Analiz edilecek parolayı girin..." Height="45" VerticalContentAlignment="Center" FontSize="16" FontFamily="Consolas" Padding="10,0"/>
                                    <Button Grid.Column="1" Click="BtnAnalyze_Click" Style="{StaticResource MahApps.Styles.Button.Chromeless}" Width="45" Height="45">
                                        <iconPacks:PackIconMaterial Kind="ShieldSearch" Width="20" Height="20" Foreground="{StaticResource AccentBrush}"/>
                                    </Button>
                                </Grid>
                                
                                <Grid Margin="0,0,0,10">
                                    <TextBlock x:Name="TxtStrengthLabel" FontWeight="Bold" FontSize="14" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Güvenlik Puanı" FontSize="12" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="ProgressStrength" Height="12" Minimum="0" Maximum="100" Margin="0,0,0,5" Style="{StaticResource MahApps.Styles.ProgressBar}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,0" BorderBrush="#FFEBEE">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <iconPacks:PackIconMaterial Kind="DatabaseAlert" Width="20" Height="20" Foreground="#E53935" VerticalAlignment="Center"/>
                                    <TextBlock Text="Have I Been Pwned (Sızıntı Kontrolü)" Style="{StaticResource SectionHeader}" Foreground="#E53935" Margin="12,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="Parolanızın daha önce bilinen bir veri sızıntısında (breach) yer alıp almadığını kontrol edin. İşlem sadece parolanın SHA-1 hash değerinin ilk 5 karakteri ile güvenli şekilde yapılır." 
                                           FontSize="13" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,20" LineHeight="20"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Click="BtnCheckBreach_Click" Style="{StaticResource AccentButtonStyle}" Background="#E53935" Height="45" Padding="30,0">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="DatabaseSearch" Width="18" Height="18" Margin="0,0,10,0"/>
                                            <TextBlock Text="Sızıntı Kontrolünü Başlat" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                    <Border Grid.Column="1" Margin="20,0,0,0" Padding="15,0" Background="{DynamicResource AppBackground}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                        <TextBlock x:Name="TxtBreachResult" VerticalAlignment="Center" FontWeight="SemiBold" Text="Sonuç bekleniyor..." Foreground="{DynamicResource SecondaryText}"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- 3️⃣ Şifre Kasası (Vault) -->
                <TabItem Header="Şifre Kasası">
                    <Grid Margin="0,15,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Tool Bar -->
                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,15" Padding="15,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBox x:Name="TxtSearch" Style="{StaticResource RoundedTextBox}" Height="40"
                                         mah:TextBoxHelper.Watermark="Başlık veya kullanıcı adı ile ara..." 
                                         TextChanged="TxtSearch_TextChanged" Margin="0,0,15,0">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>

                                <ComboBox x:Name="CmbCategoryFilter" Grid.Column="1" Height="40"
                                          DisplayMemberPath="Name" SelectedValuePath="Id"
                                          mah:TextBoxHelper.Watermark="Kategori Filtrele"
                                          SelectionChanged="CmbCategoryFilter_SelectionChanged"/>
                                
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="15,0,0,0">
                                    <Button Click="BtnRefresh_Click" Style="{StaticResource OutlineButtonStyle}" Width="40" Height="40" Padding="0" ToolTip="Yenile">
                                        <iconPacks:PackIconMaterial Kind="Refresh" Width="18" Height="18"/>
                                    </Button>
                                    <Button Click="BtnExportPasswords_Click" Style="{StaticResource OutlineButtonStyle}" Width="40" Height="40" Padding="0" Margin="8,0,0,0" ToolTip="Dışa Aktar">
                                        <iconPacks:PackIconMaterial Kind="Export" Width="18" Height="18" Foreground="#2E7D32"/>
                                    </Button>
                                    <Button Click="BtnImportPasswords_Click" Style="{StaticResource OutlineButtonStyle}" Width="40" Height="40" Padding="0" Margin="8,0,0,0" ToolTip="İçe Aktar">
                                        <iconPacks:PackIconMaterial Kind="Import" Width="18" Height="18" Foreground="#1565C0"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Action Bar -->
                        <Grid Grid.Row="1" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal">
                                <Button Click="BtnAddPassword_Click" Style="{StaticResource AccentButtonStyle}" Background="#43A047" Height="40" Padding="20,0">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Plus" Width="18" Height="18" Margin="0,0,10,0"/>
                                        <TextBlock Text="Yeni Şifre Ekle" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="BtnEditPassword_Click" Style="{StaticResource OutlineButtonStyle}" Height="40" Padding="20,0" Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="PencilOutline" Width="18" Height="18" Margin="0,0,10,0"/>
                                        <TextBlock Text="Düzenle" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="BtnDeletePassword_Click" Style="{StaticResource OutlineButtonStyle}" Height="40" Padding="20,0" Margin="12,0,0,0" Foreground="#E53935" BorderBrush="#FFCDD2">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="DeleteOutline" Width="18" Height="18" Margin="0,0,10,0"/>
                                        <TextBlock Text="Sil" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Data Grid -->
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                            <DataGrid x:Name="DgPasswords" AutoGenerateColumns="False" BorderThickness="0"
                                      IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" 
                                      SelectionChanged="DgPasswords_SelectionChanged" MouseDoubleClick="DgPasswords_MouseDoubleClick"
                                      Background="Transparent" GridLinesVisibility="None">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <iconPacks:PackIconMaterial Kind="{Binding IsSecureNote, Converter={StaticResource BooleanToIconConverter}, ConverterParameter='Note:Lock'}" 
                                                                             Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                                             Foreground="{StaticResource AccentBrush}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Başlık" Binding="{Binding Title}" Width="*"/>
                                    <DataGridTextColumn Header="Kullanıcı" Binding="{Binding Username}" Width="150"/>
                                    <DataGridTextColumn Header="Kategori" Binding="{Binding CategoryName}" Width="120"/>
                                    <DataGridTextColumn Header="Eklenme Tarihi" Binding="{Binding CreatedDate, StringFormat='dd.MM.yyyy'}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Detail View (Popup style or Bottom Panel) -->
                        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,15,0,0" Background="{DynamicResource CardBackground}">
                            <Grid x:Name="GridDetails" Visibility="Hidden">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel>
                                    <TextBlock x:Name="TxtDetailTitle" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource HeaderText}"/>
                                    
                                    <WrapPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,30,10">
                                            <iconPacks:PackIconMaterial Kind="AccountOutline" Width="14" Height="14" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                                            <TextBlock Text=" Kullanıcı: " Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtDetailUsername" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource HeaderText}"/>
                                            <Button Click="BtnCopyUsername_Click" Style="{StaticResource MahApps.Styles.Button.Chromeless}" Width="30" Height="30" Margin="5,0,0,0">
                                                <iconPacks:PackIconMaterial Kind="ContentCopy" Width="12" Height="12" Foreground="{DynamicResource SecondaryText}"/>
                                            </Button>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <iconPacks:PackIconMaterial Kind="KeyOutline" Width="14" Height="14" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                                            <TextBlock Text=" Parola: " Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtDetailPassword" Text="••••••••" FontFamily="Consolas" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                                            <Button x:Name="BtnShowPassword" Click="BtnShowPassword_Click" Style="{StaticResource MahApps.Styles.Button.Chromeless}" Width="30" Height="30" Margin="5,0,0,0">
                                                <iconPacks:PackIconMaterial Kind="Eye" Width="14" Height="14" Foreground="{DynamicResource SecondaryText}"/>
                                            </Button>
                                            <Button Click="BtnCopyPasswordEntry_Click" Style="{StaticResource MahApps.Styles.Button.Chromeless}" Width="30" Height="30">
                                                <iconPacks:PackIconMaterial Kind="ContentCopy" Width="12" Height="12" Foreground="{DynamicResource SecondaryText}"/>
                                            </Button>
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>

                                <Border Grid.Column="1" Padding="15,8" Background="{DynamicResource AppBackground}" CornerRadius="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        Visibility="{Binding Path=TotpSecret, Converter={StaticResource StringToVisibilityConverter}}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="2FA / TOTP KODU" FontSize="10" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtTotpCode" Text="000 000" FontSize="24" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}" Margin="0,2"/>
                                        <ProgressBar x:Name="ProgressTotp" Height="4" Minimum="0" Maximum="30" Margin="0,2,0,0" Style="{StaticResource MahApps.Styles.ProgressBar}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- 4️⃣ Ayarlar -->
                <TabItem Header="Ayarlar">
                    <Grid MaxWidth="900" HorizontalAlignment="Left" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,0,20,0">
                            <StackPanel>
                                <TextBlock Text="Kategori Yönetimi" Style="{StaticResource SectionHeader}" Margin="0,0,0,15"/>
                                <ListBox x:Name="LstCategories" Height="250" Margin="0,0,0,15" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center" Margin="0,5">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="12" Height="12" CornerRadius="6" Background="{Binding Color}" Margin="0,0,12,0"/>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="14"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Click="BtnAddCategory_Click" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,10,0" Height="40">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Plus" Width="14" Height="14" Margin="0,0,8,0"/>
                                            <TextBlock Text="Ekle"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Click="BtnDeleteCategory_Click" Style="{StaticResource OutlineButtonStyle}" Height="40">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Delete" Width="14" Height="14" Margin="0,0,8,0"/>
                                            <TextBlock Text="Sil"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Kasa Güvenliği" Style="{StaticResource SectionHeader}" Margin="0,0,0,15"/>
                                
                                <Button Click="BtnChangeMasterPassword_Click" Style="{StaticResource OutlineButtonStyle}" Height="45" Margin="0,0,0,15">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="LockReset" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="Master Parolayı Değiştir" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                
                                <CheckBox x:Name="ChkAutoLock" Content="Boşta kaldığında otomatik kilitle (5 dk)" IsChecked="True" Margin="0,0,0,30" Foreground="{DynamicResource HeaderText}"/>
                                
                                <Separator Margin="0,0,0,20" Background="{DynamicResource CardBorderBrush}"/>
                                
                                <TextBlock Text="Tehlikeli Bölge" Foreground="#E53935" FontWeight="Bold" Margin="0,0,0,10"/>
                                <TextBlock Text="Kasayı sıfırladığınızda tüm şifreleriniz ve ayarlarınız kalıcı olarak silinecektir." FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,15" LineHeight="18"/>
                                <Button Click="BtnDeleteAll_Click" Style="{StaticResource OutlineButtonStyle}" BorderBrush="#E53935" Foreground="#E53935" Height="45">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="AlertOctagram" Width="18" Height="18" Margin="0,0,10,0"/>
                                        <TextBlock Text="Kasayı Tamamen Sıfırla" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </mah:MetroAnimatedSingleRowTabControl>
        </Grid>

        <!-- 🔒 Vault Lock Overlay (Modern Premium Look) -->
        <Border x:Name="VaultOverlay" Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource AppBackground}" Visibility="Visible">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
                <Border Width="100" Height="100" CornerRadius="50" Background="{DynamicResource CardBackground}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" Margin="0,0,0,30">
                    <iconPacks:PackIconMaterial Kind="SafeSquareOutline" Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                </Border>
                
                <TextBlock x:Name="TxtVaultStatus" Text="Şifre Kasası Kilitli" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12" Foreground="{DynamicResource HeaderText}"/>
                <TextBlock x:Name="TxtVaultMessage" Text="Şifreli verilerinize erişmek için master parolanızı doğrulamanız gerekmektedir." FontSize="14" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" Margin="0,0,0,40" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20"/>

                <Border Style="{StaticResource Card}" Padding="25">
                    <StackPanel>
                        <!-- 🆕 New Vault / Set Password View -->
                        <StackPanel x:Name="SetPasswordPanel" Visibility="Collapsed">
                            <TextBlock Text="Hoş Geldiniz! İlk adım olarak kasanızı koruyacak güçlü bir master parola belirleyin." FontSize="13" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,20" TextAlignment="Center"/>
                            <PasswordBox x:Name="TxtNewMasterPassword" mah:TextBoxHelper.Watermark="Yeni Master Parola" Height="45" Margin="0,0,0,12" VerticalContentAlignment="Center"/>
                            <PasswordBox x:Name="TxtConfirmMasterPassword" mah:TextBoxHelper.Watermark="Parolayı Tekrarla" Height="45" Margin="0,0,0,25" VerticalContentAlignment="Center"/>
                            <Button Click="BtnSetMasterPassword_Click" Style="{StaticResource AccentButtonStyle}" Height="50" Content="Kasanızı Güvenle Oluşturun"/>
                        </StackPanel>

                        <!-- 🔓 Login View -->
                        <StackPanel x:Name="LoginPanel" Visibility="Visible">
                            <PasswordBox x:Name="TxtMasterPassword" mah:TextBoxHelper.Watermark="Master Parola" Height="50" Margin="0,0,0,20" VerticalContentAlignment="Center" KeyDown="TxtMasterPassword_KeyDown" FontSize="18"/>
                            <Button Click="BtnUnlockVault_Click" Style="{StaticResource AccentButtonStyle}" Height="50">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="LockOpenVariantOutline" Width="20" Height="20" Margin="0,0,12,0"/>
                                    <TextBlock Text="Kasayı Aç" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <TextBlock Text="SwissKnife App - AES-256 Uçtan Uca Şifreleme" Margin="0,40,0,0" FontSize="11" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" Opacity="0.6"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
