<Page x:Class="SwissKnifeApp.Views.Modules.PasswordToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d"
      Title="Şifre Araçları">

    <!-- Sayfa özel vurgu renkleri (Güvenlik: mor tonları) -->
    <Page.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#7E57C2"/>
        <SolidColorBrush x:Key="AccentBrush2" Color="#5E35B1"/>

        <!-- DataGrid tema fırçaları -->
        <SolidColorBrush x:Key="DataGridHeaderBackground" Color="#F2ECFF"/>
        <SolidColorBrush x:Key="DataGridHeaderForeground" Color="#2C3E50"/>
        <SolidColorBrush x:Key="DataGridRowHoverBackground" Color="#F7F2FF"/>
        <SolidColorBrush x:Key="DataGridAltRowBackground" Color="#FAF7FF"/>
        <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#E0E0E0"/>

        <!-- Sütun başlığı stili -->
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{StaticResource DataGridHeaderBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource DataGridHeaderForeground}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource DataGridGridLinesBrush}"/>
        </Style>

        <!-- Satır stili -->
        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DataGridRowHoverBackground}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid genel stili -->
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ColumnHeaderHeight" Value="34"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource DataGridGridLinesBrush}"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource DataGridAltRowBackground}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <TabControl>
            <!-- 1️⃣ Şifre Oluşturucu -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="KeyVariant" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Şifre Oluşturucu"/>
                    </StackPanel>
                </TabItem.Header>
                <Border Style="{StaticResource Card}" Margin="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                            <iconPacks:PackIconMaterial Kind="FormTextboxPassword" Width="20" Height="20" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Şifre Oluşturucu" Style="{StaticResource SectionHeader}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <TextBlock Text="Şifre Uzunluğu:" FontWeight="SemiBold"/>
                            <Slider x:Name="SliderLength" Minimum="6" Maximum="32" Value="12" TickFrequency="1" IsSnapToTickEnabled="True"/>
                            <TextBlock Text="{Binding ElementName=SliderLength, Path=Value, StringFormat='Uzunluk: {0}'}"/>

                            <WrapPanel Margin="0,10,0,0">
                                <CheckBox x:Name="ChkUpper" Content="Büyük Harf (A-Z)" IsChecked="True" Margin="0,0,15,10"/>
                                <CheckBox x:Name="ChkLower" Content="Küçük Harf (a-z)" IsChecked="True" Margin="0,0,15,10"/>
                                <CheckBox x:Name="ChkNumbers" Content="Rakamlar (0-9)" IsChecked="True" Margin="0,0,15,10"/>
                                <CheckBox x:Name="ChkSymbols" Content="Semboller (!@#$...)" IsChecked="True" Margin="0,0,15,10"/>
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="BtnGenerate" Click="BtnGenerate_Click" Style="{StaticResource AccentButtonStyle}" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Refresh" Width="18" Height="18" Margin="5,0,10,0"/>
                                        <TextBlock Text="Şifre Oluştur" Width="60"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="BtnCopyPassword_Click" Style="{StaticResource OutlineButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="ContentCopy" Width="18" Height="18" Margin="5,0,10,0"/>
                                        <TextBlock Text="Kopyala" Width="40"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <TextBox x:Name="TxtGenerated" FontSize="18" FontWeight="Bold" TextAlignment="Center" IsReadOnly="True" Margin="0,10,0,0" Style="{StaticResource RoundedTextBox}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- 2️⃣ Şifre Gücü Analizi -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ShieldCheck" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Şifre Gücü Analizi"/>
                    </StackPanel>
                </TabItem.Header>
                <Border Style="{StaticResource Card}" Margin="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                            <iconPacks:PackIconMaterial Kind="LockCheckOutline" Width="20" Height="20" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Şifre Gücü Analizi" Style="{StaticResource SectionHeader}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <TextBox x:Name="TxtPasswordCheck" FontSize="16" Style="{StaticResource RoundedTextBox}" mah:TextBoxHelper.Watermark="Parolayı girin"/>
                            <ProgressBar x:Name="ProgressStrength" Height="20" Minimum="0" Maximum="100" Margin="0,10,0,0" Style="{StaticResource AccentProgressBar}"/>
                            <TextBlock x:Name="TxtStrengthLabel" FontWeight="Bold" FontSize="14" Margin="0,5,0,0"/>
                            <Button Click="BtnAnalyze_Click" Style="{StaticResource OutlineButtonStyle}" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Magnify" Width="18" Height="18" Margin="5,0,10,0"/>
                                    <TextBlock Text="Analiz Et"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- 3️⃣ Hash Üretici -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Fingerprint" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Hash Üretici"/>
                    </StackPanel>
                </TabItem.Header>
                <Border Style="{StaticResource Card}" Margin="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                            <iconPacks:PackIconMaterial Kind="LockOutline" Width="20" Height="20" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Hash Üretici" Style="{StaticResource SectionHeader}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <TextBox x:Name="TxtHashInput" FontSize="16" Style="{StaticResource RoundedTextBox}" mah:TextBoxHelper.Watermark="Metin veya parola"/>
                            <ComboBox x:Name="CmbHashAlgo" SelectedIndex="0" Margin="0,10,0,0">
                                <ComboBoxItem Content="MD5"/>
                                <ComboBoxItem Content="SHA1"/>
                                <ComboBoxItem Content="SHA256"/>
                                <ComboBoxItem Content="SHA512"/>
                            </ComboBox>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Click="BtnHash_Click" Style="{StaticResource AccentButtonStyle}" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="ShieldKeyOutline" Width="18" Height="18" Margin="5,0,10,0"/>
                                        <TextBlock Text="Hash Üret" Width="50"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="BtnCopyHash_Click" Style="{StaticResource OutlineButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="ContentCopy" Width="18" Height="18" Margin="5,0,10,0"/>
                                        <TextBlock Text="Kopyala" Width="40"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBox x:Name="TxtHashResult" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- 4️⃣ AES Şifreleme / Çözme -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ShieldLockOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="AES Şifreleme / Çözme"/>
                    </StackPanel>
                </TabItem.Header>
                <Border Style="{StaticResource Card}" Margin="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                            <iconPacks:PackIconMaterial Kind="CogOutline" Width="20" Height="20" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="AES Şifreleme / Çözme" Style="{StaticResource SectionHeader}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <TextBox x:Name="TxtAesInput" FontSize="16" Style="{StaticResource RoundedTextBox}" mah:TextBoxHelper.Watermark="Şifrelenecek metin"/>
                            <PasswordBox x:Name="TxtAesKey" Margin="0,10,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Click="BtnEncrypt_Click" Style="{StaticResource AccentButtonStyle}" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Lock" Width="18" Height="18" Margin="5,0,8,0"/>
                                        <TextBlock Text="Şifrele" Width="40"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="BtnDecrypt_Click" Style="{StaticResource OutlineButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="LockOpenVariant" Width="18" Height="18" Margin="5,0,8,0"/>
                                        <TextBlock Text="Çöz" Width="20"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBox x:Name="TxtAesOutput" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,10,0,0"/>
                            <Button Click="BtnCopyAes_Click" Style="{StaticResource OutlineButtonStyle}" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ContentCopy" Width="18" Height="18" Margin="5,0,10,0"/>
                                    <TextBlock Text="Kopyala"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- 5️⃣ Parola Yöneticisi -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="SafeSquareOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Parola Yöneticisi"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Arama ve Filtreleme -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                                <iconPacks:PackIconMaterial Kind="Magnify" Width="20" Height="20" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="Arama ve Filtreleme" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSearch" Style="{StaticResource RoundedTextBox}" Width="350" Margin="-300,0,0,0" mah:TextBoxHelper.Watermark="Başlık veya kullanıcı adı" TextChanged="TxtSearch_TextChanged"/>
                                <ComboBox x:Name="CmbCategoryFilter" Width="180" Margin="5,0" Grid.Column="1" SelectionChanged="CmbCategoryFilter_SelectionChanged"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Click="BtnSearch_Click" Style="{StaticResource OutlineButtonStyle}" Margin="5,0">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Magnify" Width="18" Height="18" Margin="5,0,8,0"/>
                                            <TextBlock Text="Ara" Width="20"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="BtnRefresh_Click" Style="{StaticResource OutlineButtonStyle}" Margin="5,0">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Refresh" Width="18" Height="18" Margin="5,0,8,0"/>
                                            <TextBlock Text="Yenile" Width="30"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Hızlı İşlemler -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Button Click="BtnAddPassword_Click" Style="{StaticResource AccentButtonStyle}" Background="LightGreen" Foreground="Black" Margin="5,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Plus" Width="18" Height="18" Margin="5,0,8,0"/>
                                    <TextBlock Text="Yeni Parola" Width="60"/>
                                </StackPanel>
                            </Button>
                            <Button Click="BtnEditPassword_Click" Style="{StaticResource AccentButtonStyle}" Margin="5,0" Background="Yellow" Foreground="Black">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Pencil" Width="18" Height="18" Margin="5,0,8,0"/>
                                    <TextBlock Text="Düzenle" Width="40"/>
                                </StackPanel>
                            </Button>
                            <Button Click="BtnDeletePassword_Click" Style="{StaticResource AccentButtonStyle}" Margin="5,0" Background="Red" Foreground="White">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="DeleteOutline" Width="18" Height="18" Margin="5,0,8,0"/>
                                    <TextBlock Text="Sil" Width="20"/>
                                </StackPanel>
                            </Button>
                            <Button Click="BtnDeleteAll_Click" Style="{StaticResource AccentButtonStyle}" Margin="5,0" Background="DarkRed" Foreground="White">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Alert" Width="18" Height="18" Margin="5,0,8,0"/>
                                    <TextBlock Text="Tümünü Sil" Width="60"/>
                                </StackPanel>
                            </Button>                          
                            <Button Click="BtnAddCategory_Click" Style="{StaticResource AccentButtonStyle}" Margin="5,0" Background="LightGreen" Foreground="Black">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="FolderPlus" Width="18" Height="18" Margin="5,0,8,0"/>
                                    <TextBlock Text="Kategori Ekle" Width="70"/>
                                </StackPanel>
                            </Button>
                            <Button Click="BtnDeleteCategory_Click" Style="{StaticResource AccentButtonStyle}" Margin="5,0" Background="Red" Foreground="White">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="FolderRemove" Width="18" Height="18" Margin="5,0,8,0"/>
                                    <TextBlock Text="Kategori Sil" Width="60"/>
                                </StackPanel>
                            </Button>
                            <Button Click="BtnCopyPasswordEntry_Click" Style="{StaticResource AccentButtonStyle}" Margin="5,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ContentCopy" Width="18" Height="18" Margin="5,0,8,0"/>
                                    <TextBlock Text="Parolayı Kopyala" Width="80"/>
                                </StackPanel>
                            </Button>
                            <Button Click="BtnExportPasswords_Click" Style="{StaticResource AccentButtonStyle}" Margin="5,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ExportVariant" Width="18" Height="18" Margin="5,0,8,0"/>
                                    <TextBlock Text="Dışa Aktar" Width="50"/>
                                </StackPanel>
                            </Button>
                            <Button Click="BtnImportPasswords_Click" Style="{StaticResource AccentButtonStyle}" Margin="5,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Import" Width="18" Height="18" Margin="5,0,8,0"/>
                                    <TextBlock Text="İçe Aktar" Width="45"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Parola Listesi -->
                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                                <iconPacks:PackIconMaterial Kind="LockMinusOutline" Width="20" Height="20" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="Parola Listesi" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>
                            <DataGrid x:Name="DgPasswords" Grid.Row="1" AutoGenerateColumns="False" 
                                      IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" SelectionChanged="DgPasswords_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                    <DataGridTextColumn Header="Başlık" Binding="{Binding Title}" Width="150"/>
                                    <DataGridTextColumn Header="Kullanıcı Adı" Binding="{Binding Username}" Width="150"/>
                                    <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="200"/>
                                    <DataGridTextColumn Header="Kategori" Binding="{Binding CategoryName}" Width="100"/>
                                    <DataGridTextColumn Header="Güç" Binding="{Binding Strength}" Width="80"/>
                                    <DataGridTextColumn Header="Son Tarih" Binding="{Binding ExpiryDate, StringFormat='dd.MM.yyyy'}" Width="100"/>
                                    <DataGridTextColumn Header="Oluşturma" Binding="{Binding CreatedDate, StringFormat='dd.MM.yyyy HH:mm'}" Width="130"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Detay Paneli -->
                    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                                <iconPacks:PackIconMaterial Kind="InformationOutline" Width="20" Height="20" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="Detaylar" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Başlık:" Margin="5"/>
                                <TextBlock x:Name="TxtDetailTitle" Grid.Row="0" Grid.Column="1" Margin="5" FontWeight="Bold"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Kullanıcı Adı:" Margin="5"/>
                                <TextBlock x:Name="TxtDetailUsername" Grid.Row="1" Grid.Column="1" Margin="5"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Parola:" Margin="5"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock x:Name="TxtDetailPassword" Margin="5" Text="****" FontFamily="Consolas"/>
                                    <Button Click="BtnShowPassword_Click" Style="{StaticResource OutlineButtonStyle}" Margin="5,0">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="EyeOutline" Width="18" Height="18" Margin="5,0,8,0"/>
                                            <TextBlock Text="Göster" Width="40"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
