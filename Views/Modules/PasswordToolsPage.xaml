<Page x:Class="SwissKnifeApp.Views.Modules.PasswordToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:helpers="clr-namespace:SwissKnifeApp.Helpers"
      mc:Ignorable="d"
      Title="Şifre Araçları">

    <!-- Sayfa özel vurgu renkleri (Güvenlik: mor tonları) -->
    <Page.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#7E57C2"/>
        <SolidColorBrush x:Key="AccentBrush2" Color="#5E35B1"/>

        <!-- DataGrid tema fırçaları -->
        <SolidColorBrush x:Key="DataGridHeaderBackground" Color="#F2ECFF"/>
        <SolidColorBrush x:Key="DataGridHeaderForeground" Color="#2C3E50"/>
        <SolidColorBrush x:Key="DataGridRowHoverBackground" Color="#F7F2FF"/>
        <SolidColorBrush x:Key="DataGridAltRowBackground" Color="#FAF7FF"/>
        <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#E0E0E0"/>

        <!-- Sütun başlığı stili -->
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{StaticResource DataGridHeaderBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource DataGridHeaderForeground}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource DataGridGridLinesBrush}"/>
        </Style>

        <!-- Satır stili -->
        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DataGridRowHoverBackground}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid genel stili -->
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ColumnHeaderHeight" Value="34"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource DataGridGridLinesBrush}"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource DataGridAltRowBackground}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        </Style>
    </Page.Resources>

    <Grid Margin="0">
        <!-- 🔐 Vault Unlocked State (Main Content) -->
        <Grid x:Name="VaultContent" Margin="20" Visibility="Collapsed">
            <TabControl x:Name="MainTabControl">
                <!-- 1️⃣ Şifre Oluşturucu -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="KeyVariant" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Şifre Oluşturucu"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Border Style="{StaticResource Card}" Margin="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                                <iconPacks:PackIconMaterial Kind="FormTextboxPassword" Width="20" Height="20" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="Şifre Oluşturucu" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1">
                                <TextBlock Text="Şifre Uzunluğu:" FontWeight="SemiBold"/>
                                <Slider x:Name="SliderLength" Minimum="6" Maximum="64" Value="16" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                <TextBlock Text="{Binding ElementName=SliderLength, Path=Value, StringFormat='Uzunluk: {0}'}"/>

                                <WrapPanel Margin="0,10,0,0">
                                    <CheckBox x:Name="ChkUpper" Content="Büyük Harf (A-Z)" IsChecked="True" Margin="0,0,15,10"/>
                                    <CheckBox x:Name="ChkLower" Content="Küçük Harf (a-z)" IsChecked="True" Margin="0,0,15,10"/>
                                    <CheckBox x:Name="ChkNumbers" Content="Rakamlar (0-9)" IsChecked="True" Margin="0,0,15,10"/>
                                    <CheckBox x:Name="ChkSymbols" Content="Semboller (!@#$...)" IsChecked="True" Margin="0,0,15,10"/>
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="BtnGenerate" Click="BtnGenerate_Click" Style="{StaticResource AccentButtonStyle}" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Refresh" Width="18" Height="18" Margin="5,0,10,0"/>
                                            <TextBlock Text="Şifre Oluştur" Width="80"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="BtnCopyPassword_Click" Style="{StaticResource OutlineButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="ContentCopy" Width="18" Height="18" Margin="5,0,10,0"/>
                                            <TextBlock Text="Kopyala" Width="60"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <TextBox x:Name="TxtGenerated" FontSize="20" FontWeight="Bold" TextAlignment="Center" IsReadOnly="True" Margin="0,10,0,0" Style="{StaticResource RoundedTextBox}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- 2️⃣ Şifre Gücü Analizi & Breach Check -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ShieldCheck" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Güvenlik Analizi"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Border Style="{StaticResource Card}" Margin="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                                <iconPacks:PackIconMaterial Kind="LockCheckOutline" Width="20" Height="20" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="Şifre Gücü &amp; Sızıntı Kontrolü" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1">
                                <PasswordBox x:Name="TxtPasswordCheck" FontSize="16" mah:TextBoxHelper.Watermark="Analiz edilecek parolayı girin" Height="35" VerticalContentAlignment="Center"/>
                                <ProgressBar x:Name="ProgressStrength" Height="15" Minimum="0" Maximum="100" Margin="0,10,0,0" Style="{StaticResource AccentProgressBar}"/>
                                <TextBlock x:Name="TxtStrengthLabel" FontWeight="Bold" FontSize="14" Margin="0,5,0,0"/>
                                
                                <Button Click="BtnAnalyze_Click" Style="{StaticResource OutlineButtonStyle}" Margin="0,15,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Magnify" Width="18" Height="18" Margin="5,0,10,0"/>
                                        <TextBlock Text="Şifreyi Analiz Et"/>
                                    </StackPanel>
                                </Button>

                                <Border BorderThickness="0,1,0,0" BorderBrush="#EEE" Margin="0,20,0,20"/>

                                <TextBlock Text="Have I Been Pwned (Sızıntı Kontrolü)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBlock Text="Parolanızın daha önce bir sızıntıda yer alıp almadığını kontrol edin (Sadece parolanın hash değeri gönderilir)." FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <Button Click="BtnCheckBreach_Click" Style="{StaticResource AccentButtonStyle}" Background="#E53935">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="DatabaseSearch" Width="18" Height="18" Margin="5,0,10,0"/>
                                        <TextBlock Text="Sızıntı Kontrolü Yap"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="TxtBreachResult" TextWrapping="Wrap" Margin="0,10,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- 3️⃣ Şifre Kasası (Vault) -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="SafeSquareOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Şifre Kasası"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Arama ve Filtreleme -->
                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,15" Padding="15,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBox x:Name="TxtSearch" Style="{StaticResource RoundedTextBox}" 
                                         mah:TextBoxHelper.Watermark="Başlık veya kullanıcı adı ile ara..." 
                                         TextChanged="TxtSearch_TextChanged" Margin="0,0,10,0">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>

                                <ComboBox x:Name="CmbCategoryFilter" Width="180" Grid.Column="1" 
                                          DisplayMemberPath="Name" SelectedValuePath="Id"
                                          mah:TextBoxHelper.Watermark="Kategori Seç"
                                          SelectionChanged="CmbCategoryFilter_SelectionChanged" VerticalAlignment="Center"/>
                                
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                                    <Button Click="BtnRefresh_Click" Style="{StaticResource OutlineButtonStyle}" 
                                            ToolTip="Yenile" Width="40" Padding="0">
                                        <iconPacks:PackIconMaterial Kind="Refresh" Width="18" Height="18"/>
                                    </Button>
                                    <Button Click="BtnLockVault_Click" Style="{StaticResource OutlineButtonStyle}" 
                                            Margin="8,0,0,0" Background="#FFF3E0" BorderBrush="#FFAB91">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Lock" Width="16" Height="16" Margin="0,0,8,0" Foreground="#D84315"/>
                                            <TextBlock Text="Kasayı Kilitle" Foreground="#D84315" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- İşlemler -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Button Click="BtnAddPassword_Click" Style="{StaticResource AccentButtonStyle}" Background="#43A047" Margin="0,0,8,0" Padding="15,6">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Plus" Width="18" Height="18" Margin="0,0,8,0"/>
                                        <TextBlock Text="Yeni Ekle" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="BtnEditPassword_Click" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,8,0" Padding="15,6">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Pencil" Width="18" Height="18" Margin="0,0,8,0"/>
                                        <TextBlock Text="Düzenle" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="BtnDeletePassword_Click" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,8,0" Padding="15,6" 
                                        Foreground="#E53935" BorderBrush="#FFCDD2">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Delete" Width="18" Height="18" Margin="0,0,8,0"/>
                                        <TextBlock Text="Sil" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Click="BtnExportPasswords_Click" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,8,0" 
                                        BorderBrush="#81C784" Foreground="#2E7D32">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Export" Width="18" Height="18" Margin="0,0,8,0"/>
                                        <TextBlock Text="Dışa Aktar" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="BtnImportPasswords_Click" Style="{StaticResource OutlineButtonStyle}" 
                                        BorderBrush="#64B5F6" Foreground="#1565C0">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Import" Width="18" Height="18" Margin="0,0,8,0"/>
                                        <TextBlock Text="İçe Aktar" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Parola Listesi -->
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                            <DataGrid x:Name="DgPasswords" AutoGenerateColumns="False" BorderThickness="0"
                                      IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" 
                                      SelectionChanged="DgPasswords_SelectionChanged" MouseDoubleClick="DgPasswords_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <iconPacks:PackIconMaterial Kind="{Binding IsSecureNote, Converter={StaticResource BooleanToIconConverter}, ConverterParameter='Note:Lock'}" 
                                                                             Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                                             Foreground="{StaticResource AccentBrush}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Başlık" Binding="{Binding Title}" Width="*"/>
                                    <DataGridTextColumn Header="Kullanıcı" Binding="{Binding Username}" Width="150"/>
                                    <DataGridTextColumn Header="Kategori" Binding="{Binding CategoryName}" Width="120"/>
                                    <DataGridTextColumn Header="Giriş" Binding="{Binding CreatedDate, StringFormat='dd.MM.yyyy'}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Detay Paneli -->
                        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0">
                            <Grid x:Name="GridDetails" Visibility="Hidden">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel>
                                    <TextBlock x:Name="TxtDetailTitle" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Kullanıcı: " Foreground="Gray"/>
                                        <TextBlock x:Name="TxtDetailUsername" FontWeight="SemiBold"/>
                                        <Button Click="BtnCopyUsername_Click" Style="{StaticResource MahApps.Styles.Button.Chromeless}" Margin="10,0">
                                            <iconPacks:PackIconMaterial Kind="ContentCopy" Width="14" Height="14"/>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="Parola: " Foreground="Gray"/>
                                        <TextBlock x:Name="TxtDetailPassword" Text="********" FontFamily="Consolas" VerticalAlignment="Center"/>
                                        <Button x:Name="BtnShowPassword" Click="BtnShowPassword_Click" Style="{StaticResource MahApps.Styles.Button.Chromeless}" Margin="10,0">
                                            <iconPacks:PackIconMaterial Kind="Eye" Width="14" Height="14"/>
                                        </Button>
                                        <Button Click="BtnCopyPasswordEntry_Click" Style="{StaticResource MahApps.Styles.Button.Chromeless}">
                                            <iconPacks:PackIconMaterial Kind="ContentCopy" Width="14" Height="14"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Visibility="{Binding Path=TotpSecret, Converter={StaticResource StringToVisibilityConverter}}">
                                    <TextBlock Text="2FA / TOTP" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTotpCode" Text="000 000" FontSize="24" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}"/>
                                    <ProgressBar x:Name="ProgressTotp" Height="4" Minimum="0" Maximum="30" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- 4️⃣ Ayarlar (Kategoriler vb) -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Cog" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Ayarlar"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Kategoriler" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                                <ListBox x:Name="LstCategories" Height="250" Margin="0,0,0,10">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="12" Height="12" Fill="{Binding Color}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Name}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Orientation="Horizontal">
                                    <Button Click="BtnAddCategory_Click" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,5,0" Content="Ekle"/>
                                    <Button Click="BtnDeleteCategory_Click" Style="{StaticResource OutlineButtonStyle}" Content="Sil"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Kasa Güvenliği" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                                <Button Click="BtnChangeMasterPassword_Click" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,0,10">
                                    <TextBlock Text="Master Parolayı Değiştir"/>
                                </Button>
                                <CheckBox x:Name="ChkAutoLock" Content="Otomatik kilitleme (5 dk sonra)" IsChecked="True" Margin="0,0,0,10"/>
                                <TextBlock Text="Tüm verileri sil" Foreground="Red" FontWeight="Bold" Margin="0,20,0,5"/>
                                <Button Click="BtnDeleteAll_Click" Style="{StaticResource OutlineButtonStyle}" BorderBrush="Red" Foreground="Red">
                                    <TextBlock Text="Kasayı Sıfırla"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- 🔒 Vault Lock Overlay -->
        <Border x:Name="VaultOverlay" Background="{DynamicResource MahApps.Brushes.ThemeBackground}" Visibility="Visible">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="350">
                <iconPacks:PackIconMaterial Kind="SafeSquareOutline" Width="64" Height="64" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,20"/>
                
                <TextBlock x:Name="TxtVaultStatus" Text="Şifre Kasası Kilitli" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock x:Name="TxtVaultMessage" Text="Verilerinize erişmek için master parolanızı girin." FontSize="14" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,30" TextAlignment="Center" TextWrapping="Wrap"/>

                <!-- 🆕 New Vault / Set Password View -->
                <StackPanel x:Name="SetPasswordPanel" Visibility="Collapsed">
                    <TextBlock Text="Henüz bir master parola ayarlanmamış. Lütfen bir tane oluşturun." TextWrapping="Wrap" Margin="0,0,0,10" TextAlignment="Center"/>
                    <PasswordBox x:Name="TxtNewMasterPassword" mah:TextBoxHelper.Watermark="Yeni Master Parola" Height="40" Margin="0,0,0,10" VerticalContentAlignment="Center"/>
                    <PasswordBox x:Name="TxtConfirmMasterPassword" mah:TextBoxHelper.Watermark="Parolayı Onayla" Height="40" Margin="0,0,0,20" VerticalContentAlignment="Center"/>
                    <Button Click="BtnSetMasterPassword_Click" Style="{StaticResource AccentButtonStyle}" Height="40" Content="Kasa Oluştur"/>
                </StackPanel>

                <!-- 🔓 Login View -->
                <StackPanel x:Name="LoginPanel" Visibility="Visible">
                    <PasswordBox x:Name="TxtMasterPassword" mah:TextBoxHelper.Watermark="Master Parola" Height="45" Margin="0,0,0,20" VerticalContentAlignment="Center" KeyDown="TxtMasterPassword_KeyDown"/>
                    <Button Click="BtnUnlockVault_Click" Style="{StaticResource AccentButtonStyle}" Height="45" Content="Kasayı Aç"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
