<Page x:Class="SwissKnifeApp.Views.Modules.AudioToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      mc:Ignorable="d"
      Title="Ses Araçları">
    <!-- Page-level accent overrides (Audio = Green) -->
    <Page.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#43A047"/>
        <SolidColorBrush x:Key="AccentBrush2" Color="#2E7D32"/>
    </Page.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
            <iconPacks:PackIconMaterial Kind="Music" Width="28" Height="28" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="Ses Araçları" FontSize="20" FontWeight="Bold" Margin="8,0,0,0"/>
            <TextBlock Text=" • Dönüştürme ve Trim" Foreground="#607D8B" Margin="6,4,0,0"/>
        </StackPanel>

        <!-- File & Output Card + Audio Player -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Girdiler" Style="{StaticResource SectionHeader}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource AccentButtonStyle}" Click="BtnPickFiles_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FolderMusic" Width="18" Height="18" Margin="10,0,8,0"/>
                            <TextBlock Text="Dosyaları Seç" Width="70"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Seçilen:" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LblSelectedCount" Text="0" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>

                <!-- Audio Player Controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button Width="38" Height="38" Click="BtnPlayAudio_Click" ToolTip="Oynat" Style="{StaticResource AccentButtonStyle}">
                        <iconPacks:PackIconMaterial Kind="Play" Width="22" Height="22" Foreground="#43A047"/>
                    </Button>
                    <Button Width="38" Height="38" Margin="8,0,0,0" Click="BtnPauseAudio_Click" ToolTip="Duraklat" Style="{StaticResource AccentButtonStyle}">
                        <iconPacks:PackIconMaterial Kind="Pause" Width="22" Height="22" Foreground="#43A047"/>
                    </Button>
                    <Button Width="38" Height="38" Margin="8,0,0,0" Click="BtnStopAudio_Click" ToolTip="Durdur" Style="{StaticResource AccentButtonStyle}">
                        <iconPacks:PackIconMaterial Kind="Stop" Width="22" Height="22" Foreground="#43A047"/>
                    </Button>
                    <Button Width="38" Height="38" Margin="16,0,0,0" Click="BtnBackwardAudio_Click" ToolTip="Geri Sar" Style="{StaticResource AccentButtonStyle}">
                        <iconPacks:PackIconMaterial Kind="Rewind" Width="22" Height="22" Foreground="#43A047"/>
                    </Button>
                    <Button Width="38" Height="38" Margin="8,0,0,0" Click="BtnForwardAudio_Click" ToolTip="İleri Sar" Style="{StaticResource AccentButtonStyle}">
                        <iconPacks:PackIconMaterial Kind="FastForward" Width="22" Height="22" Foreground="#43A047"/>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock x:Name="TxtCurrentTime" Text="00:00" FontWeight="Bold" Foreground="#43A047" Margin="0,0,8,0"/>
                    <Slider x:Name="SliderPosition" Minimum="0" Maximum="100" Value="0" Height="24" Width="220" ToolTip="Zaman Çubuğu"/>
                    <TextBlock x:Name="TxtTotalTime" Text="00:00" FontWeight="Bold" Foreground="#43A047" Margin="8,0,0,0"/>
                </StackPanel>
                <!-- Hidden MediaElement for audio playback -->
                <MediaElement x:Name="AudioPlayer" LoadedBehavior="Manual" UnloadedBehavior="Manual" Visibility="Collapsed" />

                <Separator Margin="0,10,0,10"/>
                <TextBlock Text="Çıkış Klasörü" Style="{StaticResource SectionHeader}"/>
                <DockPanel>
                    <TextBox x:Name="TxtOutput" Style="{StaticResource RoundedTextBox}" Height="32" MinWidth="360"/>
                    <Button Style="{StaticResource OutlineButtonStyle}" Margin="8,0,0,0" Click="BtnPickFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Folder" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Seç"/>
                        </StackPanel>
                    </Button>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Options TabControl -->
        <TabControl Grid.Row="2" Margin="0,0,0,12" Background="Transparent" BorderThickness="0">
            <!-- 1️⃣ DÖNÜŞTÜRMELİ VE TRIM -->
            <TabItem Header="Dönüştür &amp; Kes">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <WrapPanel ItemWidth="260" ItemHeight="40" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,4,20,4">
                                <TextBlock Text="İşlem" VerticalAlignment="Center" Width="80"/>
                                <ComboBox x:Name="CmbMode" Width="150">
                                    <ComboBoxItem Content="Dönüştür" IsSelected="True"/>
                                    <ComboBoxItem Content="Trim (Kes)"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4,20,4">
                                <TextBlock Text="Format" VerticalAlignment="Center" Width="80"/>
                                <ComboBox x:Name="CmbFormat" Width="150" SelectedIndex="0">
                                    <ComboBoxItem Content="MP3"/>
                                    <ComboBoxItem Content="AAC"/>
                                    <ComboBoxItem Content="WAV"/>
                                    <ComboBoxItem Content="FLAC"/>
                                    <ComboBoxItem Content="OPUS"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4,20,4">
                                <TextBlock Text="Kalite" VerticalAlignment="Center" Width="80"/>
                                <ComboBox x:Name="CmbQuality" Width="150" SelectedIndex="0">
                                    <ComboBoxItem Content="Highest"/>
                                    <ComboBoxItem Content="High"/>
                                    <ComboBoxItem Content="Medium"/>
                                    <ComboBoxItem Content="Low"/>
                                    <ComboBoxItem Content="Lossless"/>
                                </ComboBox>
                            </StackPanel>

                            <CheckBox x:Name="ChkNormalize" Content="Normalize (loudnorm)" VerticalAlignment="Center" Margin="0,4,20,4"/>
                        </WrapPanel>

                        <Separator Margin="0,10,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Başlangıç" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtStart" Style="{StaticResource RoundedTextBox}" Width="110" Height="32" Margin="8,0,0,0" mah:TextBoxHelper.Watermark="00:00"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="24,0,0,0">
                                <TextBlock Text="Bitiş" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtEnd" Style="{StaticResource RoundedTextBox}" Width="110" Height="32" Margin="8,0,0,0" mah:TextBoxHelper.Watermark="00:00"/>
                            </StackPanel>
                            <Button x:Name="BtnStart" Style="{StaticResource AccentButtonStyle}" Content="İşlemi Başlat" Click="BtnStart_Click" Margin="24,0,0,0" Padding="15,5"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- 2️⃣ SES BİRLEŞTİRME -->
            <TabItem Header="Ses Birleştir">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Seçilen tüm dosyalar sırasıyla uç uca eklenecektir." Foreground="#607D8B" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Çıkış Formatı:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CmbMergeFormat" Width="120" SelectedIndex="0">
                                <ComboBoxItem Content="MP3"/>
                                <ComboBoxItem Content="WAV"/>
                                <ComboBoxItem Content="AAC"/>
                            </ComboBox>
                            <Button Style="{StaticResource AccentButtonStyle}" Content="Birleştirmeyi Başlat" Click="BtnMerge_Click" Margin="20,0,0,0" Padding="15,5"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- 3️⃣ GELİŞMİŞ EFEKTLER -->
            <TabItem Header="Gelişmiş Efektler">
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Perde (Pitch):" FontWeight="SemiBold"/>
                            <Slider x:Name="SldPitch" Minimum="0.5" Maximum="2.0" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,5,0,10"/>
                            <TextBlock Text="{Binding Value, ElementName=SldPitch, StringFormat={}{0:F1}x}" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}"/>
                            
                            <TextBlock Text="Hız (Speed):" FontWeight="SemiBold" Margin="0,10,0,0"/>
                            <Slider x:Name="SldSpeed" Minimum="0.5" Maximum="2.0" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,5,0,10"/>
                            <TextBlock Text="{Binding Value, ElementName=SldSpeed, StringFormat={}{0:F1}x}" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkReduceNoise" Content="Arka Plan Gürültüsünü Azalt" Margin="0,0,0,15"/>
                            <Button Style="{StaticResource OutlineButtonStyle}" Content="Önizlemeyi Dinle" Click="BtnPreviewAdvanced_Click" Margin="0,0,0,8">
                                <Button.ToolTip>Ayarların ilk 10 saniyesini dinle</Button.ToolTip>
                            </Button>
                            <Button Style="{StaticResource AccentButtonStyle}" Content="Tümünü İşle ve Kaydet" Click="BtnApplyAdvanced_Click" Padding="20,10"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- 4️⃣ ANALİZ ARAÇLARI -->
            <TabItem Header="Analiz">
                <Border Style="{StaticResource Card}">
                    <UniformGrid Columns="2">
                        <StackPanel Margin="10">
                            <TextBlock Text="Spektrum Analizi" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="Müziğe göre hareketli görsel bir video oluşturur." TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12"/>
                            <Button Style="{StaticResource OutlineButtonStyle}" Content="Spektrum Videosu Oluştur" Click="BtnGenerateSpectrum_Click"/>
                        </StackPanel>
                        <StackPanel Margin="10">
                            <TextBlock Text="BPM Tespiti" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="Şarkının temposunu (vuruş sayısını) ölçer." TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12"/>
                            <Button Style="{StaticResource OutlineButtonStyle}" Content="BPM Ölç" Click="BtnDetectBpm_Click"/>
                            <TextBlock x:Name="TxtBpmResult" Text="BPM: --" FontWeight="Bold" FontSize="16" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </UniformGrid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Progress & Log Card -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="İlerleme" Style="{StaticResource SectionHeader}"/>
                <DockPanel Grid.Row="1" Margin="0,4,0,0">
                    <Button x:Name="BtnCancel" Style="{StaticResource OutlineButtonStyle}" Content="İptal" Click="BtnCancel_Click" IsEnabled="False" DockPanel.Dock="Right" Margin="10,0,0,0"/>
                    <ProgressBar x:Name="PbTotal" Minimum="0" Maximum="100" Style="{StaticResource AccentProgressBar}" Height="20"/>
                </DockPanel>
                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock Text="Log" Style="{StaticResource SectionHeader}"/>
                    <ScrollViewer Margin="0,4,0,0" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="TxtLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160"/>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>