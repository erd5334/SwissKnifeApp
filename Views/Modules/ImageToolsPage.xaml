<Page x:Class="SwissKnifeApp.Views.Modules.ImageToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:local="clr-namespace:SwissKnifeApp.Views.Modules"
      mc:Ignorable="d" 
      d:DesignHeight="850" d:DesignWidth="1100"
      Background="{DynamicResource AppBackground}"
      Title="Gelişmiş Görsel Araçları">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Modern Header -->
        <Border Grid.Row="0" Padding="25,20" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ImageEdit" Width="30" Height="30" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Gelişmiş Görsel Araçları" FontSize="24" FontWeight="Bold" Margin="15,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource HeaderText}"/>
                    </StackPanel>
                    <TextBlock Text="Toplu format dönüştürme, boyutlandırma, filigran ekleme ve AI optimizasyon" FontSize="14" Foreground="{DynamicResource SecondaryText}" Margin="45,5,0,0"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnAddImages" Style="{StaticResource AccentButtonStyle}" Click="BtnAddImages_Click" Height="40" Padding="20,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ImagePlus" Width="18" Height="18" Margin="0,0,10,0"/>
                            <TextBlock Text="Görsel Ekle" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource OutlineButtonStyle}" Margin="12,0,0,0" Click="BtnClear_Click" Width="40" Height="40" Padding="0" ToolTip="Listeyi Temizle">
                        <iconPacks:PackIconMaterial Kind="DeleteSweepOutline" Width="20" Height="20"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar: Actions & Settings -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,20,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <TextBlock Text="İşlem Ayarları" Style="{StaticResource SectionHeader}"/>
                            
                            <mah:MetroAnimatedSingleRowTabControl x:Name="TabSettings" mah:HeaderedControlHelper.HeaderFontSize="14" mah:TabControlHelper.Underlined="SelectedTabItem">
                                
                                <!-- Convert & Optimize -->
                                <TabItem Header="Düzenle">
                                    <StackPanel Margin="0,15,0,0">
                                        <TextBlock Text="Hedef Format" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,8" FontSize="11"/>
                                        <ComboBox x:Name="CmbFormat" Height="36" Margin="0,0,0,20">
                                            <ComboBoxItem Content="JPG" IsSelected="True"/>
                                            <ComboBoxItem Content="PNG"/>
                                            <ComboBoxItem Content="WEBP"/>
                                            <ComboBoxItem Content="BMP"/>
                                            <ComboBoxItem Content="GIF"/>
                                            <ComboBoxItem Content="ICO"/>
                                        </ComboBox>

                                        <TextBlock Text="Kalite (%)" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,8" FontSize="11"/>
                                        <Grid Margin="0,0,0,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="SldQuality" Minimum="1" Maximum="100" Value="85" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Background="{DynamicResource AppBackground}" CornerRadius="4" Padding="8,4" Margin="10,0,0,0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding ElementName=SldQuality, Path=Value, StringFormat={}{0:0}}" FontWeight="Bold" Width="25" TextAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <CheckBox x:Name="ChkOptimize" Content="Optimizasyon (Kayıpsız)" Margin="0,0,0,12"/>
                                        <CheckBox x:Name="ChkStripMetadata" Content="Metadata Seviye Temizliği" Margin="0,0,0,0"/>
                                    </StackPanel>
                                </TabItem>

                                <!-- Resize & Upscale -->
                                <TabItem Header="Boyut">
                                    <StackPanel Margin="0,15,0,0">
                                        <TextBlock Text="Yeniden Boyutlandır" FontWeight="Bold" Margin="0,0,0,12"/>
                                        
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtWidth" Style="{StaticResource RoundedTextBox}" Height="36" mah:TextBoxHelper.Watermark="En (px)"/>
                                            <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" Margin="10,0" Foreground="{DynamicResource SecondaryText}" FontSize="18"/>
                                            <TextBox Grid.Column="2" x:Name="TxtHeight" Style="{StaticResource RoundedTextBox}" Height="36" mah:TextBoxHelper.Watermark="Boy (px)"/>
                                        </Grid>
                                        
                                        <CheckBox x:Name="ChkKeepAspect" Content="En/Boy Oranını Koru" IsChecked="True" Margin="0,0,0,20"/>

                                        <Separator Margin="0,10" Background="{DynamicResource CardBorderBrush}"/>
                                        
                                        <TextBlock Text="AI Upscaling (2x)" FontWeight="Bold" Margin="0,15,0,8"/>
                                        <TextBlock Text="Lanczos algoritması ile detayları kaybetmeden büyütme sağlar." FontSize="11" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,15" LineHeight="16"/>
                                        <CheckBox x:Name="ChkUpscale" Content="Akıllı Upscale Uygula" Margin="0,0,0,5"/>
                                    </StackPanel>
                                </TabItem>

                                <!-- Watermark -->
                                <TabItem Header="Filigran">
                                    <StackPanel Margin="0,15,0,0">
                                        <TextBlock Text="Filigran Türü" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,8" FontSize="11"/>
                                        <ComboBox x:Name="CmbWatermarkType" Height="36" Margin="0,0,0,15">
                                            <ComboBoxItem Content="Metin" IsSelected="True"/>
                                            <ComboBoxItem Content="Görsel (Logo)"/>
                                        </ComboBox>

                                        <TextBlock Text="Metin İçeriği" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,8" FontSize="11"/>
                                        <TextBox x:Name="TxtWatermarkText" Style="{StaticResource RoundedTextBox}" mah:TextBoxHelper.Watermark="© SwissKnife App" Height="36" Margin="0,0,0,15"/>
                                        
                                        <TextBlock Text="Boyut ve Şeffaflık" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,8" FontSize="11"/>
                                        <Slider x:Name="SldWatermarkFontSize" Minimum="10" Maximum="200" Value="40" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,10"/>
                                        <Slider x:Name="SldWatermarkOpacity" Minimum="0" Maximum="1" Value="0.8" SmallChange="0.1" Margin="0,0,0,15"/>

                                        <TextBlock Text="Renk" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,8" FontSize="11"/>
                                        <ComboBox x:Name="CmbWatermarkColor" Height="36" Margin="0,0,0,15">
                                            <ComboBoxItem Content="Beyaz" IsSelected="True" Tag="#FFFFFF"/>
                                            <ComboBoxItem Content="Siyah" Tag="#000000"/>
                                            <ComboBoxItem Content="Kırmızı" Tag="#FF0000"/>
                                            <ComboBoxItem Content="Mavi" Tag="#0000FF"/>
                                        </ComboBox>

                                        <TextBlock Text="Hizalama" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,8" FontSize="11"/>
                                        <ComboBox x:Name="CmbWatermarkPos" Height="36" SelectedIndex="0">
                                            <ComboBoxItem Content="Sağ Alt" Tag="BottomRight"/>
                                            <ComboBoxItem Content="Merkez" Tag="Center"/>
                                            <ComboBoxItem Content="Sol Alt" Tag="BottomLeft"/>
                                            <ComboBoxItem Content="Sağ Üst" Tag="TopRight"/>
                                        </ComboBox>
                                    </StackPanel>
                                </TabItem>
                                
                                <!-- AI Tools -->
                                <TabItem Header="Yapay Zeka">
                                    <StackPanel Margin="0,15,0,0">
                                        <TextBlock Text="Arka Plan Kaldırma" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <TextBlock Text="Remove.bg API entegrasyonu ile görsellerin arka planını tek tıkla temizleyin." FontSize="11" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,15" LineHeight="16"/>
                                        
                                        <PasswordBox x:Name="PbRemoveBgKey" mah:TextBoxHelper.Watermark="API Key Giriniz..." Height="36" Style="{StaticResource MahApps.Styles.PasswordBox.Button.Revealed}" Margin="0,0,0,15"/>
                                        <Button x:Name="BtnRemoveBg" Content="Arka Planı Temizle" Style="{StaticResource OutlineButtonStyle}" Height="40" Click="BtnRemoveBg_Click"/>
                                    </StackPanel>
                                </TabItem>
                            </mah:MetroAnimatedSingleRowTabControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sidebar Footer: Process Button -->
                    <Border Grid.Row="1" Padding="20" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <TextBlock Text="Çıktı Klasörü" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,8" FontSize="11"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtOutputPath" Style="{StaticResource RoundedTextBox}" mah:TextBoxHelper.Watermark="Klasör seçilmedi..." IsReadOnly="True" Height="36" Margin="0,0,8,0"/>
                                <Button Content="..." Width="36" Height="36" Style="{StaticResource OutlineButtonStyle}" Click="BtnSelectFolder_Click"/>
                            </Grid>
                            
                            <Button Style="{StaticResource AccentButtonStyle}" Height="50" Click="BtnProcess_Click">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Flash" Width="20" Height="20" Margin="0,0,10,0"/>
                                    <TextBlock Text="İşlemleri Başlat" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Content: List & Preview -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.5*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- List Card -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource AppBackground}" Padding="15,10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Text="Görsel Listesi" FontWeight="Bold" Foreground="{DynamicResource HeaderText}"/>
                        </Border>
                        <DataGrid x:Name="DgImages" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="DgImages_SelectionChanged" 
                                  BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Önizleme" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="5" Background="White">
                                                <Image Source="{Binding Thumbnail}" Width="40" Height="40" Stretch="UniformToFill"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Dosya Adı" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Orijinal Boyut" Binding="{Binding OriginalSizeText}" Width="110"/>
                                <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Tamamlandı">
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Splitter -->
                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent"/>

                <!-- Preview & Info -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Background="{DynamicResource AppBackground}" Padding="15">
                        <Grid>
                            <Image x:Name="ImgPreview" Stretch="Uniform"/>
                            <TextBlock Text="Önizleme yükleniyor..." VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryText}" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="15,0,0,0" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Metadata &amp; EXIF" Style="{StaticResource SectionHeader}"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="IcMetadata">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Key}" Foreground="{DynamicResource SecondaryText}" FontSize="12" VerticalAlignment="Top"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource HeaderText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Top"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Progress Overlay -->
        <Border x:Name="PrProcessing" Grid.Row="1" Background="{DynamicResource AppBackground}" Opacity="0.7" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <mah:ProgressRing Width="60" Height="60" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="Resimler İşleniyor..." Margin="0,20,0,0" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource HeaderText}"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
