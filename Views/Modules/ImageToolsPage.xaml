<Page x:Class="SwissKnifeApp.Views.Modules.ImageToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:local="clr-namespace:SwissKnifeApp.Views.Modules"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1100"
      Title="Gelişmiş Görsel Araçları">

    <Grid Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,15" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="ImageEdit" Width="24" Height="24" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="Gelişmiş Görsel Araçları" FontSize="20" FontWeight="Bold" Margin="15,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnAddImages" Style="{StaticResource AccentButtonStyle}" Click="BtnAddImages_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Plus" Width="14" Height="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Görsel Ekle"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource OutlineButtonStyle}" Margin="10,0,0,0" Click="BtnClear_Click">
                        <iconPacks:PackIconMaterial Kind="Delete" Width="14" Height="14"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar: Actions & Settings -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <mah:MetroAnimatedSingleRowTabControl x:Name="TabSettings" mah:HeaderedControlHelper.HeaderFontSize="12">
                            
                            <!-- Convert & Optimize -->
                            <TabItem Header="Dönüştür">
                                <StackPanel Margin="0,15,0,0">
                                    <TextBlock Text="Hedef Format" Foreground="Gray" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbFormat" Margin="0,0,0,15">
                                        <ComboBoxItem Content="JPG" IsSelected="True"/>
                                        <ComboBoxItem Content="PNG"/>
                                        <ComboBoxItem Content="WEBP"/>
                                        <ComboBoxItem Content="BMP"/>
                                        <ComboBoxItem Content="GIF"/>
                                        <ComboBoxItem Content="ICO"/>
                                    </ComboBox>

                                    <TextBlock Text="Kalite (%)" Foreground="Gray" Margin="0,0,0,5"/>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="SldQuality" Minimum="1" Maximum="100" Value="85"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ElementName=SldQuality, Path=Value, StringFormat={}{0:0}}" Margin="10,0,0,0" Width="25"/>
                                    </Grid>

                                    <CheckBox x:Name="ChkOptimize" Content="Optimizasyon Uygula (Kayıpsız)" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="ChkStripMetadata" Content="Metadataları Temizle" Margin="0,0,0,20"/>
                                    
                                    <Button Content="Dönüştürmeyi Başlat" Style="{StaticResource AccentButtonStyle}" Height="40" Click="BtnProcess_Click"/>
                                </StackPanel>
                            </TabItem>

                            <!-- Resize & Upscale -->
                            <TabItem Header="Boyut">
                                <StackPanel Margin="0,15,0,0">
                                    <TextBlock Text="Yeniden Boyutlandır" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtWidth" mah:TextBoxHelper.Watermark="Genişlik"/>
                                        <TextBlock Grid.Column="1" Text="x" VerticalAlignment="Center" Margin="5,0"/>
                                        <TextBox Grid.Column="2" x:Name="TxtHeight" mah:TextBoxHelper.Watermark="Yükseklik"/>
                                    </Grid>
                                    
                                    <CheckBox x:Name="ChkKeepAspect" Content="Oranları Koru" IsChecked="True" Margin="0,0,0,15"/>

                                    <Separator Margin="0,10"/>
                                    
                                    <TextBlock Text="AI Upscaling (2x)" FontWeight="SemiBold" Margin="0,10,0,5"/>
                                    <TextBlock Text="Düşük çözünürlüklü görselleri keskinleştirir." FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="ChkUpscale" Content="Upscale Uygula (Lanczos)" Margin="0,0,0,15"/>
                                </StackPanel>
                            </TabItem>

                            <!-- Watermark -->
                            <TabItem Header="Filigran">
                                <StackPanel Margin="0,15,0,0">
                                    <TextBlock Text="Filigran Türü" Foreground="Gray" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbWatermarkType" Margin="0,0,0,10">
                                        <ComboBoxItem Content="Metin" IsSelected="True"/>
                                        <ComboBoxItem Content="Görsel"/>
                                    </ComboBox>

                                    <TextBox x:Name="TxtWatermarkText" mah:TextBoxHelper.Watermark="Filigran metni..." Margin="0,0,0,10"/>
                                    
                                    <TextBlock Text="Yazı Boyutu" Foreground="Gray" Margin="0,5,0,5"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="SldWatermarkFontSize" Minimum="10" Maximum="200" Value="40" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ElementName=SldWatermarkFontSize, Path=Value, StringFormat={}{0:0}}" Margin="10,0,0,0" Width="25"/>
                                    </Grid>

                                    <TextBlock Text="Yazı Rengi" Foreground="Gray" Margin="0,5,0,5"/>
                                    <ComboBox x:Name="CmbWatermarkColor" Margin="0,0,0,10">
                                        <ComboBoxItem Content="Beyaz" IsSelected="True" Tag="#FFFFFF"/>
                                        <ComboBoxItem Content="Siyah" Tag="#000000"/>
                                        <ComboBoxItem Content="Kırmızı" Tag="#FF0000"/>
                                        <ComboBoxItem Content="Sarı" Tag="#FFFF00"/>
                                        <ComboBoxItem Content="Mavi" Tag="#0000FF"/>
                                        <ComboBoxItem Content="Yeşil" Tag="#008000"/>
                                    </ComboBox>

                                    <TextBlock Text="Saydamlık" Foreground="Gray" Margin="0,5,0,5"/>
                                    <Slider x:Name="SldWatermarkOpacity" Minimum="0" Maximum="1" Value="0.8" SmallChange="0.1"/>

                                    <TextBlock Text="Konum" Foreground="Gray" Margin="0,10,0,5"/>
                                    <ComboBox x:Name="CmbWatermarkPos" Margin="0,0,0,15">
                                        <ComboBoxItem Content="Sağ Alt" IsSelected="True" Tag="BottomRight"/>
                                        <ComboBoxItem Content="Merkez" Tag="Center"/>
                                        <ComboBoxItem Content="Sol Alt" Tag="BottomLeft"/>
                                        <ComboBoxItem Content="Sağ Üst" Tag="TopRight"/>
                                    </ComboBox>
                                </StackPanel>
                            </TabItem>
                            
                            <!-- AI Tools -->
                            <TabItem Header="Yapay Zeka">
                                <StackPanel Margin="0,15,0,0">
                                    <TextBlock Text="Arka Plan Kaldırma" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBlock Text="Sadece seçili görsel için çalışır. Remove.bg API anahtarı gerektirir." FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    
                                    <PasswordBox x:Name="PbRemoveBgKey" mah:TextBoxHelper.Watermark="API Key" Margin="0,0,0,10"/>
                                    <Button x:Name="BtnRemoveBg" Content="Arka Planı Kaldır" Style="{StaticResource OutlineButtonStyle}" Click="BtnRemoveBg_Click"/>
                                </StackPanel>
                            </TabItem>

                        </mah:MetroAnimatedSingleRowTabControl>
                        
                        <Separator Margin="0,20"/>
                        
                        <TextBlock Text="Kaydetme Seçenekleri" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBox x:Name="TxtOutputPath" mah:TextBoxHelper.Watermark="Seçilmedi..." IsReadOnly="True" Margin="0,0,0,5"/>
                        <Button Content="Klasör Seç" Style="{StaticResource OutlineButtonStyle}" Click="BtnSelectFolder_Click"/>
                        
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Content: List & Preview -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- List -->
                <Border Grid.Row="0" Margin="15" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <DataGrid x:Name="DgImages" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="DgImages_SelectionChanged" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Önizleme" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Thumbnail}" Width="40" Height="40" Margin="5"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Dosya Adı" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Orijinal Boyut" Binding="{Binding OriginalSizeText}" Width="100"/>
                            <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Tamamlandı">
                                                <Setter Property="Foreground" Value="Green"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Splitter -->
                <GridSplitter Grid.Row="1" Height="3" HorizontalAlignment="Stretch" Background="#EEE"/>

                <!-- Preview & Info -->
                <Grid Grid.Row="2" Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>

                    <Border CornerRadius="8" Background="#F8F9FA" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <Image x:Name="ImgPreview" Stretch="Uniform" Margin="10"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="15,0,0,0">
                        <TextBlock Text="Görsel Bilgileri &amp; EXIF" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="IcMetadata">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Key}" Foreground="Gray" FontSize="11" Width="80"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Progress Overlay -->
        <mah:ProgressRing x:Name="PrProcessing" Grid.Row="1" Grid.ColumnSpan="2" Width="60" Height="60" Visibility="Collapsed"/>
    </Grid>
</Page>
