<Page x:Class="SwissKnifeApp.Views.Modules.ColorPickerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1000"
      Background="{DynamicResource AppBackground}"
      Title="Renk Seçici">

    <Page.Resources>
        <!-- Purple/Lavender accent for this module -->
        <SolidColorBrush x:Key="ModuleAccent" Color="#7C4DFF"/>
    </Page.Resources>

    <Grid Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Modern Header -->
        <Border Grid.Row="0" Padding="25,20" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Palette" Width="32" Height="32" VerticalAlignment="Center" Foreground="{DynamicResource ModuleAccent}"/>
                    <TextBlock Text="Renk Seçici" FontSize="24" FontWeight="Bold" Margin="15,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource HeaderText}"/>
                </StackPanel>
                <TextBlock Text="Ekrandan veya paletten renk seçin, kod bloklarını kopyalayın" FontSize="14" Foreground="{DynamicResource SecondaryText}" Margin="47,5,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel MaxWidth="1000">
                
                <!-- Main Picker Control -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Renk Seçimi" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource HeaderText}" Margin="0,0,0,5"/>
                                <TextBlock Text="Damlalık ile ekranın herhangi bir yerinden renk alabilirsiniz." Foreground="{DynamicResource SecondaryText}" FontSize="13"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="BtnEyedropper" Style="{StaticResource AccentButtonStyle}" Padding="20,10" Click="BtnEyedropper_Click">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Eyedropper" Width="18" Height="18" Margin="0,0,10,0"/>
                                    <TextBlock Text="Damlalık ile Seç" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Text="Hızlı Palet" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource HeaderText}" Margin="0,0,0,10"/>
                        <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,25">
                            <WrapPanel x:Name="ColorSamplePanel">
                                <!-- Renk örnekleri dinamik olarak eklenecek -->
                            </WrapPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Color Preview -->
                            <StackPanel Grid.Column="0" Margin="0,0,30,0">
                                <TextBlock Text="Seçilen Renk" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource HeaderText}" Margin="0,0,0,10"/>
                                <Border Width="120" Height="120" CornerRadius="12" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="3">
                                    <Rectangle x:Name="SelectedColorRect" Fill="{DynamicResource ModuleAccent}" RadiusX="9" RadiusY="9"/>
                                </Border>
                            </StackPanel>

                            <!-- Color Codes -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="HEX Kodu" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}"/>
                                    <TextBox Grid.Column="1" x:Name="HexCodeBox" Style="{StaticResource RoundedTextBox}" IsReadOnly="True" Height="40" FontSize="15" FontWeight="Bold"/>
                                    <Button Grid.Column="2" x:Name="BtnCopyHex" Style="{StaticResource OutlineButtonStyle}" Width="40" Height="40" Margin="10,0,0,0" Click="BtnCopyHex_Click" ToolTip="Kopyala">
                                        <iconPacks:PackIconMaterial Kind="ContentCopy" Width="14" Height="14"/>
                                    </Button>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="RGB Kodu" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}"/>
                                    <TextBox Grid.Column="1" x:Name="RgbCodeBox" Style="{StaticResource RoundedTextBox}" IsReadOnly="True" Height="40" FontSize="15" FontWeight="Bold"/>
                                    <Button Grid.Column="2" x:Name="BtnCopyRgb" Style="{StaticResource OutlineButtonStyle}" Width="40" Height="40" Margin="10,0,0,0" Click="BtnCopyRgb_Click" ToolTip="Kopyala">
                                        <iconPacks:PackIconMaterial Kind="ContentCopy" Width="14" Height="14"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Code Generation Section -->
                <TextBlock Text="Geliştirici Kod Blokları" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource HeaderText}" Margin="0,0,0,15"/>
                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="5">
                    <TabControl x:Name="CodeTabControl" Background="Transparent" BorderThickness="0" mah:HeaderedControlHelper.HeaderFontSize="14">
                        <!-- Kod blokları dinamik olarak eklenecek -->
                    </TabControl>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

