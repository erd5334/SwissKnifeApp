<Page x:Class="SwissKnifeApp.Views.Modules.ColorPickerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d"
      Title="Renk Seçici">
    <Page.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#7C4DFF"/>
        <SolidColorBrush x:Key="AccentBrush2" Color="#512DA8"/>
    </Page.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Başlık ve ikon -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18" VerticalAlignment="Center">
            <iconPacks:PackIconMaterial Kind="Palette" Width="32" Height="32" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="Renk Seçici" FontSize="24" FontWeight="Bold" Margin="10,0,0,0" Foreground="{StaticResource AccentBrush2}"/>
        </StackPanel>
        <!-- Kart: Renk seçici ve örnekler -->
    <Border Grid.Row="1" Background="#F3E5F5" CornerRadius="14" Padding="24" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
            <StackPanel>
                <Button x:Name="BtnEyedropper" Style="{StaticResource AccentButtonStyle}" Margin="0,0,0,10" Click="BtnEyedropper_Click">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Eyedropper" Width="20" Height="20" Margin="0,0,8,0"/>
                        <TextBlock Text="Damlalık ile Renk Seç" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="Bir alana tıklayarak renk seçin veya damlalık ile ekranın herhangi bir yerinden renk alın." FontWeight="SemiBold" Foreground="#512DA8"/>
                <WrapPanel Margin="0,12,0,12" x:Name="ColorSamplePanel">
                    <!-- Renk örnekleri dinamik olarak eklenecek -->
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Seçilen Renk:" FontWeight="SemiBold"/>
                    <Border Width="36" Height="36" CornerRadius="8" BorderBrush="#512DA8" BorderThickness="2" Margin="10,0,0,0">
                        <Rectangle x:Name="SelectedColorRect" Width="32" Height="32" Stroke="Black"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="HEX:" FontWeight="SemiBold"/>
                    <TextBox x:Name="HexCodeBox" Width="100" Margin="5,0,0,0" IsReadOnly="True" Style="{StaticResource RoundedTextBox}"/>
                    <Button x:Name="BtnCopyHex" Style="{StaticResource OutlineButtonStyle}" Margin="5,0,0,0" Click="BtnCopyHex_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ContentCopy" Width="16" Height="16" Margin="5,0,4,0"/>
                            <TextBlock Text="Kopyala" Width="40"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="RGB:" FontWeight="SemiBold"/>
                    <TextBox x:Name="RgbCodeBox" Width="120" Margin="5,0,0,0" IsReadOnly="True" Style="{StaticResource RoundedTextBox}"/>
                    <Button x:Name="BtnCopyRgb" Style="{StaticResource OutlineButtonStyle}" Margin="5,0,0,0" Click="BtnCopyRgb_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ContentCopy" Width="16" Height="16" Margin="5,0,4,0"/>
                            <TextBlock Text="Kopyala" Width="40"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
        <!-- Kod blokları için ayrı kart -->
    <Border Grid.Row="2" Background="#ede7f6" CornerRadius="12" Padding="18" BorderBrush="{StaticResource AccentBrush2}" BorderThickness="1" Margin="0,20,0,0">
            <TabControl x:Name="CodeTabControl" Background="Transparent" BorderThickness="0">
                <!-- Kod blokları dinamik olarak eklenecek -->
            </TabControl>
        </Border>
    </Grid>
</Page>
