<Page x:Class="SwissKnifeApp.Views.Modules.TaxCalculatorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:local="clr-namespace:SwissKnifeApp.Views.Modules"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1100"
      Title="Vergi Hesaplayıcı"
      Background="{DynamicResource AppBackground}">

    <Page.Resources>
        <!-- Local override to give Tax module a consistent Gold theme -->
        <SolidColorBrush x:Key="AccentBrush" Color="{Binding Source={StaticResource TaxAccent}, Path=Color}"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Modern Header -->
        <Border Grid.Row="0" Padding="25,20" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="CalculatorVariant" Width="30" Height="30" VerticalAlignment="Center" Foreground="{StaticResource TaxAccent}"/>
                        <TextBlock Text="Vergi Hesaplayıcı" FontSize="24" FontWeight="Bold" Margin="15,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource HeaderText}"/>
                    </StackPanel>
                    <TextBlock Text="Gelir, KDV, Kurumlar ve Kira Vergisi hesaplamalarınızı kolayca yapın" FontSize="14" Foreground="{DynamicResource SecondaryText}" Margin="45,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnSettings" Click="BtnSettings_Click" Style="{StaticResource OutlineButtonStyle}" Width="Auto" Height="40" Padding="20,0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Cog" Width="18" Height="18" Margin="0,0,10,0"/>
                            <TextBlock Text="Ayarlar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnRefreshRates" Click="BtnRefreshRates_Click" Style="{StaticResource AccentButtonStyle}" Width="Auto" Height="40" Padding="20,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Refresh" Width="18" Height="18" Margin="0,0,10,0"/>
                            <TextBlock Text="Oranları Güncelle" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="25">
            <StackPanel MaxWidth="1000" HorizontalAlignment="Left" Width="900">
                
                <!-- Info Section -->
                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,25">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="Information" Width="18" Height="18" Foreground="{StaticResource TaxAccent}" Margin="0,0,12,0"/>
                            <TextBlock Text="Hesaplamalar resmi verilere göre yapılmaktadır." VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/>
                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="15,0" Height="15"/>
                            <TextBlock Text="Son Güncelleme:" Foreground="{DynamicResource SecondaryText}"/>
                            <TextBlock x:Name="TxtLastUpdate" Text="Yükleniyor..." FontWeight="SemiBold" Foreground="{DynamicResource HeaderText}" Margin="5,0,0,0"/>
                        </StackPanel>
                        
                        <Border Grid.Column="1" Background="#18FFC107" BorderBrush="#30FFC107" BorderThickness="1" CornerRadius="4" Padding="10,5">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="AlertCircle" Width="14" Height="14" Foreground="#FFC107" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Bilgilendirme amaçlıdır." FontSize="11" Foreground="#FFC107" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Tabs Container -->
                <Border Style="{StaticResource Card}" Padding="0">
                    <mah:MetroAnimatedSingleRowTabControl mah:HeaderedControlHelper.HeaderFontSize="14" Background="Transparent" BorderThickness="0">
                        <TabControl.Resources>
                            <Style TargetType="TabItem" BasedOn="{StaticResource MahApps.Styles.TabItem}">
                                <Setter Property="Padding" Value="20,10"/>
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                            </Style>
                        </TabControl.Resources>
            
                        <!-- Gelir Vergisi -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ChartBar" Width="18" Height="18" Margin="0,0,10,0"/>
                                    <TextBlock Text="Gelir Vergisi"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="20">
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Vergi Yılı" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="CmbIncomeYear" Height="45" SelectionChanged="CmbIncomeYear_SelectionChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="Gelir Türü" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="CmbIncomeType" Height="45">
                                                <ComboBoxItem Content="Ücret Geliri" Tag="ucret" IsSelected="True"/>
                                                <ComboBoxItem Content="Ücret Dışı Gelir" Tag="ucretdisi"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Vergi Matrahı (TL)" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <mah:NumericUpDown x:Name="NumIncomeMatrah" Minimum="0" Maximum="999999999" Interval="1000" StringFormat="N2" Height="45" Margin="0,0,0,20"/>

                                    <Button Click="BtnCalculateIncomeTax_Click" Style="{StaticResource AccentButtonStyle}" Height="45" Margin="0,0,0,25">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Calculator" Width="20" Height="20" Margin="0,0,10,0"/>
                                            <TextBlock Text="HESAPLA" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>

                                    <Border x:Name="IncomeTaxResult" Visibility="Collapsed" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="25">
                                        <StackPanel>
                                            <TextBlock Text="Hesaplama Sonucu" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource HeaderText}"/>
                                            
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Vergi Matrahı:" FontSize="14" Margin="0,8" Foreground="{DynamicResource SecondaryText}"/>
                                                <TextBlock x:Name="TxtIncomeMatrahResult" Grid.Row="0" Grid.Column="1" FontSize="14" FontWeight="Bold" Margin="0,8" Foreground="{DynamicResource HeaderText}"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Gelir Vergisi:" FontSize="14" Margin="0,8" Foreground="{DynamicResource SecondaryText}"/>
                                                <TextBlock x:Name="TxtIncomeTaxResult" Grid.Row="1" Grid.Column="1" FontSize="14" FontWeight="Bold" Foreground="#EF5350" Margin="0,8"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Net Tutar:" FontSize="16" FontWeight="Bold" Margin="0,15,0,8" Foreground="{DynamicResource HeaderText}"/>
                                                <TextBlock x:Name="TxtIncomeNetResult" Grid.Row="2" Grid.Column="1" FontSize="16" FontWeight="Bold" Foreground="#66BB6A" Margin="0,15,0,8"/>
                                            </Grid>

                                            <Separator Margin="0,20" Opacity="0.5"/>

                                            <TextBlock Text="Vergi Dilimleri Detayı" FontSize="14" FontWeight="Bold" Margin="0,0,0,15" Foreground="{DynamicResource HeaderText}"/>
                                            <ItemsControl x:Name="IncomeTaxBrackets">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,10" CornerRadius="8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock Text="{Binding Aciklama}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource HeaderText}"/>
                                                                    <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0">
                                                                        <Run Text="İlgili Matrah:"/>
                                                                        <Run Text="{Binding Matrah, StringFormat='{}{0:N2} TL'}" FontWeight="SemiBold"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding VergiTutari, StringFormat='{}{0:N2} TL'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TaxAccent}" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- KDV -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ReceiptText" Width="18" Height="18" Margin="0,0,10,0"/>
                                    <TextBlock Text="KDV"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="20">
                                    <TextBlock Text="Hesaplama Türü" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbKdvOperation" Height="45" SelectionChanged="CmbKdvOperation_SelectionChanged" Margin="0,0,0,15">
                                        <ComboBoxItem Content="KDV Dahil Hesaplama" Tag="dahil" IsSelected="True"/>
                                        <ComboBoxItem Content="KDV Hariç Hesaplama" Tag="haric"/>
                                    </ComboBox>

                                    <TextBlock Text="KDV Oranı" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbKdvRate" Height="45" Margin="0,0,0,15">
                                        <ComboBoxItem Content="%1" Tag="1"/>
                                        <ComboBoxItem Content="%8" Tag="8"/>
                                        <ComboBoxItem Content="%10" Tag="10"/>
                                        <ComboBoxItem Content="%18" Tag="18"/>
                                        <ComboBoxItem Content="%20" Tag="20" IsSelected="True"/>
                                    </ComboBox>

                                    <TextBlock Text="Tutar (TL)" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <mah:NumericUpDown x:Name="NumKdvAmount" Minimum="0" Maximum="999999999" Interval="100" StringFormat="N2" Height="45" Margin="0,0,0,20"/>

                                    <Button Click="BtnCalculateKdv_Click" Style="{StaticResource AccentButtonStyle}" Height="45" Margin="0,0,0,25">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Calculator" Width="20" Height="20" Margin="0,0,10,0"/>
                                            <TextBlock Text="HESAPLA" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>

                                    <Border x:Name="KdvResult" Visibility="Collapsed" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="25">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Net Tutar:" FontSize="14" Margin="0,8" Foreground="{DynamicResource SecondaryText}"/>
                                            <TextBlock x:Name="TxtKdvNetAmount" Grid.Row="0" Grid.Column="1" FontSize="14" FontWeight="Bold" Margin="0,8" Foreground="{DynamicResource HeaderText}"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="KDV Tutarı:" FontSize="14" Margin="0,8" Foreground="{DynamicResource SecondaryText}"/>
                                            <TextBlock x:Name="TxtKdvAmount" Grid.Row="1" Grid.Column="1" FontSize="14" FontWeight="Bold" Foreground="#EF5350" Margin="0,8"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Toplam:" FontSize="16" FontWeight="Bold" Margin="0,15,0,8" Foreground="{DynamicResource HeaderText}"/>
                                            <TextBlock x:Name="TxtKdvTotal" Grid.Row="2" Grid.Column="1" FontSize="16" FontWeight="Bold" Foreground="#66BB6A" Margin="0,15,0,8"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Kurumlar Vergisi -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="OfficeBuilding" Width="18" Height="18" Margin="0,0,10,0"/>
                                    <TextBlock Text="Kurumlar Vergisi"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="20">
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Vergi Yılı" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="CmbCorporateYear" Height="45" SelectionChanged="CmbCorporateYear_SelectionChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Bottom">
                                            <CheckBox x:Name="ChkFinancial" Content="Finans Kurumu" Height="45" VerticalContentAlignment="Center" Foreground="{DynamicResource HeaderText}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Safi Kurum Kazancı (TL)" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <mah:NumericUpDown x:Name="NumCorporateMatrah" Minimum="0" Maximum="999999999" Interval="10000" StringFormat="N2" Height="45" Margin="0,0,0,20"/>

                                    <Button Click="BtnCalculateCorporateTax_Click" Style="{StaticResource AccentButtonStyle}" Height="45" Margin="0,0,0,25">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Calculator" Width="20" Height="20" Margin="0,0,10,0"/>
                                            <TextBlock Text="HESAPLA" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>

                                    <Border x:Name="CorporateTaxResult" Visibility="Collapsed" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="25">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Safi Kurum Kazancı:" FontSize="14" Margin="0,8" Foreground="{DynamicResource SecondaryText}"/>
                                            <TextBlock x:Name="TxtCorporateMatrah" Grid.Row="0" Grid.Column="1" FontSize="14" FontWeight="Bold" Margin="0,8" Foreground="{DynamicResource HeaderText}"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Vergi Oranı:" FontSize="14" Margin="0,8" Foreground="{DynamicResource SecondaryText}"/>
                                            <TextBlock x:Name="TxtCorporateRate" Grid.Row="1" Grid.Column="1" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TaxAccent}" Margin="0,8"/>

                                            <Separator Grid.Row="2" Grid.ColumnSpan="2" Margin="0,15" Opacity="0.5"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Kurumlar Vergisi:" FontSize="16" FontWeight="Bold" Margin="0,8" Foreground="{DynamicResource HeaderText}"/>
                                            <TextBlock x:Name="TxtCorporateTax" Grid.Row="3" Grid.Column="1" FontSize="16" FontWeight="Bold" Foreground="#EF5350" Margin="0,8"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Kira Vergisi -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="HomeCity" Width="18" Height="18" Margin="0,0,10,0"/>
                                    <TextBlock Text="Kira Vergisi"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="20">
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Gelir Yılı" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="CmbRentYear" Height="45" SelectionChanged="CmbRentYear_SelectionChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <CheckBox x:Name="ChkRentExemption" Content="Konut İstisnası" IsChecked="True" Foreground="{DynamicResource HeaderText}"/>
                                            <TextBlock x:Name="TxtRentExemptionAmount" Text="(2026: 50.000 TL)" FontSize="10" Foreground="{DynamicResource SecondaryText}" Margin="25,2,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Yıllık Kira Geliri" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <mah:NumericUpDown x:Name="NumRentIncome" Minimum="0" Maximum="999999999" Interval="1000" StringFormat="N2" Height="45"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="Diğer Gelirler" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <mah:NumericUpDown x:Name="NumOtherIncome" Minimum="0" Maximum="999999999" Interval="1000" StringFormat="N2" Value="0" Height="45"/>
                                        </StackPanel>
                                    </Grid>

                                    <Button Click="BtnCalculateRentTax_Click" Style="{StaticResource AccentButtonStyle}" Height="45" Margin="0,0,0,25">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Calculator" Width="20" Height="20" Margin="0,0,10,0"/>
                                            <TextBlock Text="HESAPLA" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>

                                    <Border x:Name="RentTaxResult" Visibility="Collapsed" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="25">
                                        <StackPanel>
                                            <TextBlock Text="Hesaplama Sonucu" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource HeaderText}"/>
                                            
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Kira Geliri:" FontSize="14" Margin="0,8" Foreground="{DynamicResource SecondaryText}"/>
                                                <TextBlock x:Name="TxtRentIncomeResult" Grid.Row="0" Grid.Column="1" FontSize="14" FontWeight="Bold" Margin="0,8" Foreground="{DynamicResource HeaderText}"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Vergilendirilebilir Matrah:" FontSize="14" Margin="0,8" Foreground="{DynamicResource SecondaryText}"/>
                                                <TextBlock x:Name="TxtRentTaxableAmount" Grid.Row="1" Grid.Column="1" FontSize="14" FontWeight="Bold" Margin="0,8" Foreground="{DynamicResource HeaderText}"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Gelir Vergisi:" FontSize="14" Margin="0,8" Foreground="{DynamicResource SecondaryText}"/>
                                                <TextBlock x:Name="TxtRentTax" Grid.Row="2" Grid.Column="1" FontSize="14" FontWeight="Bold" Foreground="#EF5350" Margin="0,8"/>

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Net Kira Geliri:" FontSize="16" FontWeight="Bold" Margin="0,15,0,8" Foreground="{DynamicResource HeaderText}"/>
                                                <TextBlock x:Name="TxtRentNet" Grid.Row="3" Grid.Column="1" FontSize="16" FontWeight="Bold" Foreground="#66BB6A" Margin="0,15,0,8"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Damga Vergisi -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="FileDocumentOutline" Width="18" Height="18" Margin="0,0,10,0"/>
                                    <TextBlock Text="Damga Vergisi"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="20">
                                    <TextBlock Text="İşlem Tutarı (TL)" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <mah:NumericUpDown x:Name="NumStampAmount" Minimum="0" Maximum="999999999" Interval="1000" StringFormat="N2" Height="45" Margin="0,0,0,20"/>

                                    <Button Click="BtnCalculateStampTax_Click" Style="{StaticResource AccentButtonStyle}" Height="45" Margin="0,0,0,25">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Calculator" Width="20" Height="20" Margin="0,0,10,0"/>
                                            <TextBlock Text="HESAPLA" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>

                                    <Border x:Name="StampResult" Visibility="Collapsed" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="25">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="İşlem Tutarı:" FontSize="14" Margin="0,8" Foreground="{DynamicResource SecondaryText}"/>
                                            <TextBlock x:Name="TxtStampBase" Grid.Row="0" Grid.Column="1" FontSize="14" FontWeight="Bold" Margin="0,8" Foreground="{DynamicResource HeaderText}"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Damga Vergisi (‰0.948):" FontSize="14" Margin="0,8" Foreground="{DynamicResource SecondaryText}"/>
                                            <TextBlock x:Name="TxtStampTax" Grid.Row="1" Grid.Column="1" FontSize="14" FontWeight="Bold" Foreground="#EF5350" Margin="0,8"/>

