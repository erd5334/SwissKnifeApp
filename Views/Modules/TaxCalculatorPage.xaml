                                <StackPanel Margin="20">
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Miras Yılı" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="CmbInheritanceYear" Height="45">
                                                <ComboBoxItem Content="2026" Tag="2026" IsSelected="True"/>
                                                <ComboBoxItem Content="2025" Tag="2025"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="Mirasçı Türü" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="CmbHeirType" Height="45">
                                                <ComboBoxItem Content="Eş ve Çocuklar" Tag="escocuk" IsSelected="True"/>
                                                <ComboBoxItem Content="Diğer Mirasçılar" Tag="diger"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Miras Tutarı (TL)" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <mah:NumericUpDown x:Name="NumInheritanceAmount" Minimum="0" Maximum="999999999" Interval="10000" StringFormat="N2" Height="45" Margin="0,0,0,20"/>

                                    <Border Background="{DynamicResource AppBackground}" Padding="15" CornerRadius="8" Margin="0,0,0,25">
                                        <StackPanel>
                                            <TextBlock Text="2026 İstisna Tutarları:" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource HeaderText}" Margin="0,0,0,8"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <iconPacks:PackIconMaterial Kind="CircleSmall" Width="12" Height="12" Foreground="{StaticResource TaxAccent}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <TextBlock Text="Eş ve Çocuklar: 440.000 TL" FontSize="12" Foreground="{DynamicResource SecondaryText}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial Kind="CircleSmall" Width="12" Height="12" Foreground="{StaticResource TaxAccent}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <TextBlock Text="Diğer Mirasçılar: 110.000 TL" FontSize="12" Foreground="{DynamicResource SecondaryText}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Button Click="BtnCalculateInheritance_Click" Style="{StaticResource AccentButtonStyle}" Height="45" Margin="0,0,0,25">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Calculator" Width="20" Height="20" Margin="0,0,10,0"/>
                                            <TextBlock Text="HESAPLA" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>

                                    <Border x:Name="InheritanceResult" Visibility="Collapsed" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="25">
                                        <StackPanel>
                                            <TextBlock Text="Hesaplama Sonucu" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource HeaderText}"/>
                                            
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Miras Tutarı:" FontSize="14" Margin="0,8" Foreground="{DynamicResource SecondaryText}"/>
                                                <TextBlock x:Name="TxtInheritanceAmount" Grid.Row="0" Grid.Column="1" FontSize="14" FontWeight="Bold" Margin="0,8" Foreground="{DynamicResource HeaderText}"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Vergi Tutarı:" FontSize="14" Margin="0,8" Foreground="{DynamicResource SecondaryText}"/>
                                                <TextBlock x:Name="TxtInheritanceTax" Grid.Row="1" Grid.Column="1" FontSize="14" FontWeight="Bold" Foreground="#EF5350" Margin="0,8"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Net Miras:" FontSize="16" FontWeight="Bold" Margin="0,15,0,8" Foreground="{DynamicResource HeaderText}"/>
                                                <TextBlock x:Name="TxtInheritanceNet" Grid.Row="2" Grid.Column="1" FontSize="16" FontWeight="Bold" Foreground="#66BB6A" Margin="0,15,0,8"/>
                                            </Grid>

                                            <ItemsControl x:Name="InheritanceBrackets" Margin="0,15,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="12" Margin="0,5" CornerRadius="8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Aciklama}" FontSize="12" Foreground="{DynamicResource HeaderText}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding VergiTutari, StringFormat='{}{0:N2} TL'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TaxAccent}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Vergi Gecikme Faizi -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="TimerSand" Width="18" Height="18" Margin="0,0,10,0"/>
                                    <TextBlock Text="Gecikme Faizi"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="20">
                                    <TextBlock Text="Hesaplama Yılı" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbDelayYear" Height="45" Margin="0,0,0,15">
                                        <ComboBoxItem Content="2026" Tag="2026" IsSelected="True"/>
                                        <ComboBoxItem Content="2025" Tag="2025"/>
                                        <ComboBoxItem Content="2024" Tag="2024"/>
                                    </ComboBox>

                                    <Grid Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Vergi Borcu (TL)" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <mah:NumericUpDown x:Name="NumTaxDebt" Minimum="0" Maximum="999999999" Interval="1000" StringFormat="N2" Height="45"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="Gecikme Gün Sayısı" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <mah:NumericUpDown x:Name="NumDelayDays" Minimum="1" Maximum="3650" Interval="1" Height="45"/>
                                        </StackPanel>
                                    </Grid>

                                    <Button Click="BtnCalculateDelay_Click" Style="{StaticResource AccentButtonStyle}" Height="45" Margin="0,0,0,25">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Calculator" Width="20" Height="20" Margin="0,0,10,0"/>
                                            <TextBlock Text="HESAPLA" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>

                                    <Border x:Name="DelayResult" Visibility="Collapsed" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="25">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ana Borç:" FontSize="14" Margin="0,8" Foreground="{DynamicResource SecondaryText}"/>
                                            <TextBlock x:Name="TxtDelayDebt" Grid.Row="0" Grid.Column="1" FontSize="14" FontWeight="Bold" Margin="0,8" Foreground="{DynamicResource HeaderText}"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Gecikme Faizi:" FontSize="14" Margin="0,8" Foreground="{DynamicResource SecondaryText}"/>
                                            <TextBlock x:Name="TxtDelayInterest" Grid.Row="1" Grid.Column="1" FontSize="14" FontWeight="Bold" Foreground="#FFA000" Margin="0,8"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Toplam Ödenecek:" FontSize="16" FontWeight="Bold" Margin="0,15,0,8" Foreground="{DynamicResource HeaderText}"/>
                                            <TextBlock x:Name="TxtDelayTotal" Grid.Row="2" Grid.Column="1" FontSize="16" FontWeight="Bold" Foreground="#EF5350" Margin="0,15,0,8"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- YIL KARŞILAŞTIRMA -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ChartBoxPlusOutline" Width="18" Height="18" Margin="0,0,10,0"/>
                                    <TextBlock Text="Yıl Karşılaştırma"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="20">
                                    <TextBlock Text="Vergi Matrahı (TL)" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <mah:NumericUpDown x:Name="NumCompareMatrah" Minimum="0" Maximum="999999999" Interval="10000" StringFormat="N2" Height="45" Margin="0,0,0,15"/>

                                    <CheckBox x:Name="ChkCompareWage" Content="Ücret Geliri (Maaş)" IsChecked="True" Margin="0,0,0,20"/>

                                    <Button Click="BtnCompareYears_Click" Style="{StaticResource AccentButtonStyle}" Height="45" Margin="0,0,0,25">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="ChartBoxPlusOutline" Width="20" Height="20" Margin="0,0,10,0"/>
                                            <TextBlock Text="YILLARI KARŞILAŞTIR" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>

                                    <Border x:Name="CompareResult" Visibility="Collapsed" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                        <StackPanel>
                                            <TextBlock Text="Yıllara Göre Vergi Analizi" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource HeaderText}"/>
                                            
                                            <DataGrid x:Name="CompareGrid" 
                                                     AutoGenerateColumns="False" 
                                                     CanUserAddRows="False" 
                                                     IsReadOnly="True" 
                                                     MaxHeight="400"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     HorizontalGridLinesBrush="{DynamicResource CardBorderBrush}"
                                                     VerticalGridLinesBrush="{DynamicResource CardBorderBrush}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Yıl" Binding="{Binding Year}" Width="80"/>
                                                    <DataGridTextColumn Header="Matrah" Binding="{Binding Matrah, StringFormat=N0}" Width="*"/>
                                                    <DataGridTextColumn Header="Vergi" Binding="{Binding VergiTutari, StringFormat=N0}" Width="*"/>
                                                    <DataGridTextColumn Header="Net" Binding="{Binding NetTutar, StringFormat=N0}" Width="*"/>
                                                    <DataGridTextColumn Header="Oran %" Binding="{Binding EfektifVergiOrani, StringFormat=N2}" Width="100"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- VERGİ PLANLAMA -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Lightbulb" Width="18" Height="18" Margin="0,0,10,0"/>
                                    <TextBlock Text="Vergi Planlama"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="20">
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Planlama Yılı" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="CmbPlanYear" Height="45">
                                                <ComboBoxItem Content="2026" Tag="2026" IsSelected="True"/>
                                                <ComboBoxItem Content="2025" Tag="2025"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="Yıllık Brüt Gelir (TL)" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <mah:NumericUpDown x:Name="NumPlanIncome" Minimum="0" Maximum="999999999" Interval="10000" StringFormat="N2" Height="45"/>
                                        </StackPanel>
                                    </Grid>

                                    <Button Click="BtnPlanTax_Click" Style="{StaticResource AccentButtonStyle}" Height="45" Margin="0,0,0,25">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Lightbulb" Width="20" Height="20" Margin="0,0,10,0"/>
                                            <TextBlock Text="ANALİZ YAP" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>

                                    <Border x:Name="PlanResult" Visibility="Collapsed" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="25">
                                        <StackPanel>
                                            <TextBlock Text="Planlama Analiz Sonuçları" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource HeaderText}"/>
                                            
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Yıllık Toplam Gelir:" FontSize="14" Margin="0,8" Foreground="{DynamicResource SecondaryText}"/>
                                                <TextBlock x:Name="TxtPlanIncome" Grid.Row="0" Grid.Column="1" FontSize="14" FontWeight="Bold" Margin="0,8" Foreground="{DynamicResource HeaderText}"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Mevcut Vergi Yükü:" FontSize="14" Margin="0,8" Foreground="{DynamicResource SecondaryText}"/>
                                                <TextBlock x:Name="TxtPlanNormalTax" Grid.Row="1" Grid.Column="1" FontSize="14" FontWeight="Bold" Foreground="#EF5350" Margin="0,8"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Optimize Edilmiş Vergi:" FontSize="14" Margin="0,8" Foreground="{DynamicResource SecondaryText}"/>
                                                <TextBlock x:Name="TxtPlanSplitTax" Grid.Row="2" Grid.Column="1" FontSize="14" FontWeight="Bold" Margin="0,8" Foreground="{DynamicResource HeaderText}"/>

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="💰 Potansiyel Vergi Tasarrufu:" FontSize="16" FontWeight="Bold" Margin="0,15,0,8" Foreground="{DynamicResource HeaderText}"/>
                                                <TextBlock x:Name="TxtPlanSavings" Grid.Row="3" Grid.Column="1" FontSize="16" FontWeight="Bold" Foreground="#66BB6A" Margin="0,15,0,8"/>
                                            </Grid>

                                            <Separator Background="{DynamicResource CardBorderBrush}" Margin="0,15"/>

                                            <TextBlock Text="💡 Stratejik Öneriler" FontSize="14" FontWeight="Bold" Margin="0,0,0,15" Foreground="{DynamicResource HeaderText}"/>
                                            <ItemsControl x:Name="PlanRecommendations">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                            <iconPacks:PackIconMaterial Kind="CheckCircle" Width="14" Height="14" Foreground="#66BB6A" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource SecondaryText}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- VERGİ TAKVİMİ -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="CalendarAlert" Width="18" Height="18" Margin="0,0,10,0"/>
                                    <TextBlock Text="Vergi Takvimi"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="20">
                                    <Grid Margin="0,0,0,25">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Yaklaşan Vergi Tarihleri" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource HeaderText}"/>
                                            <TextBlock Text="Önemli beyanname ve ödeme sürelerini takip edin" FontSize="13" Foreground="{DynamicResource SecondaryText}" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Click="BtnExportTaxReport_Click" Style="{StaticResource OutlineButtonStyle}" Height="40" Padding="20,0">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial Kind="FileExcel" Width="18" Height="18" Foreground="#2E7D32" Margin="0,0,10,0"/>
                                                <TextBlock Text="Raporu Dışa Aktar" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    
                                    <ItemsControl x:Name="DeadlineList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,12" Padding="20,15" CornerRadius="12" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUrgent}" Value="True">
                                                                    <Setter Property="Background" Value="#10EF5350"/>
                                                                    <Setter Property="BorderBrush" Value="#40EF5350"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding VergiTuru}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource HeaderText}"/>
                                                            <TextBlock Text="{Binding Aciklama}" FontSize="13" Foreground="{DynamicResource SecondaryText}" Margin="0,5,0,8" TextWrapping="Wrap"/>
                                                            <StackPanel Orientation="Horizontal">
                                                                <iconPacks:PackIconMaterial Kind="CalendarAccount" Width="14" Height="14" Foreground="{StaticResource TaxAccent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock FontSize="12" Foreground="{DynamicResource HeaderText}" VerticalAlignment="Center">
                                                                    <Run Text="Son Tarih: " Foreground="{DynamicResource SecondaryText}"/>
                                                                    <Run Text="{Binding SonTarih, StringFormat=dd.MM.yyyy}" FontWeight="SemiBold"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" VerticalAlignment="Center" Padding="15,10" CornerRadius="8" MinWidth="80">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsUrgent}" Value="True">
                                                                            <Setter Property="Background" Value="#EF5350"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel HorizontalAlignment="Center">
                                                                <TextBlock FontSize="20" FontWeight="Bold" HorizontalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="{Binding KalanGun}"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource HeaderText}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsUrgent}" Value="True">
                                                                                    <Setter Property="Foreground" Value="White"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="GÜN KALDI" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsUrgent}" Value="True">
                                                                                    <Setter Property="Foreground" Value="White"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        </mah:MetroAnimatedSingleRowTabControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Grid.RowSpan="3" Background="#AA000000" Visibility="Collapsed">
            <Border Background="{DynamicResource CardBackground}" CornerRadius="15" Padding="40,30" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Width="300">
                <StackPanel>
                    <mah:ProgressRing IsActive="True" Foreground="{StaticResource TaxAccent}" Width="50" Height="50"/>
                    <TextBlock Text="Vergi Oranları Güncelleniyor" Foreground="{DynamicResource HeaderText}" FontSize="16" FontWeight="Bold" Margin="0,20,0,5" HorizontalAlignment="Center"/>
                    <TextBlock Text="Lütfen bekleyiniz..." Foreground="{DynamicResource SecondaryText}" FontSize="13" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
