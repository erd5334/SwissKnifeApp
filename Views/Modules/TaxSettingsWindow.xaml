<Window x:Class="SwissKnifeApp.Views.Modules.TaxSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Vergi Oranları Ayarları"
        Height="700"
        Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
        ShowInTaskbar="False"
        ResizeMode="CanResize">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentGoldBrush" Color="#FFD700"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Background="White" BorderBrush="{StaticResource AccentGoldBrush}" BorderThickness="2" CornerRadius="12" Padding="20" Margin="0,0,0,15">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Cog" Width="28" Height="28" Foreground="{StaticResource AccentGoldBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Vergi Oranları Ayarları" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentGoldBrush}"/>
                </StackPanel>
                <TextBlock Text="Manuel olarak vergi oranlarını düzenleyebilir ve güncelleyebilirsiniz" FontSize="13" Foreground="{DynamicResource MahApps.Brushes.Gray1}" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Tabs -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Background="White" BorderBrush="{StaticResource AccentGoldBrush}" BorderThickness="2" CornerRadius="12" Padding="20">
            <TabControl Style="{StaticResource MahApps.Styles.TabControl}">
                
                <!-- KDV Tevkifatı -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ScissorsCutting" Width="16" Height="16" Foreground="{StaticResource AccentGoldBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="KDV Tevkifatı"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="KDV Tevkifat Kategorileri" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        
                        <DataGrid Grid.Row="1" x:Name="DgKdvTevkifat" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  AlternatingRowBackground="{DynamicResource MahApps.Brushes.Gray10}"
                                  Margin="0,0,0,10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hizmet Tanımı" Binding="{Binding Tanim}" Width="*" IsReadOnly="False"/>
                                <DataGridTextColumn Header="KDV Oranı (%)" Binding="{Binding KdvOran}" Width="120" IsReadOnly="False"/>
                                <DataGridTextColumn Header="Tevkifat Oranı (%)" Binding="{Binding TevkifatOran}" Width="140" IsReadOnly="False"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnAddKdvTevkifat" Click="BtnAddKdvTevkifat_Click" Style="{StaticResource AccentButtonStyle}" Height="32" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Plus" Width="16" Height="16" Foreground="{StaticResource AccentGoldBrush}" Margin="5,0,8,0"/>
                                    <TextBlock Text="Ekle" Width="25"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnEditKdvTevkifat" Click="BtnEditKdvTevkifat_Click" Style="{StaticResource OutlineButtonStyle}" Height="32" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Pencil" Width="16" Height="16" Margin="5,0,8,0"/>
                                    <TextBlock Text="Düzenle" Width="40"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnDeleteKdvTevkifat" Click="BtnDeleteKdvTevkifat_Click" Style="{StaticResource OutlineButtonStyle}" Height="32">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Delete" Width="16" Height="16" Margin="5,0,8,0"/>
                                    <TextBlock Text="Sil" Width="20"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- MTV -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Car" Width="16" Height="16" Foreground="{StaticResource AccentGoldBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="MTV Otomobil"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Motorlu Taşıtlar Vergisi - Otomobil (2025)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        
                        <DataGrid Grid.Row="1" x:Name="DgMtvOtomobil" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  AlternatingRowBackground="{DynamicResource MahApps.Brushes.Gray10}"
                                  Margin="0,0,0,10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Alt (cc)" Binding="{Binding Alt}" Width="100" IsReadOnly="False"/>
                                <DataGridTextColumn Header="Üst (cc)" Binding="{Binding Ust}" Width="100" IsReadOnly="False"/>
                                <DataGridTextColumn Header="1 Yaş (TL)" Binding="{Binding Yil1}" Width="*" IsReadOnly="False"/>
                                <DataGridTextColumn Header="2 Yaş (TL)" Binding="{Binding Yil2}" Width="*" IsReadOnly="False"/>
                                <DataGridTextColumn Header="3 Yaş (TL)" Binding="{Binding Yil3}" Width="*" IsReadOnly="False"/>
                                <DataGridTextColumn Header="4 Yaş (TL)" Binding="{Binding Yil4}" Width="*" IsReadOnly="False"/>
                                <DataGridTextColumn Header="5+ Yaş (TL)" Binding="{Binding Yil5Plus}" Width="*" IsReadOnly="False"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnAddMtvCar" Click="BtnAddMtvCar_Click" Style="{StaticResource AccentButtonStyle}" Height="32" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Plus" Width="16" Height="16" Foreground="{StaticResource AccentGoldBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Ekle"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnEditMtvCar" Click="BtnEditMtvCar_Click" Style="{StaticResource OutlineButtonStyle}" Height="32" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Pencil" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Düzenle"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnDeleteMtvCar" Click="BtnDeleteMtvCar_Click" Style="{StaticResource OutlineButtonStyle}" Height="32">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Delete" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Sil"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Akaryakıt ÖTV -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="GasStation" Width="16" Height="16" Foreground="{StaticResource AccentGoldBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Akaryakıt ÖTV"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Akaryakıt Özel Tüketim Vergisi Oranları" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        
                        <DataGrid Grid.Row="1" x:Name="DgAkaryakit" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  AlternatingRowBackground="{DynamicResource MahApps.Brushes.Gray10}"
                                  Margin="0,0,0,10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Yakıt Türü" Binding="{Binding Tanim}" Width="*" IsReadOnly="False"/>
                                <DataGridTextColumn Header="Oran (TL/Litre)" Binding="{Binding Oran}" Width="200" IsReadOnly="False"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnAddFuel" Click="BtnAddFuel_Click" Style="{StaticResource AccentButtonStyle}" Height="32" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Plus" Width="16" Height="16" Foreground="{StaticResource AccentGoldBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Ekle"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnEditFuel" Click="BtnEditFuel_Click" Style="{StaticResource OutlineButtonStyle}" Height="32" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Pencil" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Düzenle"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnDeleteFuel" Click="BtnDeleteFuel_Click" Style="{StaticResource OutlineButtonStyle}" Height="32">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Delete" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Sil"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Emlak Vergisi -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="HomeModern" Width="16" Height="16" Foreground="{StaticResource AccentGoldBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Emlak Vergisi"/>
                        </StackPanel>
                    </TabItem.Header>
                    <StackPanel Margin="20">
                        <TextBlock Text="Emlak Vergisi Oranları (2025)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,15"/>
                        
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Bina Oranı (%)" FontSize="13" Margin="0,0,0,5"/>
                            <mah:NumericUpDown x:Name="NumBinaOran" Minimum="0" Maximum="10" Interval="0.01" StringFormat="N2" Value="0.2"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Arazi Oranı (%)" FontSize="13" Margin="0,0,0,5"/>
                            <mah:NumericUpDown x:Name="NumAraziOran" Minimum="0" Maximum="10" Interval="0.01" StringFormat="N2" Value="0.1"/>
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <!-- Gecikme Faizi -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="TimerSand" Width="16" Height="16" Foreground="{StaticResource AccentGoldBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Gecikme Faizi"/>
                        </StackPanel>
                    </TabItem.Header>
                    <StackPanel Margin="20">
                        <TextBlock Text="Vergi Gecikme Faizi Oranları" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,15"/>
                        
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="2025 Aylık Oran (%)" FontSize="13" Margin="0,0,0,5"/>
                            <mah:NumericUpDown x:Name="NumDelay2025" Minimum="0" Maximum="20" Interval="0.1" StringFormat="N1" Value="3.5"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="2024 Aylık Oran (%)" FontSize="13" Margin="0,0,0,5"/>
                            <mah:NumericUpDown x:Name="NumDelay2024" Minimum="0" Maximum="20" Interval="0.1" StringFormat="N1" Value="3.5"/>
                        </StackPanel>
                    </StackPanel>
                </TabItem>

            </TabControl>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="BtnSave" Content="Kaydet ve Uygula" Click="BtnSave_Click" Style="{StaticResource AccentButtonStyle}" Height="40" Padding="20,0" Margin="0,0,10,0">
                <Button.ContentTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ContentSave" Width="18" Height="18" Foreground="{StaticResource AccentGoldBrush}" Margin="5,0,10,0"/>
                            <TextBlock Text="{Binding}" Width="85"/>
                        </StackPanel>
                    </DataTemplate>
                </Button.ContentTemplate>
            </Button>
            <Button x:Name="BtnCancel" Click="BtnCancel_Click" Style="{StaticResource OutlineButtonStyle}" Height="40" Padding="20,0">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Cancel" Width="16" Height="16" Foreground="{StaticResource AccentGoldBrush}" Margin="5,0,8,0"/>
                    <TextBlock Text="İptal" Width="25"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
