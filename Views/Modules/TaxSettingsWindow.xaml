<Window x:Class="SwissKnifeApp.Views.Modules.TaxSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Vergi Oranları Ayarları"
        Height="700"
        Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        ShowInTaskbar="False"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Local override to give Tax module a consistent Gold theme -->
        <SolidColorBrush x:Key="AccentBrush" Color="{Binding Source={StaticResource TaxAccent}, Path=Color}"/>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Modern Header -->
        <Border Grid.Row="0" Margin="0,0,0,25" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="25,20">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Cog" Width="28" Height="28" Foreground="{StaticResource TaxAccent}" VerticalAlignment="Center"/>
                    <TextBlock Text="Vergi Oranları Ayarları" FontSize="22" FontWeight="Bold" Margin="15,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource HeaderText}"/>
                </StackPanel>
                <TextBlock Text="Manuel olarak vergi oranlarını düzenleyebilir ve güncelleyebilirsiniz" FontSize="13" Foreground="{DynamicResource SecondaryText}" Margin="43,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="15">
            <TabControl Style="{StaticResource MahApps.Styles.TabControl}">
                
                <!-- KDV Tevkifatı -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ScissorsCutting" Width="16" Height="16" Margin="0,0,10,0"/>
                            <TextBlock Text="KDV Tevkifatı"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="KDV Tevkifat Kategorileri" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,15" Foreground="{DynamicResource HeaderText}"/>
                        
                        <DataGrid Grid.Row="1" x:Name="DgKdvTevkifat" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  HorizontalGridLinesBrush="{DynamicResource CardBorderBrush}"
                                  VerticalGridLinesBrush="{DynamicResource CardBorderBrush}"
                                  Margin="0,0,0,15">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hizmet Tanımı" Binding="{Binding Tanim}" Width="*" IsReadOnly="False"/>
                                <DataGridTextColumn Header="KDV Oranı (%)" Binding="{Binding KdvOran}" Width="120" IsReadOnly="False"/>
                                <DataGridTextColumn Header="Tevkifat (%)" Binding="{Binding TevkifatOran}" Width="120" IsReadOnly="False"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnAddKdvTevkifat" Click="BtnAddKdvTevkifat_Click" Style="{StaticResource AccentButtonStyle}" Height="35" Width="100" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Plus" Width="14" Height="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="EKLE"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnEditKdvTevkifat" Click="BtnEditKdvTevkifat_Click" Style="{StaticResource OutlineButtonStyle}" Height="35" Width="100" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Pencil" Width="14" Height="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="DÜZENLE"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnDeleteKdvTevkifat" Click="BtnDeleteKdvTevkifat_Click" Style="{StaticResource OutlineButtonStyle}" Height="35" Width="100">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Delete" Width="14" Height="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="SİL"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- MTV -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Car" Width="16" Height="16" Margin="0,0,10,0"/>
                            <TextBlock Text="MTV Otomobil"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Motorlu Taşıtlar Vergisi - Otomobil (2026)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,15" Foreground="{DynamicResource HeaderText}"/>
                        
                        <DataGrid Grid.Row="1" x:Name="DgMtvOtomobil" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  HorizontalGridLinesBrush="{DynamicResource CardBorderBrush}"
                                  VerticalGridLinesBrush="{DynamicResource CardBorderBrush}"
                                  Margin="0,0,0,15">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Alt (cc)" Binding="{Binding Alt}" Width="80" IsReadOnly="False"/>
                                <DataGridTextColumn Header="Üst (cc)" Binding="{Binding Ust}" Width="80" IsReadOnly="False"/>
                                <DataGridTextColumn Header="1 Yaş" Binding="{Binding Yil1}" Width="*" IsReadOnly="False"/>
                                <DataGridTextColumn Header="2 Yaş" Binding="{Binding Yil2}" Width="*" IsReadOnly="False"/>
                                <DataGridTextColumn Header="3 Yaş" Binding="{Binding Yil3}" Width="*" IsReadOnly="False"/>
                                <DataGridTextColumn Header="4 Yaş" Binding="{Binding Yil4}" Width="*" IsReadOnly="False"/>
                                <DataGridTextColumn Header="5+ Yaş" Binding="{Binding Yil5Plus}" Width="*" IsReadOnly="False"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnAddMtvCar" Click="BtnAddMtvCar_Click" Style="{StaticResource AccentButtonStyle}" Height="35" Width="100" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Plus" Width="14" Height="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="EKLE"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnEditMtvCar" Click="BtnEditMtvCar_Click" Style="{StaticResource OutlineButtonStyle}" Height="35" Width="100" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Pencil" Width="14" Height="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="DÜZENLE"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnDeleteMtvCar" Click="BtnDeleteMtvCar_Click" Style="{StaticResource OutlineButtonStyle}" Height="35" Width="100">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Delete" Width="14" Height="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="SİL"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Akaryakıt ÖTV -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="GasStation" Width="16" Height="16" Margin="0,0,10,0"/>
                            <TextBlock Text="Akaryakıt ÖTV"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Akaryakıt Özel Tüketim Vergisi Oranları" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,15" Foreground="{DynamicResource HeaderText}"/>
                        
                        <DataGrid Grid.Row="1" x:Name="DgAkaryakit" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  HorizontalGridLinesBrush="{DynamicResource CardBorderBrush}"
                                  VerticalGridLinesBrush="{DynamicResource CardBorderBrush}"
                                  Margin="0,0,0,15">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Yakıt Türü" Binding="{Binding Tanim}" Width="*" IsReadOnly="False"/>
                                <DataGridTextColumn Header="Oran (TL/Litre)" Binding="{Binding Oran}" Width="200" IsReadOnly="False"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnAddFuel" Click="BtnAddFuel_Click" Style="{StaticResource AccentButtonStyle}" Height="35" Width="100" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Plus" Width="14" Height="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="EKLE"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnEditFuel" Click="BtnEditFuel_Click" Style="{StaticResource OutlineButtonStyle}" Height="35" Width="100" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Pencil" Width="14" Height="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="DÜZENLE"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnDeleteFuel" Click="BtnDeleteFuel_Click" Style="{StaticResource OutlineButtonStyle}" Height="35" Width="100">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Delete" Width="14" Height="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="SİL"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Emlak Vergisi -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="HomeModern" Width="16" Height="16" Margin="0,0,10,0"/>
                            <TextBlock Text="Emlak Vergisi"/>
                        </StackPanel>
                    </TabItem.Header>
                    <StackPanel Margin="20">
                        <TextBlock Text="Emlak Vergisi Oranları (2026)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,20" Foreground="{DynamicResource HeaderText}"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                <TextBlock Text="Bina Oranı (%)" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <mah:NumericUpDown x:Name="NumBinaOran" Minimum="0" Maximum="10" Interval="0.01" StringFormat="N2" Value="0.2" Height="45"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                <TextBlock Text="Arazi Oranı (%)" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <mah:NumericUpDown x:Name="NumAraziOran" Minimum="0" Maximum="10" Interval="0.01" StringFormat="N2" Value="0.1" Height="45"/>
                            </StackPanel>
                        </Grid>
                        
                        <Border Background="{DynamicResource AppBackground}" Padding="15" CornerRadius="8" Margin="0,25,0,0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Information" Width="16" Height="16" Foreground="{StaticResource TaxAccent}" Margin="0,0,10,0"/>
                                <TextBlock Text="Büyükşehir olan illerde bu oranlar %100 artırımlı uygulanır." FontSize="12" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- Gecikme Faizi -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="TimerSand" Width="16" Height="16" Margin="0,0,10,0"/>
                            <TextBlock Text="Gecikme Faizi"/>
                        </StackPanel>
                    </TabItem.Header>
                    <StackPanel Margin="20">
                        <TextBlock Text="Aylık Vergi Gecikme Zammı Oranları" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,20" Foreground="{DynamicResource HeaderText}"/>
                        
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="2026 Aylık Oran (%)" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <mah:NumericUpDown x:Name="NumDelay2026" Minimum="0" Maximum="20" Interval="0.1" StringFormat="N1" Value="4.5" Height="45"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="2025 Aylık Oran (%)" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <mah:NumericUpDown x:Name="NumDelay2025" Minimum="0" Maximum="20" Interval="0.1" StringFormat="N1" Value="3.5" Height="45"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="2024 Aylık Oran (%)" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <mah:NumericUpDown x:Name="NumDelay2024" Minimum="0" Maximum="20" Interval="0.1" StringFormat="N1" Value="3.5" Height="45"/>
                        </StackPanel>
                    </StackPanel>
                </TabItem>

            </TabControl>
        </Border>

        <!-- Final Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,25,0,0">
            <Button x:Name="BtnSave" Click="BtnSave_Click" Style="{StaticResource AccentButtonStyle}" Height="45" Padding="25,0" Margin="0,0,15,0">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="ContentSave" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="HAYATA GEÇİR" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnCancel" Click="BtnCancel_Click" Style="{StaticResource OutlineButtonStyle}" Height="45" Padding="25,0">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="CloseCircle" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="VAZGEÇ" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
