<Page x:Class="SwissKnifeApp.Views.Modules.DeveloperToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:local="clr-namespace:SwissKnifeApp.Views.Modules"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1000"
      Title="Developer Tools">

    <Grid Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,15" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="Tools" Width="24" Height="24" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="Giriştirici Araçları" FontSize="20" FontWeight="Bold" Margin="15,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource HeaderText}"/>
            </StackPanel>
        </Border>

        <!-- Content Tabs -->
        <mah:MetroAnimatedSingleRowTabControl Grid.Row="1" Margin="20" mah:HeaderedControlHelper.HeaderFontSize="15">
            
            <!-- GUID Generator -->
            <TabItem Header="GUID/UUID">
                <Grid Margin="10,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Adet" Foreground="Gray" Margin="0,0,0,5"/>
                            <mah:NumericUpDown x:Name="NumGuidCount" Value="10" Minimum="1" Maximum="1000" Width="100"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Format" Foreground="Gray" Margin="0,0,0,5"/>
                            <ComboBox x:Name="CmbGuidFormat" Width="150" SelectedIndex="0">
                                <ComboBoxItem Content="Diz Reçinesi (D)"/>
                                <ComboBoxItem Content="Parantezli (B)"/>
                                <ComboBoxItem Content="Küme Parantezli (P)"/>
                                <ComboBoxItem Content="Düz (N)"/>
                            </ComboBox>
                        </StackPanel>
                        <Button Click="BtnGenerateGuid_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" Height="34" Width="120">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Refresh" Width="14" Height="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Generate"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="TxtGuidList" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" 
                                 FontFamily="Consolas" IsReadOnly="True" Background="#F8F9FA" Padding="10"/>
                        <Button Grid.Row="1" Content="Hepsini Kopyala" Click="BtnCopyGuids_Click" HorizontalAlignment="Right" Margin="0,10,0,0" Style="{StaticResource OutlineButtonStyle}"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Timestamp Converter -->
            <TabItem Header="Timestamp">
                <StackPanel Margin="10,20" MaxWidth="800" HorizontalAlignment="Left">
                    <TextBlock Text="Unix Timestamp &lt;&gt; ISO 8601" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,20"/>
                    
                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Unix Timestamp (Seconds / Milliseconds)" Margin="0,0,0,5" Foreground="Gray"/>
                            <TextBox x:Name="TxtUnixInput" Height="40" VerticalContentAlignment="Center" FontSize="16" TextChanged="TxtUnixInput_TextChanged"/>
                        </StackPanel>
                        
                        <iconPacks:PackIconMaterial Kind="ArrowLeftRight" Grid.Column="1" VerticalAlignment="Center" Margin="20,20,20,0" Foreground="Gray"/>
                        
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ISO 8601 / Yerel Zaman" Margin="0,0,0,5" Foreground="Gray"/>
                            <TextBox x:Name="TxtIsoInput" Height="40" VerticalContentAlignment="Center" FontSize="16" TextChanged="TxtIsoInput_TextChanged"/>
                        </StackPanel>
                    </Grid>
                    
                    <Button Click="BtnGetNow_Click" Style="{StaticResource OutlineButtonStyle}" Width="150" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ClockOutline" Width="14" Height="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Şu An (Now)"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </TabItem>

            <!-- JWT Tools -->
            <TabItem Header="JWT Decoder">
                <Grid Margin="10,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Grid Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="JWT Token" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtJwtInput" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" 
                                 FontFamily="Consolas" mah:TextBoxHelper.Watermark="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                                 TextChanged="TxtJwtInput_TextChanged"/>
                    </Grid>
                    
                    <Grid Grid.Column="1" Margin="10,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="Header" FontWeight="SemiBold" Foreground="#FF4081" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtJwtHeader" Grid.Row="1" IsReadOnly="True" Height="100" FontFamily="Consolas" Background="#FFF5F8"/>
                        
                        <TextBlock Text="Payload / Claims" Grid.Row="2" FontWeight="SemiBold" Foreground="#2196F3" Margin="0,15,0,5"/>
                        <TextBox x:Name="TxtJwtPayload" Grid.Row="3" Grid.RowSpan="2" IsReadOnly="True" FontFamily="Consolas" Background="#F1F8FF" VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Cron Tester -->
            <TabItem Header="Cron Builder">
                <StackPanel Margin="10,20">
                    <TextBlock Text="Cron İfadesi Test Edici" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtCronExpression" Text="*/5 * * * *" Height="45" FontSize="18" VerticalContentAlignment="Center" 
                                 FontFamily="Consolas" TextChanged="TxtCronExpression_TextChanged"/>
                        <Button Grid.Column="1" Click="BtnCronHelp_Click" Style="{StaticResource MahApps.Styles.Button.Chromeless}" ToolTip="Örnekler">
                            <iconPacks:PackIconMaterial Kind="HelpCircleOutline" Width="20" Height="20" Foreground="Gray"/>
                        </Button>
                    </Grid>
                    
                    <Border Background="#E3F2FD" BorderBrush="#BBDEFB" BorderThickness="1" Padding="15" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="İnsan Gözüyle Okunuşu:" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,5"/>
                            <TextBlock x:Name="TxtCronDescription" Text="Şu an her 5 dakikada bir çalışır." FontSize="16" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- Lorem & Fake Data -->
            <TabItem Header="Fake Data">
                <Grid Margin="10,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="Ayarlar" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>
                        
                        <TextBlock Text="Ülke / Dil (Locale)" Margin="0,0,0,5" Foreground="Gray"/>
                        <ComboBox x:Name="CmbLocale" Margin="0,0,0,15">
                            <ComboBoxItem Content="Türkiye (tr)" Tag="tr"/>
                            <ComboBoxItem Content="USA (en)" Tag="en"/>
                            <ComboBoxItem Content="Germany (de)" Tag="de"/>
                            <ComboBoxItem Content="France (fr)" Tag="fr"/>
                            <ComboBoxItem Content="Great Britain (en_GB)" Tag="en_GB"/>
                        </ComboBox>
                        
                        <TextBlock Text="Veri Tipi" Margin="0,0,0,5" Foreground="Gray"/>
                        <ComboBox x:Name="CmbFakeDataType" Margin="0,0,0,15" SelectedIndex="0">
                            <ComboBoxItem Content="Kişi (İsim, Tel, Email)"/>
                            <ComboBoxItem Content="Adres (Sokak, Şehir, Posta)"/>
                            <ComboBoxItem Content="Şirket &amp; Meslek"/>
                            <ComboBoxItem Content="İnternet (URL, UserAgent)"/>
                            <ComboBoxItem Content="Finans (IBAN, Kart)"/>
                        </ComboBox>

                        <TextBlock Text="Doğum Tarihi Aralığı (Yıl)" Margin="0,0,0,5" Foreground="Gray"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <mah:NumericUpDown x:Name="NumBirthStart" Value="1980" Minimum="1900" Maximum="2100"/>
                            <TextBlock Grid.Column="1" Text="-" VerticalAlignment="Center" Margin="5,0"/>
                            <mah:NumericUpDown Grid.Column="2" x:Name="NumBirthEnd" Value="2005" Minimum="1900" Maximum="2100"/>
                        </Grid>

                        <TextBlock Text="Miktar" Margin="0,0,0,5" Foreground="Gray"/>
                        <mah:NumericUpDown x:Name="NumFakeCount" Value="10" Minimum="1" Maximum="100" Margin="0,0,0,20"/>
                        
                        <Button Click="BtnGenerateFake_Click" Style="{StaticResource AccentButtonStyle}" Height="40">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="LightningBolt" Width="14" Height="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Veri Üret"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="TxtFakeDataOutput" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" 
                                 FontFamily="Consolas" IsReadOnly="True" Background="#F8F9FA"/>
                        <Button Grid.Row="1" Content="Kopyala" Click="BtnCopyFake_Click" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                    </Grid>
                </Grid>
            </TabItem>
            
        </mah:MetroAnimatedSingleRowTabControl>
    </Grid>
</Page>
