<Page x:Class="SwissKnifeApp.Views.Modules.QrBarcodeToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:helpers="clr-namespace:SwissKnifeApp.Helpers"
      mc:Ignorable="d"
      Title="QR ve Barkod Araçları">

    <Page.Resources>
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <!-- QR/Barcode specific accent colors (Teal) -->
        <SolidColorBrush x:Key="AccentBrush" Color="#009688"/>
        <SolidColorBrush x:Key="AccentBrush2" Color="#00897B"/>

        <!-- Local Styles for Inputs -->
        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource HeaderText}"/>
        </Style>
    </Page.Resources>

    <Grid Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Modern Header -->
        <Border Grid.Row="0" Padding="25,20" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Qrcode" Width="30" Height="30" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="QR &amp; Barkod Araçları" FontSize="24" FontWeight="Bold" Margin="15,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource HeaderText}"/>
                </StackPanel>
                <TextBlock Text="QR kodlar ve barkodlar oluşturun, mevcut kodları tarayın ve kaydedin" FontSize="14" Foreground="{DynamicResource SecondaryText}" Margin="45,5,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel MaxWidth="1000" HorizontalAlignment="Left" Width="800">
                
                <!-- 1️⃣ QR Kod Sekmesi -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="QR Kod İşlemleri" Style="{StaticResource SectionHeader}"/>
                        
                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sol Taraf: Kontroller -->
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="QR Türü" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbQrType" SelectionChanged="CmbQrType_SelectionChanged" Margin="0,0,0,20">
                                    <ComboBoxItem Content="Metin / URL" IsSelected="True"/>
                                    <ComboBoxItem Content="Wi-Fi"/>
                                    <ComboBoxItem Content="vCard"/>
                                    <ComboBoxItem Content="E-posta"/>
                                </ComboBox>

                                <!-- Giriş Alanları (Dinamik) -->
                                <StackPanel x:Name="PanelInputFields" Margin="0,0,0,20"/>

                                <!-- QR Butonları -->
                                <Button x:Name="BtnGenerateQR" Click="BtnGenerateQR_Click" Style="{StaticResource AccentButtonStyle}" Height="45" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="QrcodePlus" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <TextBlock Text="QR Kod Oluştur" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnLoadImage" Grid.Column="0" Click="BtnLoadImage_Click" Style="{StaticResource OutlineButtonStyle}" Height="40" Margin="0,0,5,0">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial Kind="FolderImage" Width="16" Height="16" Margin="0,0,8,0"/>
                                                <TextBlock Text="Görsel Oku" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnSaveQR" Grid.Column="1" Click="BtnSaveQR_Click" Style="{StaticResource OutlineButtonStyle}" Height="40" Margin="5,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial Kind="ContentSave" Width="16" Height="16" Margin="0,0,8,0"/>
                                                <TextBlock Text="Kaydet" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                            </StackPanel>

                            <!-- Sağ Taraf: Önizleme & Sonuç -->
                            <StackPanel Grid.Column="1">
                                <Border Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Height="280">
                                    <Grid>
                                        <Image x:Name="ImgQrCode" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        
                                        <!-- Görsel yokken placeholder -->
                                        <StackPanel VerticalAlignment="Center" x:Name="QrPlaceholder" 
                                                    Visibility="{Binding Source={x:Reference ImgQrCode}, Path=Source, Converter={StaticResource NullToVisibilityConverter}}">
                                            <iconPacks:PackIconMaterial Kind="Qrcode" Width="60" Height="60" HorizontalAlignment="Center" Opacity="0.1" Foreground="{DynamicResource HeaderText}"/>
                                            <TextBlock Text="QR Kod Önizleme" HorizontalAlignment="Center" Margin="0,10,0,0" Opacity="0.3" Foreground="{DynamicResource HeaderText}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Okunan Veri" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,15,0,5"/>
                                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" MinHeight="60" Padding="12">
                                    <TextBlock x:Name="TxtDecoded" TextWrapping="Wrap" Foreground="{DynamicResource HeaderText}" FontSize="13" FontStyle="Italic"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2️⃣ Barkod Sekmesi -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Barkod İşlemleri" Style="{StaticResource SectionHeader}"/>

                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sol Taraf -->
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="Barkod Türü" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbBarcodeFormat" Margin="0,0,0,20">
                                    <ComboBoxItem Content="CODE_128" IsSelected="True"/>
                                    <ComboBoxItem Content="EAN_13"/>
                                    <ComboBoxItem Content="CODE_39"/>
                                    <ComboBoxItem Content="ITF"/>
                                    <ComboBoxItem Content="UPC_A"/>
                                </ComboBox>

                                <TextBlock Text="Barkod Metni" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtBarcodeText" Text="123456789012" Style="{StaticResource RoundedTextBox}" Height="40" Margin="0,0,0,20" VerticalContentAlignment="Center"/>

                                <Button x:Name="BtnGenerateBarcode" Click="BtnGenerateBarcode_Click" Style="{StaticResource AccentButtonStyle}" Height="45" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Barcode" Width="22" Height="22" Margin="0,0,10,0"/>
                                        <TextBlock Text="Barkod Oluştur" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnSaveBarcode" Click="BtnSaveBarcode_Click" Style="{StaticResource OutlineButtonStyle}" Height="40">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="ContentSave" Width="18" Height="18" Margin="0,0,10,0"/>
                                        <TextBlock Text="Barkodu Kaydet"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Sağ Taraf -->
                            <StackPanel Grid.Column="1">
                                <Border Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Height="200">
                                    <Grid>
                                        <Image x:Name="ImgBarcode" Stretch="Uniform"/>

                                        <StackPanel VerticalAlignment="Center" x:Name="BarcodePlaceholder" 
                                                    Visibility="{Binding Source={x:Reference ImgBarcode}, Path=Source, Converter={StaticResource NullToVisibilityConverter}}">
                                            <iconPacks:PackIconMaterial Kind="Barcode" Width="60" Height="60" HorizontalAlignment="Center" Opacity="0.1" Foreground="{DynamicResource HeaderText}"/>
                                            <TextBlock Text="Barkod Önizleme" HorizontalAlignment="Center" Margin="0,10,0,0" Opacity="0.3" Foreground="{DynamicResource HeaderText}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
