<Page x:Class="SwissKnifeApp.Views.Modules.QrBarcodeToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d"
      Title="QR ve Barkod Araçları">

    <!-- Sayfa özel vurgu renkleri (QR/Barkod: teal tonları) -->
    <Page.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#009688"/>
        <SolidColorBrush x:Key="AccentBrush2" Color="#00695C"/>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Üst Başlık -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <iconPacks:PackIconMaterial Kind="Qrcode" Width="28" Height="28" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
            <TextBlock Text="QR / Barkod Araçları" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
        </StackPanel>

    <!-- QR & Barkod Sekmeleri -->
    <TabControl Grid.Row="1" x:Name="TabMain" Margin="0,10,0,0">

            <!-- QR Kod Sekmesi -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Qrcode" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="QR Kod Oluştur / Oku"/>
                    </StackPanel>
                </TabItem.Header>
                <Border Style="{StaticResource Card}" Margin="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- QR Türü seçimi -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,10">
                            <iconPacks:PackIconMaterial Kind="ShapeSquarePlus" Width="20" Height="20" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="QR Türü:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CmbQrType" Width="160" SelectionChanged="CmbQrType_SelectionChanged">
                                <ComboBoxItem Content="Metin / URL" IsSelected="True"/>
                                <ComboBoxItem Content="Wi-Fi"/>
                                <ComboBoxItem Content="vCard"/>
                                <ComboBoxItem Content="E-posta"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Giriş Alanları -->
                        <StackPanel Grid.Row="1" x:Name="PanelInputFields" Orientation="Vertical" Margin="0,0,0,10"/>

                        <!-- QR Görseli -->
                        <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="ImgQrCode" Height="240" Width="240" Stretch="Uniform"/>
                        </Border>

                        <!-- Okunan Metin -->
                        <TextBlock Grid.Row="3" x:Name="TxtDecoded" TextWrapping="Wrap" Margin="0,10,0,10" FontWeight="Bold" MinHeight="30" Background="#F8F9FA" Padding="5"/>

                        <!-- QR Butonları -->
                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button x:Name="BtnGenerateQR" Click="BtnGenerateQR_Click" Style="{StaticResource AccentButtonStyle}" Margin="5" Padding="10,5" IsEnabled="True">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="QrcodePlus" Width="18" Height="18" Margin="5,0,10,0"/>
                                    <TextBlock Text="QR Oluştur" Width="55"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnLoadImage" Click="BtnLoadImage_Click" Style="{StaticResource OutlineButtonStyle}" Margin="5" Padding="10,5" IsEnabled="True">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="FolderImage" Width="18" Height="18" Margin="5,0,10,0"/>
                                    <TextBlock Text="Görselden Oku" Width="70"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnSaveQR" Click="BtnSaveQR_Click" Style="{StaticResource OutlineButtonStyle}" Margin="5" Padding="10,5" IsEnabled="True">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ContentSave" Width="18" Height="18" Margin="5,0,10,0"/>
                                    <TextBlock Text="Kaydet" Width="35"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Barkod Sekmesi -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Barcode" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Barkod Oluştur"/>
                    </StackPanel>
                </TabItem.Header>
                <Border Style="{StaticResource Card}" Margin="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Barkod Türü -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <iconPacks:PackIconMaterial Kind="Barcode" Width="20" Height="20" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Barkod Türü:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CmbBarcodeFormat" Width="150">
                                <ComboBoxItem Content="CODE_128" IsSelected="True"/>
                                <ComboBoxItem Content="EAN_13"/>
                                <ComboBoxItem Content="CODE_39"/>
                                <ComboBoxItem Content="ITF"/>
                                <ComboBoxItem Content="UPC_A"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Barkod Metni -->
                        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,10">
                            <TextBlock Text="Barkod Metni:" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtBarcodeText" FontSize="14" Height="30" Text="123456789012" Style="{StaticResource RoundedTextBox}"/>
                        </StackPanel>

                        <!-- Barkod Görseli -->
                        <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="ImgBarcode" Height="150" Width="400" Stretch="Uniform"/>
                        </Border>

                        <!-- Barkod Butonları -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button x:Name="BtnGenerateBarcode" Click="BtnGenerateBarcode_Click" Style="{StaticResource AccentButtonStyle}" Margin="5" Padding="10,5" IsEnabled="True">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Barcode" Width="18" Height="18" Margin="5,0,10,0"/>
                                    <TextBlock Text="Barkod Oluştur" Width="72"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnSaveBarcode" Click="BtnSaveBarcode_Click" Style="{StaticResource OutlineButtonStyle}" Margin="5" Padding="10,5" IsEnabled="True">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ContentSave" Width="18" Height="18" Margin="5,0,10,0"/>
                                    <TextBlock Text="Kaydet" Width="35"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
