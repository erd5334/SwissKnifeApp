<Page x:Class="SwissKnifeApp.Views.Modules.UnitConverterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="850" d:DesignWidth="1100"
      Title="Birim ve Zaman Dönüştürücü"
      Background="{DynamicResource AppBackground}">

    <Page.Resources>
        <!-- Unit Converter specific accent colors (Indigo) -->
        <SolidColorBrush x:Key="UnitAccent" Color="#3F51B5"/>
        <!-- Local override to give unit module a consistent Indigo theme -->
        <SolidColorBrush x:Key="AccentBrush" Color="{Binding Source={StaticResource UnitAccent}, Path=Color}"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Modern Header -->
        <Border Grid.Row="0" Padding="25,20" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="SwapHorizontal" Width="30" Height="30" VerticalAlignment="Center" Foreground="{StaticResource UnitAccent}"/>
                    <TextBlock Text="Birim ve Zaman Dönüştürücü" FontSize="24" FontWeight="Bold" Margin="15,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource HeaderText}"/>
                </StackPanel>
                <TextBlock Text="Birimler arası çeviri yapın, zaman ve tarih hesaplamalarını kolayca yönetin" FontSize="14" Foreground="{DynamicResource SecondaryText}" Margin="45,5,0,0"/>
            </StackPanel>
        </Border>

        <mah:MetroAnimatedSingleRowTabControl Grid.Row="1" mah:HeaderedControlHelper.HeaderFontSize="14" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource MahApps.Styles.TabItem}">
                    <Setter Property="Padding" Value="25,12"/>
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                </Style>
            </TabControl.Resources>

            <!-- Birim Dönüştürücü Sekmesi -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Scale" Width="18" Height="18" Margin="0,0,10,0"/>
                        <TextBlock Text="Birim Dönüştürücü"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="25" MaxWidth="800" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}" Padding="30">
                            <StackPanel>
                                <!-- Birim Türü Seçimi -->
                                <TextBlock Text="Birim Türü" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                                <ComboBox x:Name="cmbUnitType" 
                                         Height="45" 
                                         Margin="0,0,0,25" 
                                         SelectedIndex="0" 
                                         SelectionChanged="cmbUnitType_SelectionChanged">
                                    <ComboBoxItem Content="Uzunluk"/>
                                    <ComboBoxItem Content="Ağırlık"/>
                                    <ComboBoxItem Content="Sıcaklık"/>
                                </ComboBox>

                                <!-- Kaynak / Hedef -->
                                <Grid Margin="0,0,0,25">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Şuradan" Style="{StaticResource SectionHeader}" Margin="0,0,0,10" FontSize="12"/>
                                        <ComboBox x:Name="cmbFrom" Height="45"/>
                                    </StackPanel>

                                    <iconPacks:PackIconMaterial Grid.Column="1" Kind="ArrowRight" Width="24" Height="24" 
                                                               Foreground="{StaticResource UnitAccent}" 
                                                               VerticalAlignment="Bottom" Margin="15,0,15,10"/>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Şuna" Style="{StaticResource SectionHeader}" Margin="0,0,0,10" FontSize="12"/>
                                        <ComboBox x:Name="cmbTo" Height="45"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Değer Girişi -->
                                <TextBlock Text="Dönüştürülecek Değer" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                                <TextBox x:Name="txtValue" 
                                         Style="{StaticResource RoundedTextBox}"
                                         Height="45" 
                                         Margin="0,0,0,25" 
                                         FontSize="16" 
                                         FontWeight="SemiBold"
                                         mah:TextBoxHelper.Watermark="Değeri buraya girin..."/>

                                <Button Style="{StaticResource AccentButtonStyle}" 
                                        Height="50" 
                                        Click="ConvertButton_Click" 
                                        Margin="0,0,0,30">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Refresh" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="HEMEN DÖNÜŞTÜR" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Sonuç Card -->
                                <Border Background="{DynamicResource AppBackground}" CornerRadius="12" Padding="25" BorderBrush="{StaticResource UnitAccent}" BorderThickness="0,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="Hesaplanan Sonuç" FontSize="13" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="txtResult" Text="0.00" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource HeaderText}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Zaman Araçları Sekmesi -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ClockOutline" Width="18" Height="18" Margin="0,0,10,0"/>
                        <TextBlock Text="Zaman Araçları"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="25" MaxWidth="1100" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Timestamp Dönüştürücü -->
                        <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource Card}" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <iconPacks:PackIconMaterial Kind="TimelineClockOutline" Width="18" Height="18" Foreground="{StaticResource UnitAccent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Timestamp Dönüştürücü" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource HeaderText}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBox x:Name="txtTimestamp" Style="{StaticResource RoundedTextBox}" Height="40" Margin="0,0,0,15" mah:TextBoxHelper.Watermark="Örn: 1705574400"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Height="40" Style="{StaticResource AccentButtonStyle}" Click="TimestampToDate_Click">
                                        <TextBlock Text="→ Tarih" FontSize="12" FontWeight="Bold"/>
                                    </Button>
                                    <Button Grid.Column="2" Height="40" Style="{StaticResource OutlineButtonStyle}" Click="DateToTimestamp_Click">
                                        <TextBlock Text="Tarih →" FontSize="12" FontWeight="Bold"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Yaş Hesaplama -->
                        <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource Card}" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <iconPacks:PackIconMaterial Kind="AccountBadgeOutline" Width="18" Height="18" Foreground="{StaticResource UnitAccent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Yaş Hesaplama" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource HeaderText}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBox x:Name="txtBirthDate" Style="{StaticResource RoundedTextBox}" Height="40" Margin="0,0,0,15" mah:TextBoxHelper.Watermark="Doğum Tarihi (gg.aa.yyyy)"/>
                                <Button Height="40" Style="{StaticResource AccentButtonStyle}" Click="CalculateAge_Click" Margin="0,0,0,15">
                                    <TextBlock Text="BOYU/YAŞI HESAPLA" FontSize="12" FontWeight="Bold"/>
                                </Button>
                                
                                <Separator Background="{DynamicResource CardBorderBrush}" Margin="0,5,0,15"/>
                                
                                <TextBlock Text="İki Tarih Arası Yaş" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="txtAgeStartDate" Style="{StaticResource RoundedTextBox}" Height="36" mah:TextBoxHelper.Watermark="Başlangıç"/>
                                    <TextBox Grid.Column="2" x:Name="txtAgeEndDate" Style="{StaticResource RoundedTextBox}" Height="36" mah:TextBoxHelper.Watermark="Bitiş"/>
                                </Grid>
                                <Button Height="36" Style="{StaticResource OutlineButtonStyle}" Click="CalculateAgeBetweenDates_Click">
                                    <TextBlock Text="ARALIK YAŞI HESAPLA" FontSize="11" FontWeight="Bold"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Zaman Aralığı Hesaplama -->
                        <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2" Style="{StaticResource Card}" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <iconPacks:PackIconMaterial Kind="CalendarRange" Width="18" Height="18" Foreground="{StaticResource UnitAccent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="İki Tarih Arası Zaman Aralığı" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource HeaderText}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Başlangıç" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,5"/>
                                        <TextBox x:Name="txtDate1" Style="{StaticResource RoundedTextBox}" Height="40" mah:TextBoxHelper.Watermark="gg.aa.yyyy"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Bitiş" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,5"/>
                                        <TextBox x:Name="txtDate2" Style="{StaticResource RoundedTextBox}" Height="40" mah:TextBoxHelper.Watermark="gg.aa.yyyy"/>
                                    </StackPanel>
                                    <Button Grid.Column="4" Style="{StaticResource AccentButtonStyle}" Width="150" Height="40" VerticalAlignment="Bottom" Click="CalculateTimeSpan_Click">
                                        <TextBlock Text="HESAPLA" FontWeight="Bold"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Zaman Dilimi Çevirici -->
                        <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="4" Style="{StaticResource Card}" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <iconPacks:PackIconMaterial Kind="Earth" Width="18" Height="18" Foreground="{StaticResource UnitAccent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Zaman Dilimi Çevirici" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource HeaderText}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="txtTimeZoneSource" Style="{StaticResource RoundedTextBox}" Height="40" mah:TextBoxHelper.Watermark="Kaynak (Örn: UTC)"/>
                                    <TextBox Grid.Column="2" x:Name="txtTimeZoneTarget" Style="{StaticResource RoundedTextBox}" Height="40" mah:TextBoxHelper.Watermark="Hedef (Örn: Turkey Standard Time)"/>
                                    <TextBox Grid.Column="4" x:Name="txtTimeZoneDate" Style="{StaticResource RoundedTextBox}" Height="40" mah:TextBoxHelper.Watermark="Tarih/Saat (İsteğe bağlı)"/>
                                </Grid>
                                <Button Height="45" Style="{StaticResource AccentButtonStyle}" Click="ConvertTimeZone_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="EarthArrowRight" Width="18" Height="18" Margin="0,0,10,0"/>
                                        <TextBlock Text="DÜNYA SAATİNE ÇEVİR" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        
                        <!-- Global Sonuç Alanı -->
                        <Border Grid.Row="5" Grid.ColumnSpan="3" Margin="0,25,0,0" Background="{StaticResource UnitAccent}" CornerRadius="12" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <iconPacks:PackIconMaterial Kind="InformationOutline" Width="16" Height="16" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="İşlem Sonucu" FontSize="13" Foreground="White" Opacity="0.9" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="txtTimeResult" Text="Henüz işlem yapılmadı." FontSize="18" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </mah:MetroAnimatedSingleRowTabControl>
    </Grid>
</Page>
