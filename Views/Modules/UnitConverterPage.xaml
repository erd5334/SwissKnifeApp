<UserControl x:Class="SwissKnifeApp.Views.Modules.UnitConverterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:SwissKnifeApp.Views.Modules"
             Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Başlık Card -->
        <Border Background="#e3e8ff" CornerRadius="14" Padding="18" Margin="0,0,0,20" BorderBrush="#b3b8d1" BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <iconPacks:PackIconMaterial Kind="SwapHorizontal" Width="32" Height="32" Foreground="#3f51b5" Margin="0,0,12,0"/>
                <TextBlock Text="Birim ve Zaman Dönüştürücü" FontSize="22" FontWeight="Bold" Foreground="#3f51b5"/>
            </StackPanel>
        </Border>

        <!-- TabControl ile Bölümler -->
        <TabControl Grid.Row="1" Margin="0">
            
            <!-- Birim Dönüştürücü Sekmesi -->
            <TabItem Header="Birim Dönüştürücü">
                <Border Padding="24" Background="#f5f7fa" CornerRadius="16" BorderBrush="#b3b8d1" BorderThickness="1" Margin="16">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Width="480">
                        <!-- Birim Türü Card -->
                        <Border Background="#e3e8ff" CornerRadius="10" Padding="12" Margin="0,0,0,18" BorderBrush="#b3b8d1" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="Tune" Width="22" Height="22" Foreground="#3f51b5" Margin="0,0,8,0"/>
                                <TextBlock Text="Birim Türü:" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <ComboBox x:Name="cmbUnitType" Width="180" Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="cmbUnitType_SelectionChanged">
                                    <ComboBoxItem Content="Uzunluk" />
                                    <ComboBoxItem Content="Ağırlık" />
                                    <ComboBoxItem Content="Sıcaklık" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Kaynak / Hedef Card -->
                        <Border Background="#e3e8ff" CornerRadius="10" Padding="12" Margin="0,0,0,18" BorderBrush="#b3b8d1" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ComboBox x:Name="cmbFrom" Width="150"/>
                                <iconPacks:PackIconMaterial Kind="SwapHorizontal" Width="28" Height="28" Foreground="#3f51b5" VerticalAlignment="Center" Margin="10,0"/>
                                <ComboBox x:Name="cmbTo" Width="150"/>
                            </StackPanel>
                        </Border>

                        <!-- Değer Girişi -->
                        <TextBox x:Name="txtValue" Width="220" Height="38" FontSize="15" Margin="0,0,0,18" HorizontalAlignment="Center" TextAlignment="Center"/>

                        <!-- Dönüştür Butonu -->
                        <Button Width="190" Height="48" Margin="0,0,0,18" Style="{StaticResource AccentButtonStyle}" Click="ConvertButton_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="CalculatorVariant" Width="24" Height="24" Foreground="#3f51b5" Margin="0,0,8,0"/>
                                <TextBlock Text="Dönüştür" FontSize="16"/>
                            </StackPanel>
                        </Button>

                        <!-- Sonuç Card -->
                        <Border Background="White" CornerRadius="10" Padding="14" BorderBrush="#b3b8d1" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="CheckCircleOutline" Width="20" Height="20" Foreground="#3f51b5" Margin="0,0,8,0"/>
                                    <TextBlock Text="Sonuç:" FontWeight="Bold" Foreground="Gray" FontSize="14"/>
                                </StackPanel>
                                <TextBlock x:Name="txtResult" Text="0" FontSize="20" FontWeight="Bold" Foreground="Black" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- Zaman Araçları Sekmesi -->
            <TabItem Header="Zaman Araçları">
                <Border Padding="24" Background="#f5f7fa" CornerRadius="16" BorderBrush="#b3b8d1" BorderThickness="1" Margin="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Width="580">
                            <!-- Zaman ve Tarih Araçları Card -->
                            <Border Background="#e3e8ff" CornerRadius="10" Padding="12" Margin="0,0,0,18" BorderBrush="#b3b8d1" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="ClockOutline" Width="24" Height="24" Foreground="#3f51b5" Margin="0,0,8,0"/>
                                    <TextBlock Text="Zaman ve Tarih Araçları" FontSize="18" FontWeight="Bold" Foreground="#3f51b5"/>
                                </StackPanel>
                            </Border>

                            <!-- Timestamp Dönüştürücü Card -->
                            <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,18" BorderBrush="#b3b8d1" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                        <iconPacks:PackIconMaterial Kind="TimelineClockOutline" Width="20" Height="20" Foreground="#3f51b5" Margin="0,0,8,0"/>
                                        <TextBlock Text="Timestamp Dönüştürücü" FontWeight="Bold" FontSize="15"/>
                                    </StackPanel>
                                    <TextBox x:Name="txtTimestamp" Height="34" FontSize="15" Margin="0,5,0,10" TextAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Width="160" Height="36" Margin="5" Style="{StaticResource AccentButtonStyle}" Click="TimestampToDate_Click">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <iconPacks:PackIconMaterial Kind="Calendar" Width="20" Height="20" Foreground="#3f51b5" Margin="0,0,8,0"/>
                                                <TextBlock Text="Timestamp → Tarih" FontSize="14"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="160" Height="36" Margin="5" Style="{StaticResource AccentButtonStyle}" Click="DateToTimestamp_Click">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <iconPacks:PackIconMaterial Kind="Timeline" Width="20" Height="20" Foreground="#3f51b5" Margin="0,0,8,0"/>
                                                <TextBlock Text="Tarih → Timestamp" FontSize="14"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Zaman Aralığı Hesaplama Card -->
                            <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,18" BorderBrush="#b3b8d1" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                        <iconPacks:PackIconMaterial Kind="CalendarRange" Width="20" Height="20" Foreground="#3f51b5" Margin="0,0,8,0"/>
                                        <TextBlock Text="Zaman Aralığı Hesaplama" FontWeight="Bold" FontSize="15"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,10">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Başlangıç Tarihi:" FontSize="12" Margin="0,0,0,5"/>
                                            <TextBox x:Name="txtDate1" Width="180" Height="34" FontSize="15" TextAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Bitiş Tarihi:" FontSize="12" Margin="0,0,0,5"/>
                                            <TextBox x:Name="txtDate2" Width="180" Height="34" FontSize="15" TextAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Width="190" Height="36" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Click="CalculateTimeSpan_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <iconPacks:PackIconMaterial Kind="Calculator" Width="20" Height="20" Foreground="#3f51b5" Margin="0,0,8,0"/>
                                            <TextBlock Text="Zaman Aralığı Hesapla" FontSize="14"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Yaş Hesaplama Card -->
                            <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,18" BorderBrush="#b3b8d1" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                        <iconPacks:PackIconMaterial Kind="AccountCircleOutline" Width="20" Height="20" Foreground="#3f51b5" Margin="0,0,8,0"/>
                                        <TextBlock Text="Yaş Hesaplama" FontWeight="Bold" FontSize="15"/>
                                    </StackPanel>
                                    <TextBlock Text="Doğum Tarihi (gg.aa.yyyy):" FontSize="12" Margin="0,5,0,5"/>
                                    <TextBox x:Name="txtBirthDate" Height="34" FontSize="15" Margin="0,0,0,10" TextAlignment="Center"/>
                                    <Button Height="36" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Click="CalculateAge_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <iconPacks:PackIconMaterial Kind="Calculator" Width="20" Height="20" Foreground="#3f51b5" Margin="5,0,8,0"/>
                                            <TextBlock Text="Yaş Hesapla (Bugüne Göre)" FontSize="14" Width="190"/>
                                        </StackPanel>
                                    </Button>
                                    <Separator Margin="0,15,0,15"/>
                                    <TextBlock Text="İki Tarih Arası Yaş Hesaplama:" FontSize="12" Margin="0,0,0,5"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Başlangıç Tarihi:" FontSize="11" Margin="0,0,0,5"/>
                                            <TextBox x:Name="txtAgeStartDate" Width="150" Height="34" FontSize="15" TextAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Bitiş Tarihi:" FontSize="11" Margin="0,0,0,5"/>
                                            <TextBox x:Name="txtAgeEndDate" Width="150" Height="34" FontSize="15" TextAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Width="210" Height="36" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Click="CalculateAgeBetweenDates_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <iconPacks:PackIconMaterial Kind="Calculator" Width="20" Height="20" Foreground="#3f51b5" Margin="0,0,8,0"/>
                                            <TextBlock Text="İki Tarih Arası Yaş Hesapla" FontSize="14"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Zaman Dilimi Çevirici Card -->
                            <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,18" BorderBrush="#b3b8d1" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                        <iconPacks:PackIconMaterial Kind="Earth" Width="20" Height="20" Foreground="#3f51b5" Margin="0,0,8,0"/>
                                        <TextBlock Text="Zaman Dilimi Çevirici" FontWeight="Bold" FontSize="15"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,10">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Kaynak Dilim:" FontSize="12" Margin="0,0,0,5"/>
                                            <TextBox x:Name="txtTimeZoneSource" Width="120" Height="34" FontSize="15" TextAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Hedef Dilim:" FontSize="12" Margin="0,0,0,5"/>
                                            <TextBox x:Name="txtTimeZoneTarget" Width="120" Height="34" FontSize="15" TextAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Tarih/Saat:" FontSize="12" Margin="0,0,0,5"/>
                                            <TextBox x:Name="txtTimeZoneDate" Width="180" Height="34" FontSize="15" TextAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Width="160" Height="36" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Click="ConvertTimeZone_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <iconPacks:PackIconMaterial Kind="EarthArrowRight" Width="20" Height="20" Foreground="#3f51b5" Margin="0,0,8,0"/>
                                            <TextBlock Text="Zaman Dilimi Çevir" FontSize="14"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="Örnek: 'Turkey Standard Time', 'UTC', 'Eastern Standard Time'" FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Sonuç Alanı Card -->
                            <Border Background="#e3e8ff" CornerRadius="10" Padding="15" BorderBrush="#b3b8d1" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <iconPacks:PackIconMaterial Kind="CheckCircleOutline" Width="20" Height="20" Foreground="#3f51b5" Margin="0,0,8,0"/>
                                        <TextBlock Text="Sonuç:" FontWeight="Bold" FontSize="14" Foreground="Gray"/>
                                    </StackPanel>
                                    <TextBlock x:Name="txtTimeResult" FontSize="17" Foreground="Black" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
