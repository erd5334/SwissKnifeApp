<mah:MetroWindow
    x:Class="SwissKnifeApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    mc:Ignorable="d"
    Title="Türk Çakısı"
    Height="720" Width="1280"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized">

    <mah:MetroWindow.Resources>
        <!-- Color Resources (Dynamic for Dark Mode) -->
        <SolidColorBrush x:Key="SidebarBackground" Color="#F8F9FA"/>
        <SolidColorBrush x:Key="SidebarHeaderBackground" Color="#2C3E50"/>
        <SolidColorBrush x:Key="SidebarHeaderForeground" Color="White"/>
        <SolidColorBrush x:Key="MenuItemHoverBackground" Color="#E3F2FD"/>
        <SolidColorBrush x:Key="MenuItemActiveBackground" Color="#2196F3"/>
        <SolidColorBrush x:Key="MenuItemActiveForeground" Color="White"/>
        <SolidColorBrush x:Key="MenuItemForeground" Color="#2C3E50"/>
        <SolidColorBrush x:Key="CategoryHeaderBackground" Color="#ECEFF1"/>
        <SolidColorBrush x:Key="AccentColor" Color="#2196F3"/>
        <SolidColorBrush x:Key="MainBackground" Color="White"/>
        
        <!-- Modern Shadow Effect -->

        <!-- Category Header Style -->
        <Style x:Key="CategoryHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CategoryHeaderBackground}"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <!-- Menu Button Style (Enhanced) -->
        <Style x:Key="ModernMenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MenuItemForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Active Indicator (Left Border) -->
                            <Border x:Name="ActiveIndicator" 
                                    Width="4" 
                                    HorizontalAlignment="Left" 
                                    Background="{DynamicResource AccentColor}"
                                    Opacity="0"/>
                            
                            <!-- Main Button Border -->
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Margin="4,0,0,0">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                  VerticalAlignment="Center" 
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Hover Effect -->
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border" 
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" 
                                                        To="#E3F2FD" 
                                                        Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border" 
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" 
                                                        To="Transparent" 
                                                        Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            
                            <!-- Active State -->
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource MenuItemActiveBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MenuItemActiveForeground}"/>
                                <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1"/>
                            </Trigger>
                            
                            <!-- Pressed Effect -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#BBDEFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hamburger Button Style -->
        <Style x:Key="HamburgerButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarHeaderForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Theme Toggle Button Style -->
        <Style x:Key="ThemeToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarHeaderForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <iconPacks:PackIconMaterial x:Name="icon" 
                                                        Kind="WhiteBalanceSunny" 
                                                        Width="20" Height="20"
                                                        Foreground="{TemplateBinding Foreground}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="icon" Property="Kind" Value="MoonWaningCrescent"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search Box Style -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="35,8,10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid>
                                <!-- Search Icon -->
                                <iconPacks:PackIconMaterial Kind="Magnify" 
                                                            Width="16" Height="16"
                                                            Foreground="#95A5A6"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Margin="10,0"/>
                                
                                <!-- Text Input -->
                                <ScrollViewer x:Name="PART_ContentHost" 
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                                
                                <!-- Placeholder -->
                                <TextBlock x:Name="Placeholder" 
                                           Text="Modül ara..." 
                                           Foreground="{DynamicResource SecondaryText}"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center"
                                           Margin="35,0,10,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Expander Style for Categories -->
        <Style x:Key="CategoryExpander" TargetType="Expander">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Header -->
                            <ToggleButton x:Name="HeaderSite" 
                                          Grid.Row="0"
                                          Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{DynamicResource CategoryHeaderBackground}"
                                          BorderThickness="0"
                                          Padding="12,8"
                                          Cursor="Hand"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Left">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" 
                                                Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Category Title and Icon -->
                                                <ContentPresenter Grid.Column="0" 
                                                                  Content="{TemplateBinding Content}"
                                                                  VerticalAlignment="Center"/>
                                                
                                                <!-- Chevron Icon -->
                                                <iconPacks:PackIconMaterial x:Name="Chevron"
                                                                            Grid.Column="1"
                                                                            Kind="ChevronDown" 
                                                                            Width="16" Height="16"
                                                                            Foreground="#7F8C8D"
                                                                            VerticalAlignment="Center"
                                                                            Margin="10,0,0,0"
                                                                            RenderTransformOrigin="0.5,0.5">
                                                    <iconPacks:PackIconMaterial.RenderTransform>
                                                        <RotateTransform Angle="0"/>
                                                    </iconPacks:PackIconMaterial.RenderTransform>
                                                </iconPacks:PackIconMaterial>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Chevron"
                                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             To="180" Duration="0:0:0.2"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Chevron"
                                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             To="0" Duration="0:0:0.2"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            
                            <!-- Content -->
                            <ContentPresenter x:Name="Content" 
                                              Grid.Row="1"
                                              Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Content" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </mah:MetroWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MenuColumn" Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== SIDEBAR ===== -->
        <Border Grid.Column="0" 
                Background="{DynamicResource SidebarBackground}" 
                BorderBrush="{DynamicResource CardBorderBrush}" 
                BorderThickness="0,0,1,0"
                Effect="{DynamicResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ===== HEADER ===== -->
                <Border Grid.Row="0" Background="{DynamicResource SidebarHeaderBackground}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <!-- Hamburger Menu -->
                        <Button x:Name="btnToggleMenu" 
                                Grid.Column="0" 
                                Style="{DynamicResource HamburgerButton}" 
                                Click="ToggleMenu_Click"
                                ToolTip="Menüyü Daralt/Genişlet">
                            <iconPacks:PackIconMaterial Kind="Menu" Width="22" Height="22"/>
                        </Button>

                        <!-- App Title -->
                        <TextBlock Grid.Column="1" 
                                   Text="Türk Çakısı" 
                                   Foreground="{DynamicResource SidebarHeaderForeground}" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="10,0"
                                   Cursor="Hand"
                                   MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
                                   ToolTip="Ana Ekrana Dön"/>

                        <!-- Theme Toggle -->
                        <ToggleButton x:Name="btnThemeToggle"
                                      Grid.Column="2"
                                      Style="{DynamicResource ThemeToggleButton}"
                                      Checked="ThemeToggle_Checked"
                                      Unchecked="ThemeToggle_Unchecked"
                                      ToolTip="Dark Mode"/>
                    </Grid>
                </Border>

                <!-- ===== SEARCH BOX ===== -->
                <Border Grid.Row="1" Padding="12,10">
                    <TextBox x:Name="txtSearch" 
                             Style="{DynamicResource SearchBox}"
                             TextChanged="Search_TextChanged"/>
                </Border>

                <!-- ===== MENU ITEMS ===== -->
                <ScrollViewer Grid.Row="2" 
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="MenuItemsContainer" Margin="0,5,0,10">
                        
                        <!-- ===== MENÜ BAŞLIKLARI (Text Renkleri Dinamik) ===== -->
                        <Expander x:Name="expFavorites" Style="{DynamicResource CategoryExpander}" IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Star" Width="18" Height="18" Foreground="#FFC107" Margin="0,0,8,0"/>
                                    <TextBlock Text="Favoriler" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource MenuItemForeground}"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel x:Name="FavoritesPanel">
                                <TextBlock Text="Favori modül yok" 
                                           Foreground="{DynamicResource SecondaryText}" 
                                           FontSize="11" 
                                           Margin="25,5"
                                           FontStyle="Italic"/>
                            </StackPanel>
                        </Expander>

                        <!-- Ofis Araçları -->
                        <Expander Style="{DynamicResource CategoryExpander}" IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Briefcase" Width="18" Height="18" Foreground="#1976D2" Margin="0,0,8,0"/>
                                    <TextBlock Text="Ofis Araçları" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource MenuItemForeground}"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <Button Style="{DynamicResource ModernMenuButton}" Click="MenuButton_Click" Tag="TextOperations"
                                        ToolTip="Metin dönüştürme, şifreleme, analiz">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="FileDocumentOutline" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="Metin İşlemleri" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource ModernMenuButton}" Click="MenuButton_Click" Tag="TextSummarizer"
                                        ToolTip="Metin ve belge özetleme">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="FileDocument" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="Metin Özetleyici" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource ModernMenuButton}" Click="MenuButton_Click" Tag="PdfOperations"
                                        ToolTip="PDF birleştir, böl, dönüştür">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="FilePdfBox" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="PDF İşlemleri" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource ModernMenuButton}" Click="MenuButton_Click" Tag="DataAnalysis"
                                        ToolTip="CSV, Excel veri analizi">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="ChartBar" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="Veri Analizi" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource ModernMenuButton}" Click="MenuButton_Click" Tag="JsonXmlFormatter"
                                        ToolTip="JSON/XML formatlama ve dönüştürme">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconFontAwesome Kind="CodeSolid" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="JSON/XML Formatter" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource ModernMenuButton}" Click="MenuButton_Click" Tag="DocumentTools"
                                        ToolTip="Markdown, OCR, Word/PDF dönüştürme ve detaylı analiz">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="FileDocumentEditOutline" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="Belge Araçları" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource ModernMenuButton}" Click="MenuButton_Click" Tag="SqlTools"
                                        ToolTip="SQL Sorgulayıcı, Formatlayıcı &amp; SQLite Yöneticisi">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Database" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="SQL Araçları" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource ModernMenuButton}" Click="MenuButton_Click" Tag="DeveloperTools"
                                        ToolTip="GUID, JWT, Cron, Fake Data ve Timestamp Araçları">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Tools" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="Geliştirici Seti" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>

                        <!-- ===== MEDYA ARAÇLARI ===== -->
                        <Expander Style="{DynamicResource CategoryExpander}" IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Multimedia" Width="18" Height="18" Foreground="#E91E63" Margin="0,0,8,0"/>
                                    <TextBlock Text="Medya Araçları" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource MenuItemForeground}"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <Button Style="{DynamicResource ModernMenuButton}" Click="MenuButton_Click" Tag="ImageTools"
                                        ToolTip="Dönüştürme, optimizasyon, filigran ve AI arka plan silme">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="ImageEdit" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="Gelişmiş Görsel Araçları" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource ModernMenuButton}" Click="MenuButton_Click" Tag="PhotoCollage"
                                        ToolTip="Fotoğraf kolaj oluştur">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="ImageMultiple" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="Fotoğraf Kolaj" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource ModernMenuButton}" Click="MenuButton_Click" Tag="AudioTools"
                                        ToolTip="Ses dosyası işleme">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Music" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="Ses Araçları" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource ModernMenuButton}" Click="MenuButton_Click" Tag="VideoTools"
                                        ToolTip="Video dönüştürme ve düzenleme">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="VideoBox" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="Video Araçları" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource ModernMenuButton}" Click="MenuButton_Click" Tag="YouTubeClipDownloader"
                                        ToolTip="YouTube video indirici">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Youtube" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="YouTube İndirici" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource ModernMenuButton}" Click="MenuButton_Click" Tag="ScreenCapture"
                                        ToolTip="Ekran görüntüsü al, kaydet">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Monitor" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="Screen Capture" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>

                        <!-- ===== GÜVENLİK ARAÇLARI ===== -->
                        <Expander Style="{DynamicResource CategoryExpander}" IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ShieldLock" Width="18" Height="18" Foreground="#F44336" Margin="0,0,8,0"/>
                                    <TextBlock Text="Güvenlik Araçları" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource MenuItemForeground}"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <Button Style="{DynamicResource ModernMenuButton}" Click="MenuButton_Click" Tag="PasswordTools"
                                        ToolTip="Şifre üretici, hash, AES">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="ShieldLockOutline" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="Şifre Araçları" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource ModernMenuButton}" Click="MenuButton_Click" Tag="FileManager"
                                        ToolTip="Dosya şifreleme ve yönetim">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconModern Kind="Folder" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="Dosya Yöneticisi" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>

                        <!-- Network & İnternet -->
                        <Expander Style="{DynamicResource CategoryExpander}" IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Web" Width="18" Height="18" Foreground="#4CAF50" Margin="0,0,8,0"/>
                                    <TextBlock Text="Network &amp; İnternet" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource MenuItemForeground}"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <Button Style="{DynamicResource ModernMenuButton}" Click="MenuButton_Click" Tag="NetworkTools"
                                        ToolTip="Ping, Port Scanner, IP &amp; DNS Lookup">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="LanConnect" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="Network Araçları" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource ModernMenuButton}" Click="MenuButton_Click" Tag="RestClient"
                                        ToolTip="HTTP/REST API Test istemcisi (Postman benzeri)">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Api" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="REST Client" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>

                        <!-- ===== YARDIMCI ARAÇLAR ===== -->
                        <Expander Style="{DynamicResource CategoryExpander}" IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Tools" Width="18" Height="18" Foreground="#FF9800" Margin="0,0,8,0"/>
                                    <TextBlock Text="Yardımcı Araçlar" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource MenuItemForeground}"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <Button Style="{DynamicResource ModernMenuButton}" Click="MenuButton_Click" Tag="DuplicateFileFinder"
                                        ToolTip="Yinelenen dosya bulucu, hash karşılaştırma">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="ContentDuplicate" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="Yinelenen Dosya Bulucu" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource ModernMenuButton}" Click="MenuButton_Click" Tag="RegexTester"
                                        ToolTip="Regex pattern test, match/group gösterimi">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="CodeBraces" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="Regex Tester" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource ModernMenuButton}" Click="MenuButton_Click" Tag="UnitConverter"
                                        ToolTip="Birim dönüştürücü">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Calculator" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="Birim Dönüştürücü" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource ModernMenuButton}" Click="MenuButton_Click" Tag="QrCode"
                                        ToolTip="QR kod oluştur ve oku">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconFontAwesome Kind="QrcodeSolid" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="QR Kod" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource ModernMenuButton}" Click="MenuButton_Click" Tag="ColorTools"
                                        ToolTip="Renk seçici, palet üreteci, gradyan ve kontrast kontrolü">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="PaletteAdvanced" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="Gelişmiş Renk Araçları" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource ModernMenuButton}" Click="MenuButton_Click" Tag="MoneyToText"
                                        ToolTip="Para yazıya çevirme">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconModern Kind="Money" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="Para Yazıya Çevir" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource ModernMenuButton}" Click="MenuButton_Click" Tag="TaxCalculator"
                                        ToolTip="Vergi hesaplama">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Calculator" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="Vergi Hesaplayıcı" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource ModernMenuButton}" Click="MenuButton_Click" Tag="ClipboardHistory"
                                        ToolTip="Pano geçmişi">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconFontAwesome Kind="ClipboardSolid" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="Clipboard Geçmişi" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource ModernMenuButton}" Click="MenuButton_Click" Tag="FileCopy"
                                        ToolTip="Dosya kopyalama (FTP/SFTP)">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconModern Kind="PageCopy" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Text="Dosya Kopyalayıcı" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>

                <!-- ===== FOOTER (Version Info) ===== -->
                <Border Grid.Row="3" 
                        Background="{DynamicResource CategoryHeaderBackground}" 
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="15,10">
                    <StackPanel>
                        <TextBlock Text="Türk Çakısı v2.0" 
                                   FontSize="11" 
                                   Foreground="#7F8C8D"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Tüm hakları saklıdır © 2026" 
                                   FontSize="10" 
                                   Foreground="#95A5A6"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== MAIN CONTENT AREA ===== -->
        <Grid Grid.Column="1" Background="{DynamicResource MainBackground}">
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
            
            <!-- Welcome Screen -->
            <Grid x:Name="WelcomeGrid">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="pack://application:,,,/Resources/Icons/Logo.png" 
                           Width="400" Height="400" 
                           Margin="0,0,0,30"
                           Opacity="0.9"/>
                    <TextBlock Text="Türk Çakısı" 
                               FontSize="32" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource HeaderText}" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Çok Amaçlı Araç Kutusu" 
                               FontSize="18" 
                               Foreground="{DynamicResource SecondaryText}" 
                               HorizontalAlignment="Center" 
                               Margin="0,5,0,0"/>
                    <TextBlock Text="Sol menüden bir araç seçin veya arama yapın" 
                               FontSize="14" 
                               Foreground="{DynamicResource SecondaryText}" 
                               HorizontalAlignment="Center" 
                               Margin="0,30,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</mah:MetroWindow>
