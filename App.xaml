<Application x:Class="SwissKnifeApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:SwissKnifeApp.Helpers"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <h:BoolNegationConverter x:Key="BoolNegationConverter" />
            <h:BooleanToIconConverter x:Key="BooleanToIconConverter" />
            <h:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <h:IntToVisibilityConverter x:Key="IntToVisibilityConverter" />
            <h:ComparisonConverter x:Key="ComparisonConverter" />
            <h:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <h:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            
            <!-- Global Theme Colors (Dynamic for Dark Mode) -->
            <SolidColorBrush x:Key="AppBackground" Color="White"/>
            <SolidColorBrush x:Key="AppForeground" Color="#2C3E50"/>
            <SolidColorBrush x:Key="CardBackground" Color="White"/>
            <SolidColorBrush x:Key="CardBorderBrush" Color="#E0E0E0"/>
            <SolidColorBrush x:Key="InputBackground" Color="White"/>
            <SolidColorBrush x:Key="InputForeground" Color="#2C3E50"/>
            <SolidColorBrush x:Key="InputBorderBrush" Color="#BDC3C7"/>
            <SolidColorBrush x:Key="ButtonBackground" Color="#2196F3"/>
            <SolidColorBrush x:Key="ButtonForeground" Color="White"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#2196F3"/>
            <SolidColorBrush x:Key="HeaderText" Color="#2C3E50"/>
            <SolidColorBrush x:Key="SecondaryText" Color="#7F8C8D"/>
            
            <!-- Tax Specific Accent Colors -->
            <SolidColorBrush x:Key="TaxAccent" Color="#FFB300"/>
            <SolidColorBrush x:Key="TaxAccentDark" Color="#FFA000"/>
            
            <ResourceDictionary.MergedDictionaries>
                <!-- MahApps.Metro temel sözlükleri -->
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <!-- MahApps Tema (Light/Dark) ve Accent -->
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Light.Blue.xaml" />
                <ResourceDictionary Source="Resources/Themes/CustomStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>        
    </Application.Resources>    
</Application>
